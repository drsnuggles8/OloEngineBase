# Log files
**.log
**.tlog

# Test failure capture artefacts (machine-specific timestamps / GL strings).
# Captured under whichever CWD the test ran from — OloEditor/ for the editor-
# rooted suites, repo root for tests run via the harness's bare working dir.
OloEditor/assets/tests/captures/
/assets/tests/captures/

# Opt-in high-resolution path-tracer evidence (OLO_PATHTRACER_EVIDENCE=1). Only
# regenerated on demand, so a committed copy would silently go stale against the
# tracer it is supposed to be evidence for. The gate-resolution PNGs beside them
# ARE committed — those are rewritten by every test run.
OloEditor/assets/tests/visual/PathTracer_*_HiRes_*.png

# Functional test capture artefacts (scene snapshots on assertion failure)
OloEngine/tests/Functional/captures/

# Crash reports written by the engine's SEH handler. Machine-specific, and each
# crash drops a full minidump next to the text report (100+ MB), so these must
# never reach git history.
OloEditor/CrashReports/
OloRuntime/CrashReports/
OloServer/CrashReports/
/CrashReports/

