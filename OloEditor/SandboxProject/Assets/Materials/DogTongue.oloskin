SkinProfile:
  Name: Dog Tongue
  # The showcase dog's tongue (issue #1533), the surface the pant pose puts in
  # front of the camera. TRANSPORT VERSION 4, like OralTongue.oloskin, but pinker
  # and wetter: a panting dog's tongue is the wettest thing in the frame.
  EvaluationModel: 4
  Units: "colours: linear Rec.709 (unitless 0..1); lengths: millimetres"
  ScatterColor: [0.9, 0.44, 0.46]
  ScatterRadiusMM: [1.8, 0.85, 0.6]
  ThicknessScale: 1000
  SpecularTint: [1.0, 0.97, 0.96]
  Transmission:
    Strength: 1
    Anisotropy: 0.7
    Power: 4
  Specular:
    LobeMix: 0.4
    LobeRoughnessScale: 2.2
    NormalVarianceStrength: 0.0
    DetailStrength: 0
    ExpressionDetailGain: 0
  Oral:
    CoatStrength: 0.75
    CoatRoughness: 0.06
    CoatIor: 1.33
    # Out of the mouth in the pant pose it is lit from outside; inside the mouth
    # its transmission is spent on the cavity's own occlusion, as OralTongue's is.
    CavityOcclusion: 1.0
