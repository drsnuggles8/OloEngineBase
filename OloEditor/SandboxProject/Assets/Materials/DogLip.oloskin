SkinProfile:
  Name: Dog Lip
  # The showcase dog's lips, flews and eyelid margins (issue #1533). TRANSPORT
  # VERSION 4. Dogs have black-pigmented lip and lid margins: the dark rim is what
  # outlines the eye and the mouth at thumbnail size, so it is authored as a dark,
  # slightly moist skin rather than as a pink one.
  EvaluationModel: 4
  Units: "colours: linear Rec.709 (unitless 0..1); lengths: millimetres"
  ScatterColor: [0.3, 0.19, 0.17]
  ScatterRadiusMM: [1.2, 0.6, 0.45]
  ThicknessScale: 1000
  SpecularTint: [0.98, 0.95, 0.93]
  Transmission:
    Strength: 0.4
    Anisotropy: 0.7
    Power: 4
  Specular:
    LobeMix: 0.35
    LobeRoughnessScale: 2.0
    NormalVarianceStrength: 0.0
    DetailStrength: 0
    ExpressionDetailGain: 0
  Oral:
    CoatStrength: 0.3
    CoatRoughness: 0.14
    CoatIor: 1.33
    CavityOcclusion: 0.35
