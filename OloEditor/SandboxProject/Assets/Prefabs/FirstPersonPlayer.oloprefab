Prefab:
  Handle: 6450000000000000100
  # The PLAYER half of the first-person rig (issue #645). The camera half is
  # deliberately not here: a CameraRigComponent references its target by UUID,
  # and instantiating a prefab mints fresh UUIDs, so a two-entity rig prefab
  # would come out pointing at nothing. Drop this in, add a camera with a
  # CameraRigComponent, and set its Target to this entity's UUID
  # (BoomLength 0 + CollisionEnabled false = first person).
  Scene: |
    Scene: FirstPersonPlayer
    Entities:
      - Entity: 6450000000000000101
        TagComponent:
          Tag: FirstPersonPlayer
        TransformComponent:
          Translation: [0, 1.2, 0]
          Rotation: [0, 0, 0]
          Scale: [0.8, 1, 0.8]
        MeshComponent:
          Primitive: 4
        MaterialComponent:
          AlbedoColor: [0.85, 0.45, 0.2]
          Metallic: 0
          Roughness: 0.6
        CapsuleCollider3DComponent:
          Radius: 0.4
          HalfHeight: 0.6
          Offset: [0, 0, 0]
        CharacterController3DComponent:
          SlopeLimitDeg: 45
          StepOffset: 0.4
          JumpPower: 6
          LayerID: 0
          DisableGravity: false
          ControlMovementInAir: true
          ControlRotationInAir: false
        PlayerRigComponent:
          LookSensitivity: 0.15
          InvertLookY: false
          MinPitchDeg: -85
          MaxPitchDeg: 85
          WalkSpeed: 4.5
          SprintMultiplier: 1.8
          AirControl: 0.35
          MoveRelativeToLook: true
          YawBodyWithLook: true
          FaceMoveDirection: false
          TurnRateDeg: 720
          UseDeviceInput: true
          CaptureCursor: true
          YawDeg: 0
          PitchDeg: 0
