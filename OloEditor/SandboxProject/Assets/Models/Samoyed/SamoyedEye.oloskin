# Samoyed-specific dark brown iris and smooth corneal reflections.
# Zero iris concavity was selected against the angular baseline in live editor frames.
SkinProfile:
  Name: Samoyed Eye
  EvaluationModel: 5
  Units: 'colours: linear Rec.709 (unitless 0..1); lengths: millimetres'
  ScatterColor:
  - 0.8
  - 0.72
  - 0.66
  ScatterRadiusMM:
  - 0.015
  - 0.01
  - 0.008
  ThicknessScale: 1000
  SpecularTint:
  - 0.5
  - 0.5
  - 0.5
  Transmission:
    Strength: 0.25
    Anisotropy: 0.7
    Power: 4
  Specular:
    LobeMix: 0.2
    LobeRoughnessScale: 1.5
    NormalVarianceStrength: 0.25
    DetailStrength: 0
    ExpressionDetailGain: 0
  Oral:
    CoatStrength: 0.65
    CoatRoughness: 0.04
    CoatIor: 1.337
    CavityOcclusion: 0
  Ocular:
    OcularStrength: 1
    RefractionStrength: 1
    EyeRadiusMM: 13.738800000000001
    CorneaRadiusMM: 13.166350000000003
    IrisRadiusMM: 10.991040000000002
    PupilRadiusMM: 4.00715
    IrisPlaneDepthMM: 5.724500000000001
    CorneaIor: 1.336
    LimbalRingWidthMM: 1.03041
    LimbalRingStrength: 0.6
    PupilDarkening: 1
    IrisConcavity: 0
    IrisColor:
    - 0.22
    - 0.3
    - 0.38
