Scene: ReflectionProbeCorridor.olo
# ─────────────────────────────────────────────────────────────────────────────
# Distance-impostor reflection probes (issue #705) — the acceptance-criteria
# corridor: a mirror floor between a RED (-X) and a GREEN (+X) wall, a BLUE
# far end (-Z) and a YELLOW near end (+Z), lit by two white point lights.
#
# To exercise the feature: select "Corridor Probe" and press "Bake Reflection
# Probe" in the inspector. The mirror floor then reflects each wall in the
# correct PLACE (red on the left strip, green on the right, yellow visible in
# the floor when looking toward +Z with the wall itself off-screen — the
# SSR-failure case). Deactivating the probe falls back to the sky/neutral.
# ─────────────────────────────────────────────────────────────────────────────
Entities:
  - Entity: 705000000000001
    TagComponent:
      Tag: Camera
    TransformComponent:
      Translation: [0, 1.8, 9]
      Rotation: [-0.35, 0, 0]
      Scale: [1, 1, 1]
    CameraComponent:
      Camera:
        ProjectionType: 0
        PerspectiveFOV: 1.0472
        PerspectiveNear: 0.05
        PerspectiveFar: 1000
        OrthographicSize: 10
        OrthographicNear: -1
        OrthographicFar: 1
      Primary: true
      FixedAspectRatio: false
  - Entity: 705000000000002
    TagComponent:
      Tag: Corridor Probe
    TransformComponent:
      Translation: [0, 2, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    ReflectionProbeComponent:
      InfluenceRadius: 40
      BlendDistance: 4
      Resolution: 256
      Intensity: 1
      Active: true
  - Entity: 705000000000003
    TagComponent:
