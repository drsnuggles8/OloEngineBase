Scene: Drift.olo
Version: 1
PostProcessSettings:
  TonemapOperator: 1
  Exposure: 1
  Gamma: 2.2
  BloomEnabled: true
  BloomThreshold: 1.1
  BloomIntensity: 0.22
  BloomIterations: 4
  VignetteEnabled: true
  VignetteIntensity: 0.28
  VignetteSmoothness: 0.35
  ChromaticAberrationEnabled: false
  ChromaticAberrationIntensity: 0.5
  FXAAEnabled: true
  DOFEnabled: false
  DOFFocusDistance: 10
  DOFFocusRange: 5
  DOFBokehRadius: 3
  MotionBlurEnabled: false
  MotionBlurStrength: 0.5
  MotionBlurSamples: 4
  ColorGradingEnabled: false
  # Explicitly opt out of AO for the thin two-sided sail/deck geometry. The
  # authored selector survives quality-tier application; see issue #901.
  ActiveAOTechnique: 0
  GTAOEnabled: false
  SSAOEnabled: false
  SSAORadius: 0.5
  SSAOBias: 0.025
  SSAOIntensity: 1
  SSAOSamples: 32
  SSAODebugView: false
# Fog, wind and precipitation are the WEATHER DIRECTOR'S (issue #882).
# WeatherSystem::ApplyBlended overwrites Fog Enabled/Density/Color/HeightFalloff/
# MaxOpacity, Wind Enabled/Speed/GustStrength/TurbulenceIntensity, and
# Precipitation Enabled/Intensity every tick from the blended preset on the
# Atmosphere entity. What is authored in these three blocks is only what the
# director does NOT touch (fog Mode/Start/End/scattering, wind Direction and
# grid, every precipitation field except Enabled/Intensity) plus a sane look
# for the frame before the first Play tick.
FogSettings:
  Enabled: true
  # Exponential. This is why the director's per-state FogDensity is the knob
  # that matters and Start/End below are only the Linear-mode fallback.
  Mode: 1
  Color: [0.66, 0.76, 0.86]
  Density: 0.0009
  Start: 420
  End: 1800
  HeightFalloff: 0
  HeightOffset: 0
  MaxOpacity: 0.85
  EnableScattering: false
  RayleighStrength: 0.5
  MieStrength: 0.003
  MieDirectionality: 0.76
  RayleighColor: [0.27, 0.51, 0.83]
  SunIntensity: 5
WindSettings:
  # Blowing along the authored swell (WaveDir0 below), so wind and sea agree.
  # Since #899 this block is ALSO the boat's engine: SailSystem reads Direction
  # and Speed straight out of here, so what used to be a foliage/particle
  # setting is now the thing that decides which way the player can go.
  #
  # Direction stays FIXED per leg on purpose. Rotating it without also rotating
  # the wave trains would put the whitecaps across the wind, and the sea state
  # is what a player reads the wind off before they look at the sail.
  # Speed is overwritten every tick by the weather director (2 / 5 / 14 m/s for
  # Clear / Overcast / Storm), which is why the sailing tuning below has to work
  # across a 7x range of wind rather than at one design point.
  Enabled: true
  Direction: [0.989, 0, 0.148]
  Speed: 2
  GustStrength: 0.1
  GustFrequency: 0.25
  TurbulenceIntensity: 0.2
  TurbulenceScale: 0.1
  GridWorldSize: 200
  GridResolution: 128
# Rain over open water.
#
# TWO things about this block are load-bearing and neither is obvious.
#
#   1. Type is authored as Rain (1) to MATCH what all three of this scene's
#      weather states precipitate. WeatherSystem::ApplyBlended stamps
#      PrecipitationSettings::GetDefaultsForType over this whole block ONLY when
#      the kind actually changes — so keeping them equal is what lets the
#      streaks, the impacts and the sea-level GroundY below survive into play.
#   2. Because no type switch ever fires, this block must carry the RAIN
#      parameters in full. The PrecipitationSettings struct defaults are SNOW
#      (0.8 m/s fall, 10 s lifetime, 30 deg/s rotation) — a partial block here
#      would leave a squall drifting down like a blizzard, which is a plausible
#      enough frame to ship by accident.
PrecipitationSettings:
  Enabled: false
  Type: 1
  Intensity: 0
  TransitionSpeed: 0.5
  BaseEmissionRate: 8000
  MaxParticlesNearField: 100000
  MaxParticlesFarField: 200000
  NearFieldExtent: [15, 20, 15]
  NearFieldParticleSize: 0.02
  NearFieldSizeVariance: 0.005
  NearFieldSpeedMin: 5
  NearFieldSpeedMax: 10
  NearFieldLifetime: 4
  FarFieldExtent: [60, 30, 60]
  FarFieldParticleSize: 0.015
  FarFieldSpeedMin: 4
  FarFieldSpeedMax: 8
  FarFieldLifetime: 6
  FarFieldAlphaMultiplier: 0.35
  GravityScale: 2.5
  # Rain in a blow does not fall vertically. This is the field that makes the
  # storm state read as WIND rather than as heavier drizzle — the director
  # drives wind speed, and this is what the drops do with it.
  WindInfluence: 1.25
  DragCoefficient: 0.05
  TurbulenceStrength: 0.35
  TurbulenceFrequency: 0.3
  # The "ground" is the waterline, so drops die at the sea surface rather than
  # 22 m below it on the seafloor plane.
  GroundCollisionEnabled: true
  GroundY: 0
  CollisionBounce: 0
  CollisionFriction: 1
  # No snow in Drift, so nothing should ever settle.
  FeedAccumulation: false
  AccumulationFeedRate: 0.0001
  # A squall is read through the windscreen as much as through the air: streaks
  # and lens impacts are what make rain at sea legible behind a chase camera.
  ScreenStreaksEnabled: true
  ScreenStreakIntensity: 0.85
  ScreenStreakLength: 1.2
  LensImpactsEnabled: true
  LensImpactRate: 9
  LensImpactLifetime: 0.55
  LensImpactSize: 0.045
  LODNearDistance: 30
  LODFarDistance: 120
  FrameBudgetMs: 1
  ParticleColor: [0.7, 0.75, 0.85, 0.45]
  ColorVariance: 0.08
  RotationSpeed: 0
# =============================================================================
# Drift — issue #879, the first weekend of the first game (#878).
#
# One boat, one sea, and — since #880 — SIX islands to steer at. The pieces this
# leans on already existed: BoatSystem (#438), BuoyancySystem sampling the real
# displaced surface, CameraRigComponent (#645), InputActionManager, the GPU LOD
# quadtree (#714) and the octahedral foliage impostor (#433). The islands are
# generated height maps with scanned ground layers (#1721) — see the LAYOUT
# section.
#
# The scene explicitly disables ambient occlusion. It was switched off for the
# previous boat, whose sail and deck were thin two-sided geometry that GTAO's
# depth-only horizon search self-occluded. The boat that replaced it is closed
# geometry and carries its own traced occlusion in its maps; with GTAO switched
# on over it 5.7% of the pixels in a close quarter view move by more than 8/255,
# which is not worth a full-screen pass. CSM shadows remain enabled with
# receiver normal bias below.
#
# HOW TO SAIL IT
#   A / D            rudder to port / starboard    (gamepad: left stick X)
#   Q / E            more / less sail              (gamepad: d-pad up / down)
#   W / S            the sweep, ahead / astern     (gamepad: right / left trigger)
#   C (hold)         look astern                   (gamepad: right stick click)
#
# The bindings are action NAMES resolved through <project>/Config/InputActions.yaml
# in the Vehicle context — nothing in the scripts touches a key code, which is
# what leaves #883's rebinding UI with nothing to rewrite.
#
# LAYOUT — the island field (issues #880, #1721)
#   GENERATED with the island entities: tools/drift-islands/build_islands.py --stamp-scene
#   writes this section, down to the paragraph about the sea, from the maps on disk.
#
#   The boat starts at (0, 0, -250) pointing at Ridgeback, the tallest thing on that
#   bearing. Five more lie around it, at different bearings and distances, so there is
#   always somewhere else to go and turning round is worth doing:
#
#     Ridgeback  (    0,   280)  420 m tile, peak  85 m  ahead          414 m of water
#     Atoll      (  330,  -480)  400 m tile, peak   6 m  stbd quarter   313 m of water
#     Stacks     ( -330,  -520)  300 m tile, peak  88 m  port quarter   278 m of water
#     Mesa       (  500,    40)  360 m tile, peak  41 m  stbd bow       456 m of water
#     Dunes      ( -540,    60)  380 m tile, peak  25 m  port bow       467 m of water
#     Sisters    ( -160,   660)  260 m tile, peak  52 m  ahead          854 m of water
#
#   Peaks are above the sea. The last column is the open water from the start line to the
#   island's nearest land.
#
#   They are DIFFERENT PLACES. Each is a height map the tool builds as a landform: a recipe
#   draws its character in metres, erosion and a shore profile are derived from that, and
#   the material maps are baked beside it. The per-island notes on each entity say what
#   each one is. All six share one library of eight scanned ground layers; an island's own
#   rock and sand colour comes from its macro map.
#
#   THE SHORELINE. A terrain tile that meets an ocean must not end in a wall: every border
#   texel of every map is exactly the tile floor, and each island sits that floor 24 m
#   under the sea, so a tile's edge is seabed. Inside it the coast is shaped, not left to
#   a mask: sand coasts are pulled to a beach profile (a 7 degree foreshore and a berm),
#   rock coasts get a wave-cut platform. docs/agent-rules/terrain-tile-meets-ocean.md has
#   the rules; DriftIslandSplatCoverage pins them on the shipped maps.
#
#   The sea is 1.6 km square, deliberately, and that is the boundary of the game:
#   WaterProbe::CollectEnabledVolumes takes the playable area from the water
#   tile's bounds, so outside them there is no buoyancy and no thrust at all.
#   #878 records why it stays small — the floating-origin rebase touches four
#   subsystems that each need a different fix, and a weekend dies there. At this
#   size nothing near the boat is far enough from the origin for f32 cancellation
#   to show, so camera-relative rendering stays uninvoked.
#
# SEA STATE — NOW DRIVEN BY THE WIND (issue #882)
#   The WaterComponent below is still authored at the MODERATE state — the one
#   the boat is tuned against, and what the scene looks like before Play. From
#   the first runtime tick DriftWeatherDirector.lua owns these fields and eases
#   them between the three anchors below, following the wind speed the weather
#   director blends:
#     calm     WaveAmplitude 0.05   WaveSpeed 0.8    wind  2 m/s   (Clear)
#     moderate (as authored)         WaveAmplitude 0.12   WaveSpeed 1.0
#                                                     wind  5 m/s   (Overcast)
#     rough    WaveAmplitude 0.22   WaveSpeed 1.3    wind 14 m/s   (Storm)
#
#   These amplitudes look far too small for a sea state and there is a standing
#   temptation to raise them. #943 tried, and measured why it does not work:
#   sumGerstnerWaves runs an octave ladder down to 0.09 * avgWL (~2 m here) while
#   this mesh is 2.5 m per quad, so the finest octaves are below the mesh's
#   Nyquist limit and the surface breaks into flat facets. Clean at 0.22, faceted
#   by 0.32, and the facet SIZE tracks GridResolution — which is what proves it
#   is geometry, not shading. Band-limit the octave ladder (or tessellate) before
#   touching these. See the anchor table in DriftWeatherDirector.lua.
#
#   The script interpolates rather than inventing new numbers. It also moves the
#   foam threshold, the specular intensity and the water colour along the same
#   parameter, which is what makes the sea state legible in a STILL frame
#   rather than only in motion. Sea-state changes are eased over ~25 s, which is
#   both what a real sea does and what stops a weather transition popping.
#
#   Editing WaveAmplitude/WaveSpeed here therefore changes the pre-Play frame
#   and nothing else. Change the anchors in DriftWeatherDirector.lua.
#
#   WaveAmplitude is NOT metres of wave height. It is scaled by WaveFrequency
#   and the two steepness terms, and the product is what the surface actually
#   displaces. For THIS scene's wavelengths the worst-case crest bound works out
#   at about 2.95x the amplitude (Water.glsl :: computeMaxWaveDisplacement), so
#   the three anchors above are roughly 0.15 / 0.35 / 0.65 m.
#
#   An earlier note here warned that 0.45 "put crests several metres up, deep
#   enough that the camera pivot sat INSIDE the swell", with the water plane
#   drawn over the boat and a dithered stipple on the sail that reads as shadow
#   acne but is the surface's own transparency dither. That was recorded before
#   the chase camera was given its 2.0-2.6 m pivot (DriftFollowCamera.lua), and
#   0.45 is a 1.33 m bound rather than "several metres" — re-checked in Play at
#   the re-tuned values and the camera stays above the surface. Keep the warning
#   in mind rather than the number: if the pivot ever starts submerging, it is
#   this knob against kPivotHighY, and the symptom looks like a rendering fault.
#   Calibrate this by looking at the frame, never by reading it as a height.
#   They are worth trying in that order: the boat's character changes far more
#   between them than any single hull coefficient changes it.
#
#   The sea runs on the GERSTNER path, NOT the FFT ocean, and that is a measured
#   decision rather than a default. See the note on UseFFT below.
#
# TUNING NOTE — where the numbers live
#   Hull and RIG behaviour are entirely in BoatComponent / SailComponent /
#   BuoyancyComponent below, so a feel change is a scene edit and needs no
#   rebuild. Input shaping (throttle spool, rudder slew, the speed-dependent
#   rudder falloff, how fast sail is shortened) is in DriftBoatController.lua;
#   camera feel is in DriftFollowCamera.lua. Those places are the whole tuning
#   surface.
#
#   Since #899 the boat is WIND-DRIVEN, and the one thing not to re-derive:
#   SailComponent::SailArea and BoatComponent::ForwardDrag are a single ratio.
#   Changing either alone changes every speed in the game.
#
# WEATHER AND TIME OF DAY — issue #882
#   The Atmosphere entity below carries the whole of it: ProceduralSky,
#   TimeOfDay, WeatherState (three authored presets — Clear / Overcast / Storm)
#   and Cloudscape, plus DriftWeatherDirector.lua.
#
#   A LEG is the passage out to the island and back. Each leg gets its own
#   weather state and its own hour, cross-blended rather than cut, and the sea
#   follows the wind the blend produces. Sail out and back and the same stretch
#   of water is a different place. The full schedule, and why the clock is
#   warped rather than set, is at the top of DriftWeatherDirector.lua.
#
#   Three fields on this entity are OVERWRITTEN every tick and must not be
#   authored as if they were settings: the Sun's DirectionalLight
#   Direction/Color/Intensity (TimeOfDaySystem), the scene-level Wind/Fog/
#   Precipitation Enabled+Intensity blocks (WeatherSystem), and the
#   Cloudscape's Coverage/TypeBlend/Wetness (the blended preset).
# =============================================================================
Entities:
  # ── Camera ────────────────────────────────────────────────────────────────
  # A root entity, never a child of the boat: CameraRigSystem writes an absolute
  # world pose and a parent transform would be applied to it twice.
  #
  # RuntimeControl is OFF. The free-fly camera and the rig would both write this
  # transform every tick, and the rig — running last — would win silently.
  #
  # Target is the Camera Target proxy, NOT the boat — the proxy is where the
  # yaw smoothing and the look-astern hold live (DriftFollowCamera.lua).
  # TargetForward 2 tells the rig that proxy carries a +Z-forward heading:
  # the proxy is a bare transform, so the rig's Auto mode has no vehicle
  # component to read the convention off (issue #897).
  #
  # BoomLength / PivotOffset are the values the script eases between, so the
  # first tick starts from a sane pose rather than from zero.
  - Entity: 879000000000000
    TagComponent:
      Tag: Camera
    TransformComponent:
      Translation: [0, 2.6, -259]
      Rotation: [-0.2443461, 0, 0]
      Scale: [1, 1, 1]
    CameraComponent:
      Camera:
        ProjectionType: 0
        PerspectiveFOV: 1.1
        PerspectiveNear: 0.15
        PerspectiveFar: 2500
        OrthographicSize: 10
        OrthographicNear: -1
        OrthographicFar: 1
      Primary: true
      FixedAspectRatio: false
      RuntimeControl: false
      FlySpeed: 25
    CameraRigComponent:
      Target: 879000000000010
      PivotOffset: [0, 2.6, 0]
      BoomLength: 9
      # The boom probe is a physics raycast, so it sees the islands' heightfield
      # body and nothing else — water is not a physics body. The camera stays
      # clear of the sea by sitting high with an upward-tilted boom instead.
      CollisionEnabled: true
      ProbeRadius: 0.5
      MinBoomLength: 3.5
      BoomReturnSpeed: 5
      # The wave damper. The pivot rides the boat's heave; without this the whole
      # frame pumps with the swell and the horizon is unreadable. Long enough to
      # sit above the wave period, short enough not to lag the boat.
      PositionSmoothTime: 0.22
      HeadBobAmplitude: 0
      HeadBobFrequency: 1.1
      # Pitched DOWN at the boat, which also tilts the boom UP: at 9-13.5 m of
      # boom that puts the eye 3.4-5.1 m above the pivot, i.e. 6-7.7 m above the
      # waterline. The roughest sea state here crests around 3 m.
      FallbackPitchDeg: -21.5
      TargetForward: 2

  # ── Camera target proxy ───────────────────────────────────────────────────
  # A root transform that tracks the boat's position and carries its heading,
  # smoothed. See DriftFollowCamera.lua.
  - Entity: 879000000000010
    TagComponent:
      Tag: Camera Target
    TransformComponent:
      Translation: [0, 0, -250]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    LuaScriptComponent:
      ScriptFile: Scripts/LuaScripts/DriftFollowCamera.lua

  # ── Sun ───────────────────────────────────────────────────────────────────
  # DRIVEN, not authored, since #882: TimeOfDaySystem::Apply rewrites Direction,
  # Color and Intensity on this light every rendered frame (in edit mode too)
  # from the Atmosphere entity's clock and ephemeris, with the weather
  # director's SunDimming folded in. The values below are what the very first
  # frame uses before Apply has run once — keep them roughly dawn-like so a cold
  # open does not flash.
  #
  # The intent they encoded still holds and now comes from the clock instead:
  # every leg's hour is low enough (5.2 / 18.9 / 22.6) or hazy enough (12.0,
  # overcast) that the swell reads as relief and there is a specular track on
  # the water to steer along rather than a flat blue plane.
  #
  # Everything below Intensity — CastShadows and the CSM tuning — is still
  # authored and still load-bearing. See the long notes on each.
  - Entity: 879000000000001
    TagComponent:
      Tag: Sun
    TransformComponent:
      Translation: [0, 80, 0]
      Rotation: [-0.5235988, 0.6108652, 0]
      Scale: [1, 1, 1]
    DirectionalLightComponent:
      Direction: [-0.32, -0.78, 0.54]
      Color: [1, 0.94, 0.84]
      Intensity: 3.2
      # CSM now applies this world-space normal bias to the receiver before
      # sampling. Keep the sail casting rather than hiding its self-shadowing.
      CastShadows: true
      ShadowDepthBiasTexels: 2
      ShadowNormalBias: 0.01
      # 600 m, so an island is shaded by its own relief from the boat (issue
      # #1721): at the 35 m this used to be, nothing past the boat's own wake
      # was ever in shadow, and at a low sun every island was one flat tone.
      # The split is pushed toward the logarithmic end (0.9) to pay for it: the
      # cascades end at about 16, 40, 118 and 600 m, so the boat and its sail
      # keep the first cascade's centimetre texels and the islands take the
      # last one. Terrain casts into it from coarser meshes with distance
      # (TerrainShadowLod), which is what makes this range affordable.
      MaxShadowDistance: 600
      CascadeSplitLambda: 0.9
      CascadeDebugVisualization: false

  # ── Atmosphere ────────────────────────────────────────────────────────────
  # Issue #882: weather and time of day per leg. This entity REPLACES the static
  # cubemap skybox that was here — a fixed environment map cannot follow a sun
  # that moves, and ProceduralSkyComponent takes precedence over
  # EnvironmentMapComponent anyway (Scene::LoadAndRenderSkybox), so leaving both
  # would have been a dead component advertising IBL the frame never used.
  #
  # Everything on this entity is ENGINE work that already shipped with #633. The
  # only new logic is DriftWeatherDirector.lua, which decides which state and
  # what hour each leg gets and couples the sea to the wind — WeatherSystem
  # still owns the cross-blend and TimeOfDaySystem still owns the ephemeris.
  #
  # WHAT DRIVES WHAT, because three of these overlap and it is easy to author a
  # field that is overwritten every tick:
  #   * TimeOfDaySystem::Apply REWRITES the Sun entity's DirectionalLight
  #     Direction / Color / Intensity every rendered frame, in edit mode too.
  #     The Sun's authored values above are the pre-first-frame placeholder;
  #     SunIntensityMax below is the one that decides how bright noon is.
  #   * WeatherSystem::ApplyBlended REWRITES the scene-level Wind / Fog /
  #     Precipitation Enabled+Intensity blocks from the blended preset.
  #   * The blended preset also OVERRIDES CloudscapeComponent's Coverage,
  #     TypeBlend and Wetness. Density, the layer heights and the raymarch
  #     settings below are the authored ones that survive.
  - Entity: 879000000000002
    TagComponent:
      Tag: Atmosphere
    TransformComponent:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    ProceduralSkyComponent:
      # SunDirection here is inert: TimeOfDaySystem feeds the bake the
      # ephemeris sun. Turbidity is the marine one — a clean sea horizon, not
      # a hazy inland one.
      SunDirection: [0.3, 0.7, 0.4]
      Turbidity: 2.6
      Exposure: 0.1
      SunIntensity: 1
      SunDiskSize: 1.1
      ShowSunDisk: true
      EnableSkybox: true
      EnableIBL: true
      # Up from the 0.7 the cubemap was authored at: the procedural sky is the
      # only ambient source now, and at dusk/night it is nearly all of the
      # light on the hull.
      IBLIntensity: 0.8
      CubemapResolution: 256
    TimeOfDayComponent:
      Enabled: true
      # Leg 1's hour, so the editor frame before Play matches the first leg
      # rather than jumping when you press it. 5.2 rather than a round 6 is
      # DERIVED, not chosen: at the latitude and day below the ephemeris puts
      # the sun at +3.7 deg here, which is what "dawn" looks like. 6.6 was the
      # first guess and the sun is already 20 deg up by then — the frame reads
      # as flat mid-morning, and no amount of sky tuning fixes a sun that is
      # simply too high. Re-derive with olo_scene_set_time_of_day +
      # olo_scene_get_atmosphere if the latitude or day of year ever changes.
      TimeOfDayHours: 5.2
      DayOfYear: 172
      # Lower latitude than the engine default: a steeper sun path and a
      # shorter twilight is what an island-sailing game looks like.
      LatitudeDegrees: 34
      # 30 real minutes per game day. Between legs the director warps the clock
      # explicitly (DriftWeatherDirector.lua); this is the slow drift underneath
      # it, ~48 game seconds per real second, so the sky is never quite static.
      DayLengthMinutes: 30
      TimeScale: 1
      Paused: false
      # Off: an authoring session should not have the sun crawl across the scene
      # while you work. The inspector slider still scrubs.
      AdvanceInEditMode: false
      # THE most load-bearing number on this component, and it is pure art
      # direction. It rotates the ephemeris frame around +Y, i.e. it decides
      # WHERE in the frame the sun is. At 0 the sun rises toward +X — off the
      # starboard beam, out of shot — and the dawn and dusk legs render as a
      # flat grey sea under a colourless sky, because the warm part of the sky
      # is behind the camera and the water has nothing bright to reflect. At
      # -60 the rising sun sits almost dead ahead (+Z), which is the direction
      # the boat starts pointing and the island lies in: the low sun then lays
      # a specular track down the water straight at the bow, the island reads
      # as a silhouette against it, and the sea turns gold. Established by
      # sweeping 0 / -60 / -90 / -120 / 180 live and looking at the frames.
      NorthOffsetDegrees: -60
      SunIntensityMax: 3.6
      # Up from the 0.12 default. The night leg has to be sailable, and the only
      # thing lighting the sea is the moon.
      MoonIntensityMax: 0.22
      MoonPhase: 0.5
      SkyExposureDay: 0.1
      SkyExposureNight: 0.35
      StarIntensity: 1.2
      # A large moon is a cheap, honest way to give the night leg a specular
      # track on the water to steer along — the same job the sun does by day.
      MoonDiskSize: 1.4
      # The sky bake hash sees the clock quantized to this many GAME minutes,
      # and this number is a COST control, not a smoothness one — get it wrong
      # and the clock warp is the most expensive thing in the game.
      #
      # Do the arithmetic against the WARP, not against the free-running clock.
      # Free-running at 30 min/day the clock covers 48 game-minutes per real
      # second; a leg-1-to-leg-2 warp covers 6.8 game-HOURS in 18 s, i.e. about
      # 22.7 game-minutes per real second. At a 3-minute quantum that is ~136
      # distinct hashes, and Scene.cpp keeps only m_LastBakeHash — a monotonic
      # sweep misses the cache every single time, so it is 136 uncached
      # six-face AtmosphereSky::Generate + IBL bakes inside 18 seconds.
      #
      # 20 game-minutes brings that to ~20 bakes over the warp (about one per
      # 0.9 s, which still reads as a continuous sweep because the sun moves
      # between them) and one per 25 real seconds while the clock merely
      # drifts. Raise it further before raising CubemapResolution.
      RebakeQuantumGameMinutes: 20
    WeatherStateComponent:
      Enabled: true
      CurrentState: 0
      TargetState: 0
      # The director overwrites this per leg; the value here is what a scene
      # opened cold and played without the script would use.
      TransitionDuration: 14
      WetnessRiseRate: 0.2
      WetnessDryRate: 0.03
      # ── The three states, tuned for open water ──────────────────────────
      # Only three of the six are used. Rain / Snow / FogBank keep their engine
      # defaults: Drift never targets them, and authoring values nothing reads
      # would be three more numbers to keep honest.
      #
      # The FogHeightFalloff on all three is 0 (uniform), not the engine
      # default: a height-falloff fog thins out above its offset, and at sea
      # the camera and everything worth seeing sit within 15 m of y = 0, so a
      # falloff term only makes the fog inconsistent between the boat and the
      # island without ever reading as a layer.
      PresetClear:
        CloudCoverage: 0.18
        CloudDensity: 0.5
        CloudTypeBlend: 0.8
        CloudWetness: 0
        # FOG OFF in the clear state, and this is the single most consequential
        # line in the file — it was the first draft's worst bug.
        #
        # Exponential fog is applied by DEPTH, and the SKY sits at the far
        # plane. At 2500 m and density 0.0009 that is exp(-2.25) ~= 0.1, i.e.
        # the sky itself comes through ~90% fog colour. The result is that
        # every frame — sky, sea, island — is blended toward one pale
        # blue-grey, which is precisely the "uniform veil" failure
        # docs/agent-rules/volumetric-cloud-debugging.md is about. It was worst
        # at NIGHT, where a static pale-blue fog turned a starfield into an
        # overcast morning: the night sky measured BRIGHTER than the noon sky
        # (166 vs 68 mean luma) in the evidence captures.
        #
        # Fog colour is a per-preset constant, so it cannot follow the sun.
        # That makes "haze on a clear day" unaffordable here: the Clear state
        # is the one that has to work at BOTH dawn and night. Overcast and
        # Storm keep their fog — a veil is the point in those, and both of
        # their legs are daylit, so one colour is enough.
        FogEnabled: false
        FogDensity: 0
        FogColor: [0.66, 0.76, 0.86]
        FogHeightFalloff: 0
        FogMaxOpacity: 0.85
        WindSpeed: 2
        WindGustStrength: 0.1
        WindTurbulence: 0.2
        PrecipitationEnabled: false
        PrecipitationKind: 1
        PrecipitationIntensity: 0
        SnowAccumulationEnabled: false
        SnowAccumulationRate: 0
        SunDimming: 0
        WetnessTarget: 0
      PresetOvercast:
        CloudCoverage: 0.8
        CloudDensity: 0.75
        CloudTypeBlend: 0.2
        CloudWetness: 0.25
        FogEnabled: true
        FogDensity: 0.0016
        FogColor: [0.62, 0.66, 0.72]
        FogHeightFalloff: 0
        FogMaxOpacity: 0.9
        WindSpeed: 5
        WindGustStrength: 0.28
        WindTurbulence: 0.4
        # DRY on purpose. Three states have to be distinguishable, and "grey
        # with a sea getting up, but not raining yet" is a different frame from
        # both a clear day and a squall. Making it drizzle would collapse it
        # into a weaker Storm.
        PrecipitationEnabled: false
        PrecipitationKind: 1
        PrecipitationIntensity: 0
        SnowAccumulationEnabled: false
        SnowAccumulationRate: 0
        SunDimming: 0.4
        WetnessTarget: 0.15
      PresetStorm:
        CloudCoverage: 0.97
        CloudDensity: 1
        CloudTypeBlend: 0.85
        CloudWetness: 0.9
        FogEnabled: true
        # 0.0034, not the engine preset's 0.009. At 0.009 the island 300-550 m
        # out is gone entirely and the squall reads as a grey card — the
        # uniform-veil failure volumetric-cloud-debugging.md warns about. This
        # leaves the island heavily veiled and still findable, which is what a
        # squall you have to steer through should look like.
        FogDensity: 0.0034
        FogColor: [0.4, 0.44, 0.5]
        FogHeightFalloff: 0
        FogMaxOpacity: 0.92
        WindSpeed: 14
        WindGustStrength: 0.85
        WindTurbulence: 0.9
        PrecipitationEnabled: true
        PrecipitationKind: 1
        PrecipitationIntensity: 1
        SnowAccumulationEnabled: false
        SnowAccumulationRate: 0
        SunDimming: 0.75
        WetnessTarget: 1
    CloudscapeComponent:
      Enabled: true
      # Low and deep. The cloud SHADOWS crossing the water are most of what
      # makes weather legible in the sea rather than only in the sky, and a
      # deck this low keeps its structure inside a chase camera's frustum
      # instead of being a texture on the zenith.
      LayerBottom: 900
      LayerTop: 2600
      # Coverage / TypeBlend are overridden by the weather blend every tick;
      # these are what an inspector shows before Play.
      Coverage: 0.35
      Density: 1
      TypeBlend: 0.6
      ErosionStrength: 0.55
      # Driven per-tick by DriftWeatherDirector.lua from the sea state, so the
      # sky runs harder in a blow. This is the authored baseline.
      WindAnimationScale: 1
      WeatherMapHandle: 0
      WeatherMapScaleKm: 10
      MaxSteps: 64
      LightSteps: 6
      SunLightScale: 1
      AmbientScale: 1
      MultiScatterStrength: 0.5
      PhaseG: 0.6
      PowderStrength: 1
      CastCloudShadows: true
      ShadowStrength: 0.8
      # 6 km covers the 1.6 km of playable sea with room for the shadow of a cell
      # that has not arrived yet.
      ShadowMapWorldSize: 6000
      TemporalBlend: 0.9
      AffectIBL: true
    LuaScriptComponent:
      ScriptFile: Scripts/LuaScripts/DriftWeatherDirector.lua

  # ── Sea ───────────────────────────────────────────────────────────────────
  # The one surface BuoyancySystem, BoatSystem and the water shader all read.
  # UseFFT puts every one of them on the Tessendorf field: BuoyancySystem floats
  # the hull on the displaced surface (BuoyancySystem.cpp -> WaterProbe::
  # SampleSurfaceY) and BoatSystem samples the same field at the propeller and
  # the keel, so a crest that lifts the stern really does take the bite out of
  # the throttle. That coupling is most of what makes this feel like water.
  - Entity: 879000000000003
    TagComponent:
      Tag: Sea
    TransformComponent:
      # Centred on the world origin, which since #880 is also the centre of the
      # island field: the six islands sit inside a ring of about 700 m and the
      # start line is at z = -250, so a 1.6 km tile covers every one of them with
      # open water all round.
      #
      # The lane is NOT uniform. Sisters is the outlier: its tile reaches z = 790
      # against the water bound at z = 800, and its north coast falls near z = 761,
      # so there is about 40 m of sailable water behind it rather than the 150 m+
      # every other island has. That is deliberate — Sisters is the long leg and
      # you approach it from the south — but do not round it to the north, and do
      # not move it any further out.
      #
      # 1.6 km is a deliberate ceiling, not a shrug — #878 names the floating-
      # origin risk on a "few km, not 50" sea, and every world-space GPU upload
      # is a site for f32 cancellation past that (camera-relative-rendering.md).
      #
      # WaterProbe::CollectEnabledVolumes takes the tile's bounds from this
      # transform, so a boat outside them gets no buoyancy and no thrust at all —
      # it is a hard edge, not a fade. The bounds are what bound the game.
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    WaterComponent:
      WorldSizeX: 1600
      WorldSizeZ: 1600
      # THE sea, not a fallback — see the UseFFT note below. Two crossed wave
      # trains at slightly different headings: a single train gives the boat a
      # metronomic pitch that reads as a treadmill, and the beat between two is
      # most of what makes a swell feel like water. Amplitude is the sea-state
      # knob (see the header).
      WaveAmplitude: 0.12
      WaveFrequency: 0.55
      WaveSpeed: 1
      WaveDir0: [1, 0.15]
      WaveSteepness0: 0.25
      WaveDir1: [0.6, 0.8]
      WaveSteepness1: 0.15
      WaterColor: [0.09, 0.33, 0.44]
      DeepColor: [0.015, 0.075, 0.14]
      Transparency: 0.45
      # Fresnel F0, NOT a "how reflective" slider — the shader evaluates
      # F0 + (1 - F0) * pow(1 - NdotV, FresnelPower), so this is the reflectance
      # looking straight DOWN. 0.02 is water's real value; it was 0.85 (#943),
      # which made the sea a mirror at every angle including overhead and left
      # the reflection term owning the whole frame. Fresnel still takes it to a
      # full mirror at the horizon on its own — that is the point of the curve.
      Reflectivity: 0.02
      FresnelPower: 5
      SpecularIntensity: 1.4
      # Surface detail. The swell alone reads as satin — these are what make it
      # read as water: a scrolling normal map at a tiling much finer than the
      # wave geometry, plus foam that only appears on the crests. Both are
      # per-metre, so they stay right if the sea state changes.
      NoiseIntensity: 0.65
      NormalMapTiling: 5
      NormalMapScrollSpeed0: 0.05
      NormalMapScrollSpeed1: 0.035
      FoamHeightStart: 0.16
      FoamBrightness: 1.1
      FoamFadeDistance: 0.35
      # Shoreline foam is drawn wherever ANYTHING lies within 1.5 m under the
      # surface, and the falloff with depth is this power. The boat's hull is
      # such a thing: at the default 3 the whole of her underwater body shows
      # through the sea as a white cloud, which reads as a rendering fault. At 10
      # it is a narrow band along her waterline. Measured on Ridgeback's shore
      # and on Atoll's, the same change moves fewer pixels than two captures at
      # one setting differ by. It is this scene's setting and the clamp's
      # ceiling; #1703 is about the shader not counting a hull as a shore.
      ShorelineFoamPower: 10
      # Persistent boat-driven wake (issue #967). ON here, and this is the only
      # scene that turns it on: a feature no scene enables has zero coverage in
      # practice, however green its tests are — the terrain tessellation path
      # sat unexercised for exactly that reason.
      #
      # The half-life is the feel knob. 7 s leaves a trail roughly a boat-length
      # per second behind at cruise, which reads as a wake rather than as a
      # painted stripe that never goes away. The fade pair is deliberately far
      # longer than the crest-foam fade above: a wake is a low-frequency,
      # world-anchored signal that does not alias toward the horizon the way
      # whitecaps do, and fading it at whitecap distances would delete it behind
      # the chase camera the game is played from.
      WakeFoamEnabled: true
      WakeFoamIntensity: 0.9
      WakeFoamHalfLife: 7
      WakeFoamFadeStart: 80
      WakeFoamFadeEnd: 260
      # Wake SHAPE (issue #968): the boat displaces the surface itself, not only
      # the foam on it - a bow bump, a stern trough, a Kelvin V-ridge along the
      # hull's recent path, and the ocean flattened inside the hull footprint so
      # a crest cannot rise through the deck at close range.
      WakeShapeEnabled: true
      # ON, so the boat and any buoy ride each other's wake. Left off by default
      # everywhere else: a wrong visual wake looks wrong, a wrong physical one
      # launches the boat. Drift is the scene the CPU/GPU parity was established
      # against (WaterWakeParityTest), so it is the scene that opts in.
      WakeShapeAffectsPhysics: true
      WakeShapeHeightScale: 1
      # Not a full 1: dead-flat water inside the hull rectangle reads as a hole
      # cut in the sea from a low chase camera. 0.9 keeps a little chop against
      # the topsides while still keeping the deck dry.
      WakeShapeFlattenStrength: 0.9
      # Shore wave deformation (issue #1033) — THE reason this scene reads as a sea
      # rather than as a shader at a coastline. Every island here is a terrain tile
      # whose height map runs out to the tile floor, 24 m under water (see the
      # header's LAYOUT section), so the terrain already IS the sea
      # floor for the whole approach; nothing had to be authored for this. The
      # renderer resamples all six tiles into one 512x512 depth field over this
      # water tile — 3.1 m per texel against wavelengths of 18-27 m — and the wave
      # sum shoals, refracts and breaks against it per vertex.
      #
      # This is the only scene that turns it on, for the same reason it is the only
      # one that turns the wake on: a feature no scene enables has no coverage in
      # practice however green its tests are.
      ShoreWavesEnabled: true
      # NOT the physical 0.39, and the departure is deliberate rather than a fudge.
      # 0.39 is a real relation (a solitary wave breaks at about 0.78 h), and it is
      # what the maths uses everywhere else. But this sea is ~0.35 m crest-to-trough
      # — small for the mesh-Nyquist reason the WaveAmplitude note in the header
      # spells out, not because the game wants a millpond — and at 0.39 its surf
      # zone is the last ~15 cm of water, which is a few pixels of a frame you
      # actually play. Lowering the index moves the breaker line into deeper water
      # and widens the band. Raise it back toward 0.39 if the wave amplitudes ever
      # go up (tessellate first — see #943).
      ShoreBreakerIndex: 0.06
      ShoreFoamGain: 1
      # Deliberately far longer than the crest-foam fade (FoamFadeDistance above).
      # That fade exists because procedural whitecaps compress toward the horizon
      # into a white wash; a shoreline band is a low-frequency world-anchored signal
      # with no such failure mode, and fading it at whitecap distances would delete
      # the surf you are sailing toward.
      ShoreFoamFadeStart: 180
      ShoreFoamFadeEnd: 520
      # Refraction pulled well down from the defaults. The submerged half of the
      # hull is visible THROUGH the surface, and at the stock distortion it came
      # through as a stippled ghost lying alongside the boat that reads as a
      # broken reflection.
      RefractionDistortion: 0.018
      RefractionHeightFactor: 0.25
      DepthSofteningDistance: 1
      # QUAD SIZE IS THE KNOB, NOT THE GRID COUNT. 384 across 1 km was 2.6 m per
      # quad; #880 widened the sea to 1.6 km, so the count had to go up with it
      # or the same scene would have silently coarsened to 4.2 m. 640 across
      # 1.6 km restores 2.5 m per quad.
      #
      # Why that number is load-bearing: at the first-authored 256 across 2 km
      # (7.8 m per quad, 90 m patch) the surface aliased badly, and the submerged
      # half of the hull came through the refraction as a striped, stippled ghost
      # lying alongside the boat — which reads as a broken reflection and is not
      # one. Grid density against wavelength is the knob, not any of the
      # reflection settings; those were already off at runtime when the ghost was
      # there.
      GridResolutionX: 640
      GridResolutionZ: 640
      Enabled: true
      # Off: the mirror replay reports itself disabled at runtime in this scene
      # anyway ("[PlanarReflection] mirror replay off" in the log), so leaving
      # the flag on only advertises a feature the frame does not have.
      PlanarReflectionsEnabled: false
      PlanarReflectionIntensity: 1
      PlanarReflectionDistortion: 0.025
      UnderwaterFogColor: [0.04, 0.18, 0.3]
      UnderwaterFogDensity: 0.09
      RenderFromBelow: true
      # FFT OFF, deliberately, after an A/B on this exact scene.
      #
      # The Tessendorf path is the better ocean on paper and BuoyancySystem does
      # track its displaced surface — but here it renders the open sea as large,
      # hard-edged flat plateaus: irregular polygons a few tens of metres across,
      # darker inside with pale rims, scattered to the horizon. They read as
      # shallows or ice floes, not as water. What was ruled OUT, each by its own
      # capture: planar reflections (already reported disabled at runtime by the
      # log before the artifact was ever investigated), SSR (off, unchanged),
      # foam (off — removes the pale rims, leaves the plateaus), grid density
      # (256/2 km -> 384/1 km -> 512/600 m, unchanged), FFT patch size
      # (90 -> 140 -> 220, unchanged), choppiness (0.9 -> 0.5, unchanged), and
      # water tessellation (made it dramatically worse — whole continents). It
      # scales with FFTAmplitude and vanishes as the surface flattens, so it is
      # in how the FFT displacement is shaded, not in any of the reflection or
      # foam terms. Filed as an engine issue with the captures attached.
      #
      # The Gerstner path renders the same sea state as a clean rolling swell,
      # and WaterProbe::SampleSurfaceY reads it exactly the same way, so the
      # boat still floats on the real displaced surface and BoatSystem still
      # loses propeller bite when a crest lifts the stern. Nothing about the
      # feel work depends on which of the two is driving the height field.
      UseFFT: false
      FFTResolution: 128
      FFTPatchSize: 140
      FFTWindSpeed: 8
      FFTWindDirection: [1, 0.2]
      FFTAmplitude: 0.55
      FFTChoppiness: 0.9
      FFTHeightScale: 1

  # ── Seafloor ──────────────────────────────────────────────────────────────
  # Visual depth reference only (no collider): it is what stops the open sea
  # reading as an infinite void through the transparency.
  #
  # It sits 2 m BELOW the island tiles' base height (-24), not above it. That
  # ordering is the whole point: the radial island falloff drives each tile's
  # border down to exactly its base, so a seafloor plane any higher than that
  # would slice through every island's underwater flank as a flat grey lid — the
  # island would end at a hard horizontal line instead of shelving away. 2 m of
  # clearance at ~24 m depth is invisible through the underwater fog and leaves
  # no z-fighting.
  #
  # Widened with the sea, keeping the original 1.5x margin over the water tile: it
  # has to out-reach the water or a grazing look through the transparency finds
  # the plane's own edge and open sky beyond it.
  - Entity: 879000000000004
    TagComponent:
      Tag: Seafloor
    TransformComponent:
      Translation: [0, -26, 0]
      Rotation: [0, 0, 0]
      Scale: [2400, 1, 2400]
    MeshComponent:
      Primitive: 3
    MaterialComponent:
      AlbedoColor: [0.3, 0.29, 0.24]
      Metallic: 0
      Roughness: 0.95

  # ── Island - Ridgeback ────────────────────────────────────────────────────
  # The steering target, dead ahead of the start line. A whaleback of gneiss: a long spine
  # with a summit and a saddle, sheer on its weather (north) side, grass falling south to a
  # rock shore with shingle coves. The timber landing and hand crane stand on a low rock
  # spit in the lee of the west point.
  #
  # GENERATED: tools/drift-islands/build_islands.py --stamp-scene writes this entity, from
  # this header to the end of its FoliageComponent. Change the tool, not this text.
  #
  # The ground is a height MAP (issue #1721), not a noise recipe: the tool models the
  # landform, erodes it, shapes its shore and bakes the material maps beside it. The tile
  # floor is 24 m under the sea (0.214 of the 112 m HeightScale) and every border
  # texel of the map is exactly that floor, so the tile edge is seabed, never a wall.
  - Entity: 879000000000005
    TagComponent:
      Tag: Island - Ridgeback
    TransformComponent:
      # Origin is a CORNER, not the centre: a 420 m tile centred on (0, ., 280).
      Translation: [-210, -24, 70]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    TerrainComponent:
      HeightmapPath: Assets/Terrain/DriftIslands/Ridgeback_Height.png
      WorldSizeX: 420
      WorldSizeZ: 420
      HeightScale: 112
      CollisionEnabled: true
      ProceduralEnabled: false
      # No mask is applied to a height map. The radius is kept because the weather director
      # derives this island's landfall and departure rings from it:
      #   coast = (IslandFalloffRadius + 0.5) * 0.5 * WorldSizeX
      # which gives 182 m here, the distance from the tile centre to its farthest land.
      ShapingIslandFalloff: 0
      ShapingIslandFalloffRadius: 0.366
      AutoMaterial: false
      # The GPU LOD quadtree (issue #714) drives this terrain; nodes are picked by
      # screen-space error, so the island resolves as the boat closes instead of popping.
      TessellationEnabled: true
      TargetTriangleSize: 6
      MorphRegion: 0.3
      SplatmapPath0: Assets/Terrain/DriftIslands/Ridgeback_Splat0.png
      SplatmapPath1: Assets/Terrain/DriftIslands/Ridgeback_Splat1.png
      # Island-scale colour and wetness (128 = neutral, alpha 255 = dry): this island's
      # rock and sand colour, its tide band, lichen, bedding and damp gullies.
      MacroMapPath: Assets/Terrain/DriftIslands/Ridgeback_Macro.png
      LayerResolution: 1024
      # One shared library of eight scanned layers. TilingScale is repeats across the
      # tile, so it is the tile size over the metres one repeat should cover.
      Layers:
        - Name: Seabed
          AlbedoPath: Assets/Terrain/DriftIslands/Layers/Seabed_Color.jpg
          NormalPath: Assets/Terrain/DriftIslands/Layers/Seabed_Normal.jpg
          ARMPath: Assets/Terrain/DriftIslands/Layers/Seabed_ARM.png
          TilingScale: 105
          HeightBlendSharpness: 6
          TriplanarSharpness: 6
          BaseColor: [0.3, 0.29, 0.24]
          Roughness: 0.9
          Metallic: 0
        - Name: Sand
          AlbedoPath: Assets/Terrain/DriftIslands/Layers/Sand_Color.jpg
          NormalPath: Assets/Terrain/DriftIslands/Layers/Sand_Normal.jpg
          ARMPath: Assets/Terrain/DriftIslands/Layers/Sand_ARM.png
          TilingScale: 161.5
          HeightBlendSharpness: 6
          TriplanarSharpness: 6
          BaseColor: [0.42, 0.37, 0.28]
          Roughness: 0.9
          Metallic: 0
        - Name: Shingle
          AlbedoPath: Assets/Terrain/DriftIslands/Layers/Shingle_Color.jpg
          NormalPath: Assets/Terrain/DriftIslands/Layers/Shingle_Normal.jpg
          ARMPath: Assets/Terrain/DriftIslands/Layers/Shingle_ARM.png
          TilingScale: 190.9
          HeightBlendSharpness: 6
          TriplanarSharpness: 6
          BaseColor: [0.22, 0.21, 0.2]
          Roughness: 0.9
          Metallic: 0
        - Name: Turf
          AlbedoPath: Assets/Terrain/DriftIslands/Layers/Turf_Color.jpg
          NormalPath: Assets/Terrain/DriftIslands/Layers/Turf_Normal.jpg
          ARMPath: Assets/Terrain/DriftIslands/Layers/Turf_ARM.png
          TilingScale: 175
          HeightBlendSharpness: 6
          TriplanarSharpness: 6
          BaseColor: [0.095, 0.15, 0.05]
          Roughness: 0.9
          Metallic: 0
        - Name: Heath
          AlbedoPath: Assets/Terrain/DriftIslands/Layers/Heath_Color.jpg
          NormalPath: Assets/Terrain/DriftIslands/Layers/Heath_Normal.jpg
          ARMPath: Assets/Terrain/DriftIslands/Layers/Heath_ARM.png
          TilingScale: 210
          HeightBlendSharpness: 6
          TriplanarSharpness: 6
          BaseColor: [0.11, 0.095, 0.06]
          Roughness: 0.9
          Metallic: 0
        - Name: Rock
          AlbedoPath: Assets/Terrain/DriftIslands/Layers/Rock_Color.jpg
          NormalPath: Assets/Terrain/DriftIslands/Layers/Rock_Normal.jpg
          ARMPath: Assets/Terrain/DriftIslands/Layers/Rock_ARM.png
          TilingScale: 140
          HeightBlendSharpness: 6
          TriplanarSharpness: 6
          BaseColor: [0.2, 0.195, 0.19]
          Roughness: 0.9
          Metallic: 0
        - Name: RockBedded
          AlbedoPath: Assets/Terrain/DriftIslands/Layers/RockBedded_Color.jpg
          NormalPath: Assets/Terrain/DriftIslands/Layers/RockBedded_Normal.jpg
          ARMPath: Assets/Terrain/DriftIslands/Layers/RockBedded_ARM.png
          TilingScale: 123.5
          HeightBlendSharpness: 6
          TriplanarSharpness: 6
          BaseColor: [0.3, 0.22, 0.16]
          Roughness: 0.9
          Metallic: 0
        - Name: Scree
          AlbedoPath: Assets/Terrain/DriftIslands/Layers/Scree_Color.jpg
          NormalPath: Assets/Terrain/DriftIslands/Layers/Scree_Normal.jpg
          ARMPath: Assets/Terrain/DriftIslands/Layers/Scree_ARM.png
          TilingScale: 190.9
          HeightBlendSharpness: 6
          TriplanarSharpness: 6
          BaseColor: [0.21, 0.2, 0.19]
          Roughness: 0.9
          Metallic: 0
    # Discovery loop (issue #881): landing trigger + landmark tag. The box is the land's
    # own bounding box plus 10 m, from below the waterline to above the peak, so a boat
    # registers a landing as it closes the shore.
    DiscoverableComponent:
      DisplayName: Ridgeback
    Rigidbody3DComponent:
      BodyType: 0
      IsTrigger: true
    BoxCollider3DComponent:
      HalfExtents: [179, 80, 113]
      Offset: [207, 24, 192]
    FoliageComponent:
      Enabled: true
      Layers:
        - Name: Turf
          MeshPath: Assets/Models/Vegetation/grass/grass.obj
          AlbedoPath: Assets/Models/Vegetation/grass/Textures/grass_card.png
          Density: 6
          SplatmapChannel: 3
          MinSlopeAngle: 0
          MaxSlopeAngle: 38
          MinScale: 0.85
          MaxScale: 1.2
          MinHeight: 0.28
          MaxHeight: 0.5
          RandomRotation: true
          SlopeFeather: 6
          UseAltitudeBand: true
          MinAltitude: 26.4
          MaxAltitude: 1000
          AltitudeFeather: 0.8
          ClumpStrength: 0.5
          ClumpScale: 9
          ClumpFalloff: 1.2
          ClumpScaleInfluence: 0.3
          SlopeSinkFactor: 0.6
          ViewDistance: 110
          FadeStartDistance: 85
          MeshViewDistance: 16
          MeshFadeStartDistance: 11
          WindStrength: 0.45
          WindSpeed: 1.4
          BaseColor: [0.92, 0.95, 0.88]
          Roughness: 0.75
          AlphaCutoff: 0.45
          TransmissionStrength: 0.45
          LodTransitionSpread: 5
          LodHysteresis: 0.08
          LodStochasticCoverage: true
          UseDensityLod: true
          DensityLodStartDistance: 22
          DensityLodEndDistance: 80
          DensityLodMinFraction: 0.3
          Enabled: true
          CastShadows: false
        - Name: Moor grass
          MeshPath: Assets/Models/Vegetation/grass_dry/grass_dry.obj
          AlbedoPath: Assets/Models/Vegetation/grass_dry/Textures/grass_dry_card.png
          Density: 4
          SplatmapChannel: 4
          MinSlopeAngle: 0
          MaxSlopeAngle: 38
          MinScale: 0.85
          MaxScale: 1.2
          MinHeight: 0.3
          MaxHeight: 0.6
          RandomRotation: true
          SlopeFeather: 6
          UseAltitudeBand: true
          MinAltitude: 26.4
          MaxAltitude: 1000
          AltitudeFeather: 0.8
          ClumpStrength: 0.7
