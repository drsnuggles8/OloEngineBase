          Enabled: true

  # ── Island - Sisters ──────────────────────────────────────────────────────
  # Seven octaves on a small tile: a dense knot of small peaks and channels that
  # reads as several islands until you are close enough to see they are joined.
  # The furthest from the start line — about 950 m, the long leg.
  #
  # Waterline at 0.320 of the height range (24 m of base below sea level over a
  # 75 m HeightScale); peak about 51 m above the water. The layer bands below are
  # anchored on that number, not on absolute heights, so every island bands the
  # same way in relative terms however deep it is sunk.
  - Entity: 879000000000011
    TagComponent:
      Tag: Island - Sisters
    TransformComponent:
      # Origin is a CORNER, not the centre: a 260 m tile centred on (-160, ., 660).
      Translation: [-290, -24, 530]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    TerrainComponent:
      HeightmapPath: ""
      WorldSizeX: 260
      WorldSizeZ: 260
      HeightScale: 75
      CollisionEnabled: true
      ProceduralEnabled: true
      ProceduralSeed: 3313
      ProceduralResolution: 256
      ProceduralOctaves: 7
      ProceduralFrequency: 2.6
      ProceduralLacunarity: 2
      ProceduralPersistence: 0.48
      ShapingRidgeBlend: 0.55
      ShapingWarpStrength: 0.26
      ShapingWarpFrequency: 3
      ShapingTerraceSteps: 0
      ShapingTerraceSharpness: 0.6
      ShapingHeightExponent: 1.25
      # THE reason this scene has a shoreline instead of a seam (issue #880). At
      # strength 1 the radial mask drives every border texel of the tile to the base
      # height, 24 m under water, so the tile edge is sea floor and the coastline is
      # wherever the masked field crosses y = 0. Measured before the mask existed:
      # 64.9% of this tile's border stood ABOVE sea level, as a vertical wall.
      ShapingIslandFalloff: 1
      ShapingIslandFalloffRadius: 0.28
      AutoMaterial: true
      SplatmapGenResolution: 512
      LayerRules:
        - LayerIndex: 0
          MinHeight: 0
          MaxHeight: 0.388
          HeightBlend: 0.05
          MinSlopeDeg: 0
          MaxSlopeDeg: 34
          SlopeBlend: 10
          Strength: 1
        - LayerIndex: 1
          MinHeight: 0.402
          MaxHeight: 0.769
          HeightBlend: 0.06
          MinSlopeDeg: 0
          MaxSlopeDeg: 42
          SlopeBlend: 12
          Strength: 1
        - LayerIndex: 2
          MinHeight: 0
          MaxHeight: 1
          HeightBlend: 0
          MinSlopeDeg: 48
          MaxSlopeDeg: 90
          SlopeBlend: 12
          Strength: 1
        - LayerIndex: 3
          MinHeight: 0.864
          MaxHeight: 1
          HeightBlend: 0.05
          MinSlopeDeg: 0
          MaxSlopeDeg: 45
          SlopeBlend: 10
          Strength: 1
      # The GPU LOD quadtree drives this terrain (issue #714). It is what makes an
      # island resolve as you sail toward it instead of popping: nodes are selected by
      # screen-space error and adjacent patches are edge-snapped, so a level change
      # cannot open a crack. No Drift terrain set this flag before #880.
      TessellationEnabled: true
      TargetTriangleSize: 10
      MorphRegion: 0.3
      StreamingEnabled: false
      TileDirectory: ""
      TileFilePattern: tile_%d_%d.raw
      TileWorldSize: 256
      TileResolution: 513
      StreamingLoadRadius: 3
      StreamingMaxTiles: 25
      VoxelEnabled: false
      VoxelSize: 1
      SplatmapPath0: ""
      SplatmapPath1: ""
      Layers:
        - Name: Sand
          AlbedoPath: ""
          NormalPath: ""
          ARMPath: ""
          TilingScale: 22
          HeightBlendSharpness: 4
          TriplanarSharpness: 8
          BaseColor: [0.78, 0.72, 0.55]
          Roughness: 0.95
          Metallic: 0
        - Name: Scrub
          AlbedoPath: ""
          NormalPath: ""
          ARMPath: ""
          TilingScale: 24
          HeightBlendSharpness: 4
          TriplanarSharpness: 8
          BaseColor: [0.28, 0.4, 0.21]
          Roughness: 0.92
          Metallic: 0
        - Name: Rock
          AlbedoPath: ""
          NormalPath: ""
          ARMPath: ""
          TilingScale: 14
          HeightBlendSharpness: 4
          TriplanarSharpness: 8
          BaseColor: [0.44, 0.41, 0.38]
          Roughness: 0.85
          Metallic: 0
        - Name: Heath
          AlbedoPath: ""
          NormalPath: ""
          ARMPath: ""
          TilingScale: 18
          HeightBlendSharpness: 4
          TriplanarSharpness: 8
          BaseColor: [0.52, 0.5, 0.44]
          Roughness: 0.8
          Metallic: 0
    # Discovery loop (issue #881): landing trigger + landmark tag. The box is
    # centred on the tile's geometric centre (WorldSizeX/2, WorldSizeZ/2 from
    # this entity's CORNER origin — see the Translation comment above) and
    # tall enough to span from below the waterline to above the peak, so a
    # boat registers a landing on approach rather than needing to beach exactly.
    DiscoverableComponent:
      DisplayName: Sisters
    Rigidbody3DComponent:
      BodyType: 0
      IsTrigger: true
    BoxCollider3DComponent:
      HalfExtents: [95, 80, 95]
      Offset: [130, 24, 130]
    FoliageComponent:
      Enabled: true
      Layers:
        - Name: Scrub
          MeshPath: ""
          AlbedoPath: assets/textures/grass.png
          Density: 0.45
          SplatmapChannel: 1
          MinSlopeAngle: 0
          MaxSlopeAngle: 40
          MinScale: 0.8
          MaxScale: 1.6
          MinHeight: 1.4
          MaxHeight: 3
          RandomRotation: true
          ViewDistance: 260
          FadeStartDistance: 200
          WindStrength: 0.4
          WindSpeed: 1.6
          BaseColor: [0.28, 0.44, 0.18]
          Roughness: 0.8
          AlphaCutoff: 0.5
          Enabled: true
        - Name: Dune grass
          MeshPath: ""
          AlbedoPath: assets/textures/grass.png
          Density: 0.16
          SplatmapChannel: 0
          MinSlopeAngle: 0
          MaxSlopeAngle: 20
          MinScale: 0.7
          MaxScale: 1.3
          MinHeight: 1
          MaxHeight: 2.2
          RandomRotation: true
          ViewDistance: 200
          FadeStartDistance: 150
          WindStrength: 0.5
          WindSpeed: 1.3
          BaseColor: [0.62, 0.6, 0.34]
          Roughness: 0.8
          AlphaCutoff: 0.5
          Enabled: true
        - Name: Pines
          MeshPath: SandboxProject/Assets/Models/Vegetation/pine.obj
          AlbedoPath: assets/textures/grass.png
          Density: 0.016
          SplatmapChannel: 1
          MinSlopeAngle: 0
          MaxSlopeAngle: 38
          MinScale: 0.9
          MaxScale: 1.4
          MinHeight: 9
          MaxHeight: 16
          RandomRotation: true
          ViewDistance: 1100
          FadeStartDistance: 950
          WindStrength: 0.16
          WindSpeed: 0.8
          BaseColor: [0.19, 0.33, 0.2]
          Roughness: 0.8
          AlphaCutoff: 0.5
          # Octahedral impostor card (issue #433). The near billboard is a tufted
          # quad; past 30 m it cross-fades into the baked atlas, which is what gives
          # the tree line a 3D silhouette from any azimuth at range. NO scene set
          # UseImpostor before this one, so the path had zero runtime coverage.
          UseImpostor: true
          ImpostorStartDistance: 30
          ImpostorTransitionBand: 18
          ImpostorFramesPerAxis: 8
          ImpostorAtlasResolution: 1024
          ImpostorHemiOctahedral: true
          Enabled: true

  # ── The boat ──────────────────────────────────────────────────────────────
  # SINCE #899 THIS IS A SAILING BOAT. The wind drives it (SailComponent below);
  # the propeller is an auxiliary for getting off a lee shore and out of a flat
  # calm, and its MaxThrust was cut by an order of magnitude to say so. Read the
  # sail block before re-tuning anything here — hull drag and sail area are one
  # ratio, not two independent numbers.
  #
  # THE HULL NUMBERS. Derived rather than guessed, so they can be re-derived
  # after a change instead of being poked at:
  #
  #   * The probe box (2.7 x 0.9 x 5 m = 12.15 m^3) displaces 12150 kg fully
  #     submerged, so the 2600 kg hull floats at about a fifth of that — the
  #     origin sits a little ABOVE the waterline, which is the state every
  #     offset below assumes. The propeller (y = -0.55) and the keel
  #     (y = -0.45, taken from ProbeExtents.y by BoatSystem) are both under it.
  #     #899 widened that box and flattened it by the same factor, so the
  #     displacement — and the waterline — are unchanged; see the note on
  #     ProbeExtents below for why the beam had to grow.
  #   * Forward damping is NOT ForwardDrag alone. BuoyancyComponent's own
  #     LinearDrag damps the same velocity, scaled by the submerged fraction, so
  #     the effective coefficient is roughly
  #         ForwardDrag * hullImmersion + LinearDrag * submergedFraction.
  #     Both halves were cut for #899 (0.7 -> 0.12 and 0.8 -> 0.35), because a
  #     hull tuned to be held back by 22 kN of propeller cannot be moved by a
  #     sail: the wind can only ever supply a few kN, and it supplies them as a
  #     force that FALLS as the boat speeds up. The boat now carries its way
  #     between puffs, which is also what a sailing boat does.
  #   * Steady turn rate at full rudder is MaxRudderTorque / (YawDrag * mass) =
  #     5400 / (2.2 * 2600) = 0.94 rad/s, before DriftBoatController trims the
  #     rudder command back at speed. The rudder is unchanged by #899: it is the
  #     only control that still works with no wind at all.
  #
  # LinearDrag / AngularDrag on the rigidbody are ZERO on purpose. Buoyancy and
  # the hull model own all the damping; a second global damper on top of them
  # deadens the wave response the buoyancy probes exist to produce.
  - Entity: 879000000000020
    TagComponent:
      Tag: Boat
    TransformComponent:
      Translation: [0, 0, -250]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    Rigidbody3DComponent:
      BodyType: 1
      Mass: 2600
      LinearDrag: 0
      AngularDrag: 0
      DisableGravity: false
    BoxCollider3DComponent:
      HalfExtents: [1, 0.4, 2.5]
    BuoyancyComponent:
      Enabled: true
      # WIDER THAN THE COLLIDER, AND NARROWER IN HEIGHT, ON PURPOSE (#899).
      # This box is the submerged-hull model, and its BEAM is what sets the
      # righting moment that a loaded sail has to be fought back by. At a
      # half-beam of 1.0 it was narrower than the drawn hull actually is
      # (the model is 4.8 wide, x 0.57 = 2.74 m, so 1.37), and a rig big
      # enough to move the boat rolled her clean over — measured, upside down
      # and floating. 1.35 is the hull's real beam; the height came down from
      # 0.6 to 0.45 to keep the displaced volume, and so the waterline, where
      # it was. Stiffer, not more buoyant.
      ProbeExtents: [1.35, 0.45, 2.5]
      FluidDensity: 1000
      BuoyancyScale: 1
      # Vertical bobbing damper — but it damps SURGE too (BuoyancySystem applies
      # it to the whole velocity vector, scaled by the submerged fraction), and
      # at 0.8 it was the single biggest thing standing between the wind and the
      # boat. Halved for #899. Still low enough that the hull rides the swell.
      LinearDrag: 0.35
      # Rocking damper. This is the knob that decides whether the swell reads as
      # a boat working in a seaway or as a bath toy; 1.2 keeps the roll alive
      # without letting it build.
      AngularDrag: 2.2
      SubmergenceRamp: 0.8
    # The AUXILIARY. Everything here still works exactly as it did; it is just
    # no longer the way you get anywhere. 900 N against the reduced damping is
    # about 2 m/s — enough to claw off a lee shore or ghost out of a flat calm
    # (the Clear leg's 2 m/s wind only makes about 0.7 m/s under sail), and
    # deliberately slower than the same boat under sail in any real breeze. That
    # ordering is the whole point and is pinned by
    # SailTest's DriftSailingTest.TheEngineIsSlowerThanTheSail.
    BoatComponent:
      Enabled: true
      MaxThrust: 900
      ThrustOffsetZ: -2.2
      ThrustOffsetY: -0.55
      MaxRudderTorque: 5400
      # Full rudder authority only from 7 m/s up. Below that the rudder is soft,
      # which is what stops the boat pivoting on the spot in the harbour and
      # gives the low-speed handling a distinct character from the high-speed.
      RudderAuthoritySpeed: 7
      # Lateral >> forward is the hull: it is what makes the boat TRACK through a
      # turn instead of sliding broadside. Dropping this toward the forward value
      # is how you would author a hovercraft.
      LateralDrag: 3.5
      # Cut from 0.7 for #899 — see the effective-damping note above. LATERAL
      # drag is deliberately untouched and now towers over it: that ratio IS the
      # keel, and on a sailing boat the keel is what converts the sail's side
      # force into forward travel instead of letting the boat slide off downwind.
      ForwardDrag: 0.12
      YawDrag: 2.2
      ImmersionDepth: 0.3
      ThrottleInput: 0
      SteerInput: 0
    # ── The rig ───────────────────────────────────────────────────────────
    # THIS is the propulsion now. SailSystem reads the scene WindSettings at
    # the centre of effort, subtracts the hull's own velocity to get apparent
    # wind, braces the yard to the angle that makes the most forward drive, and
    # applies a flat-plate force NORMAL to the sail at the point below.
    #
    # Three of these numbers decide how the game plays:
    #
    #   MaxYardAngle is the SPEED GOVERNOR and the no-go zone in one. On a reach
    #     the drive goes to zero once the boat is fast enough that the apparent
    #     wind draws forward of the braced yard, which caps beam-reach speed at
    #     roughly the true wind speed — so Clear (2 m/s), Overcast (5) and Storm
    #     (14) are three genuinely different boats. 45 deg is a square rigger's
    #     brace and puts the no-go zone at about 55-60 deg either side of the
    #     wind: there is no sailing upwind, only tacking. Raise it and the boat
    #     points higher AND goes faster; both, together, always.
    #   SailArea is a GAME number and so is the hull's ForwardDrag above — what
    #     was tuned is the RATIO of the two. A 5 m hull massing 2600 kg is
    #     already not naval architecture; asking for an honest 25 m^2 of canvas
    #     on top of it would have given a boat that took four minutes to cross
    #     the bay. Change one of the pair and re-measure, never just one.
    #   CentreOfEffort is NOT cosmetic. Its HEIGHT (2.64 m, the middle of the
    #     drawn sail once the hull mesh's 0.57 scale and -0.5 offset are
    #     applied) is the whole heel: the side force acts there, above the centre
    #     of mass, and buoyancy fights it back. That replaces the roll
    #     DriftBoatController used to fake off yaw rate. Its Z (-0.36 m, the mast
    #     line) is 0.36 m AFT of the centre of mass, which gives free weather
    #     helm — a loaded sail nudges the bow up into the wind, which is why the
    #     boat now feels like it wants something.
    SailComponent:
      Enabled: true
      SailArea: 260
      AirDensity: 1.225
      MaxNormalCoefficient: 1.5
      MaxYardAngleDeg: 45
      # A yard takes a few seconds to come round. Fast enough that a tack is not
      # a wait, slow enough that it reads as being hauled rather than snapped.
      TrimRateDeg: 28
      # 2.0, not the 2.64 that is the middle of the DRAWN sail. SailArea is the
      # whole rig's area, so this has to be the whole rig's centre of effort —
      # and the sails a low-poly mesh does not show (headsail, staysail) all sit
      # lower than the one it does. Height is the heel, so this is also the
      # cheapest lever if she ever lies over too far.
      CentreOfEffortY: 2.0
      CentreOfEffortZ: -0.36
      AutoTrim: true
      TrimInput: 0
      SailSetInput: 1
    LuaScriptComponent:
      ScriptFile: Scripts/LuaScripts/DriftBoatController.lua
    # Discovery loop (issue #881): the boat is the discoverer. DiscoverySystem
    # appends an island's UUID here the first time an active contact pairs
    # the boat with a DiscoverableComponent island's trigger volume.
    DiscoveredSetComponent:
      Discovered: []
    RelationshipComponent:
      ParentHandle: 0
      Children:
        - 879000000000021

  # ── Hull mesh ─────────────────────────────────────────────────────────────
  # A CHILD of the physics root, which used to be load-bearing for a reason that
  # no longer applies: DriftBoatController rolled this entity to fake heel,
  # because BoatSystem applies hull drag at the centre of mass and so the body
  # could not heel at all. Since #899 the SAIL heels the body for real (its force
  # is applied above the centre of mass), the script fake is gone, and this
  # entity is once again just the hull mesh. It stays a child because the visual
  # waterline offset below belongs to the mesh and not to the collider.
  #
  # The model is the SAIL-LESS half of the original ship-small.glb. See the sail
  # entity below and KenneyVehicles/LICENSE.md for how the pair was made.
  - Entity: 879000000000021
    TagComponent:
      Tag: Boat Hull
    TransformComponent:
      # This offset is a VISUAL waterline, and it is worth more than it looks.
      # At -0.78 a good chunk of hull sat below the surface and came through the
      # refraction as a stippled brown slick trailing the boat, which reads as a
      # rendering fault rather than as a submerged hull. Raising it to -0.5 puts
      # the mesh's own waterline near the real one and the artifact goes away.
      Translation: [0, -0.5, 0]
      Rotation: [0, 0, 0]
      Scale: [0.57, 0.57, 0.57]
    ModelComponent:
      FilePath: SandboxProject/Assets/Models/KenneyVehicles/ship-small-hull.glb
      Visible: true
    RelationshipComponent:
      ParentHandle: 879000000000020
      Children:
        - 879000000000022

  # ── The sail ──────────────────────────────────────────────────────────────
  # The entity that exists so the sail can point somewhere (#899). It is a child
  # of the HULL MESH, not of the physics root, and both halves of that matter:
  #
  #   * being under the hull mesh means it inherits the 0.57 model scale and the
  #     -0.5 visual waterline, so the translation below is in the ship model's
  #     OWN coordinates and is exactly where the sail node sat inside the
  #     original single .glb. The split is invisible;
  #   * ship-small-sail.glb was re-origined onto the mast when it was extracted,
  #     so this entity's Y ROTATION IS THE YARD ANGLE. DriftBoatController copies
  #     SailComponent::yardAngle onto it every tick and the sail braces round the
  #     mast. Without the re-origin the same rotation would swing the sail around
  #     the boat instead of around its own mast.
  #
  # Rotation is authored at zero — the yard squared, which is the trim for a dead
  # run — so the first frame before any script tick looks correct.
  - Entity: 879000000000022
    TagComponent:
      Tag: Boat Sail
    TransformComponent:
      Translation: [0, 3.13852, -0.6333724]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    ModelComponent:
      FilePath: SandboxProject/Assets/Models/KenneyVehicles/ship-small-sail.glb
      Visible: true
    RelationshipComponent:
      ParentHandle: 879000000000021
      Children: []

  # ── Discovery loop HUD (issue #881) ─────────────────────────────────────
  # "Discovered N of M" readout, top-left, always on screen.
  - Entity: 879000000000030
    TagComponent:
      Tag: Discovery Readout
    TransformComponent:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    UICanvasComponent:
      RenderMode: 0
      ScaleMode: 0
      SortOrder: 10
      ReferenceResolution: [1920, 1080]
    UIRectTransformComponent:
      AnchorMin: [0, 1]
      AnchorMax: [0, 1]
      AnchoredPosition: [24, -24]
      SizeDelta: [420, 40]
      Pivot: [0, 1]
      Rotation: 0
      Scale: [1, 1]
    UITextComponent:
      Text: "Discovered 0 of 0"
      FontPath: assets/fonts/opensans/OpenSans-Regular.ttf
      FontSize: 26
      Color: [1, 1, 1, 1]
      Alignment: 0
      Kerning: 0
      LineSpacing: 0
    DiscoveryReadoutComponent:
      Enabled: true

  # World-anchored objective marker: DiscoverySystem retargets its
  # UIWorldAnchorComponent at the nearest undiscovered island every tick, so
  # it is legible from open water without a compass or minimap. Initial
  # TargetEntity is Ridgeback, overwritten before the first frame renders.
  - Entity: 879000000000031
    TagComponent:
      Tag: Discovery Marker
    TransformComponent:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    UICanvasComponent:
      RenderMode: 0
      ScaleMode: 0
      SortOrder: 11
      ReferenceResolution: [1920, 1080]
    UIRectTransformComponent:
      AnchorMin: [0.5, 0.5]
      AnchorMax: [0.5, 0.5]
      AnchoredPosition: [0, 0]
      SizeDelta: [18, 18]
      Pivot: [0.5, 0.5]
      Rotation: 0
      Scale: [1, 1]
    UIPanelComponent:
      BackgroundColor: [1, 0.85, 0.2, 1]
    UIWorldAnchorComponent:
      TargetEntity: 879000000000005
      WorldOffset: [0, 40, 0]
    DiscoveryObjectiveMarkerComponent:
      Enabled: true
