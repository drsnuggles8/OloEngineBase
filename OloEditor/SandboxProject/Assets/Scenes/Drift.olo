Scene: Drift.olo
PostProcessSettings:
  TonemapOperator: 1
  Exposure: 1
  Gamma: 2.2
  BloomEnabled: true
  BloomThreshold: 1.1
  BloomIntensity: 0.22
  BloomIterations: 4
  VignetteEnabled: true
  VignetteIntensity: 0.28
  VignetteSmoothness: 0.35
  ChromaticAberrationEnabled: false
  ChromaticAberrationIntensity: 0.5
  FXAAEnabled: true
  DOFEnabled: false
  DOFFocusDistance: 10
  DOFFocusRange: 5
  DOFBokehRadius: 3
  MotionBlurEnabled: false
  MotionBlurStrength: 0.5
  MotionBlurSamples: 4
  ColorGradingEnabled: false
  SSAOEnabled: false
  SSAORadius: 0.5
  SSAOBias: 0.025
  SSAOIntensity: 1
  SSAOSamples: 32
  SSAODebugView: false
# Fog, wind and precipitation are the WEATHER DIRECTOR'S (issue #882).
# WeatherSystem::ApplyBlended overwrites Fog Enabled/Density/Color/HeightFalloff/
# MaxOpacity, Wind Enabled/Speed/GustStrength/TurbulenceIntensity, and
# Precipitation Enabled/Intensity every tick from the blended preset on the
# Atmosphere entity. What is authored in these three blocks is only what the
# director does NOT touch (fog Mode/Start/End/scattering, wind Direction and
# grid, every precipitation field except Enabled/Intensity) plus a sane look
# for the frame before the first Play tick.
FogSettings:
  Enabled: true
  # Exponential. This is why the director's per-state FogDensity is the knob
  # that matters and Start/End below are only the Linear-mode fallback.
  Mode: 1
  Color: [0.66, 0.76, 0.86]
  Density: 0.0009
  Start: 420
  End: 1800
  HeightFalloff: 0
  HeightOffset: 0
  MaxOpacity: 0.85
  EnableScattering: false
  RayleighStrength: 0.5
  MieStrength: 0.003
  MieDirectionality: 0.76
  RayleighColor: [0.27, 0.51, 0.83]
  SunIntensity: 5
WindSettings:
  # Blowing along the authored swell (WaveDir0 below), so wind and sea agree.
  # Since #899 this block is ALSO the boat's engine: SailSystem reads Direction
  # and Speed straight out of here, so what used to be a foliage/particle
  # setting is now the thing that decides which way the player can go.
  #
  # Direction stays FIXED per leg on purpose. Rotating it without also rotating
  # the wave trains would put the whitecaps across the wind, and the sea state
  # is what a player reads the wind off before they look at the sail.
  # Speed is overwritten every tick by the weather director (2 / 5 / 14 m/s for
  # Clear / Overcast / Storm), which is why the sailing tuning below has to work
  # across a 7x range of wind rather than at one design point.
  Enabled: true
  Direction: [0.989, 0, 0.148]
  Speed: 2
  GustStrength: 0.1
  GustFrequency: 0.25
  TurbulenceIntensity: 0.2
  TurbulenceScale: 0.1
  GridWorldSize: 200
  GridResolution: 128
# Rain over open water.
#
# TWO things about this block are load-bearing and neither is obvious.
#
#   1. Type is authored as Rain (1) to MATCH what all three of this scene's
#      weather states precipitate. WeatherSystem::ApplyBlended stamps
#      PrecipitationSettings::GetDefaultsForType over this whole block ONLY when
#      the kind actually changes — so keeping them equal is what lets the
#      streaks, the impacts and the sea-level GroundY below survive into play.
#   2. Because no type switch ever fires, this block must carry the RAIN
#      parameters in full. The PrecipitationSettings struct defaults are SNOW
#      (0.8 m/s fall, 10 s lifetime, 30 deg/s rotation) — a partial block here
#      would leave a squall drifting down like a blizzard, which is a plausible
#      enough frame to ship by accident.
PrecipitationSettings:
  Enabled: false
  Type: 1
  Intensity: 0
  TransitionSpeed: 0.5
  BaseEmissionRate: 8000
  MaxParticlesNearField: 100000
  MaxParticlesFarField: 200000
  NearFieldExtent: [15, 20, 15]
  NearFieldParticleSize: 0.02
  NearFieldSizeVariance: 0.005
  NearFieldSpeedMin: 5
  NearFieldSpeedMax: 10
  NearFieldLifetime: 4
  FarFieldExtent: [60, 30, 60]
  FarFieldParticleSize: 0.015
  FarFieldSpeedMin: 4
  FarFieldSpeedMax: 8
  FarFieldLifetime: 6
  FarFieldAlphaMultiplier: 0.35
  GravityScale: 2.5
  # Rain in a blow does not fall vertically. This is the field that makes the
  # storm state read as WIND rather than as heavier drizzle — the director
  # drives wind speed, and this is what the drops do with it.
  WindInfluence: 1.25
  DragCoefficient: 0.05
  TurbulenceStrength: 0.35
  TurbulenceFrequency: 0.3
  # The "ground" is the waterline, so drops die at the sea surface rather than
  # 22 m below it on the seafloor plane.
  GroundCollisionEnabled: true
  GroundY: 0
  CollisionBounce: 0
  CollisionFriction: 1
  # No snow in Drift, so nothing should ever settle.
  FeedAccumulation: false
  AccumulationFeedRate: 0.0001
  # A squall is read through the windscreen as much as through the air: streaks
  # and lens impacts are what make rain at sea legible behind a chase camera.
  ScreenStreaksEnabled: true
  ScreenStreakIntensity: 0.85
  ScreenStreakLength: 1.2
  LensImpactsEnabled: true
  LensImpactRate: 9
  LensImpactLifetime: 0.55
  LensImpactSize: 0.045
  LODNearDistance: 30
  LODFarDistance: 120
  FrameBudgetMs: 1
  ParticleColor: [0.7, 0.75, 0.85, 0.45]
  ColorVariance: 0.08
  RotationSpeed: 0
# =============================================================================
# Drift — issue #879, the first weekend of the first game (#878).
#
# One boat, one sea, one island to steer at. Everything here is CONTENT: no
# engine change ships with this scene. The pieces it leans on already existed —
# BoatSystem (#438), BuoyancySystem sampling the real displaced FFT surface,
# CameraRigComponent (#645), InputActionManager.
#
# BEFORE YOU PLAY: turn GTAO OFF (Renderer Settings panel). The boat's sail
# picks up flickering black speckle with it on, and the AO technique is not
# scene-serialized so this file cannot ask for it. Full write-up on the Sun
# entity's CastShadows field below.
#
# HOW TO SAIL IT
#   W / S            throttle ahead / astern      (gamepad: right / left trigger)
#   A / D            rudder to port / starboard    (gamepad: left stick X)
#   C (hold)         look astern                   (gamepad: right stick click)
#
# The bindings are action NAMES resolved through <project>/Config/InputActions.yaml
# in the Vehicle context — nothing in the scripts touches a key code, which is
# what leaves #883's rebinding UI with nothing to rewrite.
#
# LAYOUT
#   The boat starts at (0, 0, -250) pointing at the island, which is centred on
#   (0, ., 300) and about 20 seconds off at full ahead — far enough that the run
#   out to it is the thing being judged rather than a formality.
#
#   The sea is 2 km square, deliberately. #878 records why: the floating-origin
#   rebase touches four subsystems that each need a different fix, and a weekend
#   dies there. At this size nothing near the boat is far enough from the origin
#   for f32 cancellation to show, so camera-relative rendering stays uninvoked.
#
# SEA STATE — NOW DRIVEN BY THE WIND (issue #882)
#   The WaterComponent below is still authored at the MODERATE state — the one
#   the boat is tuned against, and what the scene looks like before Play. From
#   the first runtime tick DriftWeatherDirector.lua owns these fields and eases
#   them between the three anchors below, following the wind speed the weather
#   director blends:
#     calm     WaveAmplitude 0.05   WaveSpeed 0.8    wind  2 m/s   (Clear)
#     moderate (as authored)         WaveAmplitude 0.12   WaveSpeed 1.0
#                                                     wind  5 m/s   (Overcast)
#     rough    WaveAmplitude 0.22   WaveSpeed 1.3    wind 14 m/s   (Storm)
#
#   The anchors are exactly the sets #879 authored and play-tested by hand, so
#   the boat's character at each one is the character that was signed off; the
#   script interpolates rather than inventing new numbers. It also moves the
#   foam threshold, the specular intensity and the water colour along the same
#   parameter, which is what makes the sea state legible in a STILL frame
#   rather than only in motion. Sea-state changes are eased over ~25 s, which is
#   both what a real sea does and what stops a weather transition popping.
#
#   Editing WaveAmplitude/WaveSpeed here therefore changes the pre-Play frame
#   and nothing else. Change the anchors in DriftWeatherDirector.lua.
#
#   WaveAmplitude is NOT metres of wave height. It is scaled by WaveFrequency
#   and the two steepness terms, and the product is what the surface actually
#   displaces: 0.45 here put crests several metres up, deep enough that the
#   camera pivot sat INSIDE the swell and the transparent water plane was drawn
#   over the boat every few seconds. That reads as "the boat is sinking" and, on
#   the sail, as a dithered stipple that looks exactly like shadow acne and is
#   not — it is the water surface's own transparency dither in front of it.
#   Calibrate this by looking at the frame, never by reading it as a height.
#   They are worth trying in that order: the boat's character changes far more
#   between them than any single hull coefficient changes it.
#
#   The sea runs on the GERSTNER path, NOT the FFT ocean, and that is a measured
#   decision rather than a default. See the note on UseFFT below.
#
# TUNING NOTE — where the numbers live
#   Hull and RIG behaviour are entirely in BoatComponent / SailComponent /
#   BuoyancyComponent below, so a feel change is a scene edit and needs no
#   rebuild. Input shaping (throttle spool, rudder slew, the speed-dependent
#   rudder falloff, how fast sail is shortened) is in DriftBoatController.lua;
#   camera feel is in DriftFollowCamera.lua. Those places are the whole tuning
#   surface.
#
#   Since #899 the boat is WIND-DRIVEN, and the one thing not to re-derive:
#   SailComponent::SailArea and BoatComponent::ForwardDrag are a single ratio.
#   Changing either alone changes every speed in the game.
#
# WEATHER AND TIME OF DAY — issue #882
#   The Atmosphere entity below carries the whole of it: ProceduralSky,
#   TimeOfDay, WeatherState (three authored presets — Clear / Overcast / Storm)
#   and Cloudscape, plus DriftWeatherDirector.lua.
#
#   A LEG is the passage out to the island and back. Each leg gets its own
#   weather state and its own hour, cross-blended rather than cut, and the sea
#   follows the wind the blend produces. Sail out and back and the same stretch
#   of water is a different place. The full schedule, and why the clock is
#   warped rather than set, is at the top of DriftWeatherDirector.lua.
#
#   Three fields on this entity are OVERWRITTEN every tick and must not be
#   authored as if they were settings: the Sun's DirectionalLight
#   Direction/Color/Intensity (TimeOfDaySystem), the scene-level Wind/Fog/
#   Precipitation Enabled+Intensity blocks (WeatherSystem), and the
#   Cloudscape's Coverage/TypeBlend/Wetness (the blended preset).
# =============================================================================
Entities:
  # ── Camera ────────────────────────────────────────────────────────────────
  # A root entity, never a child of the boat: CameraRigSystem writes an absolute
  # world pose and a parent transform would be applied to it twice.
  #
  # RuntimeControl is OFF. The free-fly camera and the rig would both write this
  # transform every tick, and the rig — running last — would win silently.
  #
  # Target is the Camera Target proxy, NOT the boat — the proxy is where the
  # yaw smoothing and the look-astern hold live (DriftFollowCamera.lua).
  # TargetForward 2 tells the rig that proxy carries a +Z-forward heading:
  # the proxy is a bare transform, so the rig's Auto mode has no vehicle
  # component to read the convention off (issue #897).
  #
  # BoomLength / PivotOffset are the values the script eases between, so the
  # first tick starts from a sane pose rather than from zero.
  - Entity: 879000000000000
    TagComponent:
      Tag: Camera
    TransformComponent:
      Translation: [0, 2.6, -259]
      Rotation: [-0.2443461, 0, 0]
      Scale: [1, 1, 1]
    CameraComponent:
      Camera:
        ProjectionType: 0
        PerspectiveFOV: 1.1
        PerspectiveNear: 0.15
        PerspectiveFar: 2500
        OrthographicSize: 10
        OrthographicNear: -1
        OrthographicFar: 1
      Primary: true
      FixedAspectRatio: false
      RuntimeControl: false
      FlySpeed: 25
    CameraRigComponent:
      Target: 879000000000010
      PivotOffset: [0, 2.6, 0]
      BoomLength: 9
      # The boom probe is a physics raycast, so it sees the island's heightfield
      # body and nothing else — water is not a physics body. The camera stays
      # clear of the sea by sitting high with an upward-tilted boom instead.
      CollisionEnabled: true
      ProbeRadius: 0.5
      MinBoomLength: 3.5
      BoomReturnSpeed: 5
      # The wave damper. The pivot rides the boat's heave; without this the whole
      # frame pumps with the swell and the horizon is unreadable. Long enough to
      # sit above the wave period, short enough not to lag the boat.
      PositionSmoothTime: 0.22
      HeadBobAmplitude: 0
      HeadBobFrequency: 1.1
      # Pitched DOWN at the boat, which also tilts the boom UP: at 9-13.5 m of
      # boom that puts the eye 3.4-5.1 m above the pivot, i.e. 6-7.7 m above the
      # waterline. The roughest sea state here crests around 3 m.
      FallbackPitchDeg: -21.5
      TargetForward: 2

  # ── Camera target proxy ───────────────────────────────────────────────────
  # A root transform that tracks the boat's position and carries its heading,
  # smoothed. See DriftFollowCamera.lua.
  - Entity: 879000000000010
    TagComponent:
      Tag: Camera Target
    TransformComponent:
      Translation: [0, 0, -250]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    LuaScriptComponent:
      ScriptFile: Scripts/LuaScripts/DriftFollowCamera.lua

  # ── Sun ───────────────────────────────────────────────────────────────────
  # DRIVEN, not authored, since #882: TimeOfDaySystem::Apply rewrites Direction,
  # Color and Intensity on this light every rendered frame (in edit mode too)
  # from the Atmosphere entity's clock and ephemeris, with the weather
  # director's SunDimming folded in. The values below are what the very first
  # frame uses before Apply has run once — keep them roughly dawn-like so a cold
  # open does not flash.
  #
  # The intent they encoded still holds and now comes from the clock instead:
  # every leg's hour is low enough (5.2 / 18.9 / 22.6) or hazy enough (12.0,
  # overcast) that the swell reads as relief and there is a specular track on
  # the water to steer along rather than a flat blue plane.
  #
  # Everything below Intensity — CastShadows and the CSM tuning — is still
  # authored and still load-bearing. See the long notes on each.
  - Entity: 879000000000001
    TagComponent:
      Tag: Sun
    TransformComponent:
      Translation: [0, 80, 0]
      Rotation: [-0.5235988, 0.6108652, 0]
      Scale: [1, 1, 1]
    DirectionalLightComponent:
      Direction: [-0.32, -0.78, 0.54]
      Color: [1, 0.94, 0.84]
      Intensity: 3.2
      # OFF, and this is the one setting here I am not happy about.
      #
      # The boat model's sail and deck pick up heavy hatched black speckling
      # that FLICKERS as the boat moves. It took several rounds to characterise
      # because it is intermittent — any single capture can be clean, so "that
      # fixed it" is easy to believe and wrong three times running.
      #
      # There are TWO independent contributors, and turning off either one alone
      # still leaves the other:
      #
      #   1. The directional light's CSM shadow pass. This is what CastShadows
      #      below turns off, and it is the only one of the two a SCENE can
      #      control.
      #   2. GTAO. Toggling the gtao pass off (Renderer Settings panel, or
      #      olo_render_toggle_pass) removes the speckle on its own, with
      #      shadows still on — proving it is not all shadow acne.
      #
      # Verified clean only with BOTH off, across several frames including
      # mid-turn. So opening this scene cold still needs one manual step:
      # turn GTAO off. PostProcessSettings::ActiveAOTechnique is not
      # scene-serialized (only SSAOEnabled is) and the project's quality tiering
      # re-derives GTAO on every scene load, so the scene cannot ask for it.
      # Filed against the engine.
      #
      # What was RULED OUT for the shadow half: resolution (the CSM is
      # 4096 x 4096 with four cascades, per olo_render_list_targets), bias
      # (0.02 / 0.3 gave a clean capture that did not hold), and cascade fit
      # (MaxShadowDistance 120 -> 35 with CascadeSplitLambda 0.85 -> 0.4, which
      # moves the boat off the cascade 1/2 seam its 9-13 m boom parks it on —
      # several clean frames, then speckle again). The tuned values are kept
      # below for whoever picks this up.
      #
      # Common factor worth chasing: both passes sample the depth/normal
      # buffers, and the sail is thin, near-zero-thickness geometry. The asset
      # import already warns about it in the log — "12 of 12 triangles are
      # degenerate (zero-UV-area)".
      CastShadows: false
      # THE SHADOW SETTINGS ARE LOAD-BEARING. At the stock values this scene
      # showed heavy blocky self-shadow acne — hard black chunks on the sail and
      # deck that crawled as the boat moved. Two things about it are worth not
      # re-deriving, because both misled the first two attempts at a fix:
      #
      #   * It is NOT a resolution problem. The CSM here is 4096 x 4096 with four
      #     cascades (olo_render_list_targets reports ShadowMapCSM at 4096), so
      #     texel density was never the constraint. Raising ShadowBias alone
      #     appeared to fix it once and had not — the boat simply happened to be
      #     riding high in that capture.
      #   * The cascade fit uses min(cameraFar, MaxShadowDistance), and the
      #     splits are lerp(uniform, log, CascadeSplitLambda) — so at 120 m with
      #     lambda 0.85 the splits land at 5.2 / 12.6 / 32.7 / 120 m and the
      #     rig's own 9-13 m boom parks the boat right on the cascade 1/2 seam,
      #     in the far coarser of the two. Pulling MaxShadowDistance in to 35 m
      #     and dropping lambda to 0.4 puts the whole boat inside one tight
      #     near cascade, and the acne goes away outright.
      #
      # A raked, near-vertical thin sheet (the sail) is textbook acne geometry,
      # so lean on NORMAL bias rather than depth bias: it offsets along the
      # surface normal, which is what a thin sheet needs, and peter-pans far less
      # than the equivalent depth bias.
      #
      # 35 m costs nothing here — the only shadow a player can resolve is the
      # boat's own, and the island is 300 m away.
      #
      # Turning Virtual Shadow Maps on (Renderer Settings panel) also fixes it
      # completely and was how the diagnosis was confirmed, but VSM is a renderer
      # setting rather than a scene field, so a scene cannot ask for it and the
      # island would stop casting. The CSM tuning above is the shippable fix.
      ShadowBias: 0.008
      ShadowNormalBias: 0.8
      MaxShadowDistance: 35
      CascadeSplitLambda: 0.4
      CascadeDebugVisualization: false

  # ── Atmosphere ────────────────────────────────────────────────────────────
  # Issue #882: weather and time of day per leg. This entity REPLACES the static
  # cubemap skybox that was here — a fixed environment map cannot follow a sun
  # that moves, and ProceduralSkyComponent takes precedence over
  # EnvironmentMapComponent anyway (Scene::LoadAndRenderSkybox), so leaving both
  # would have been a dead component advertising IBL the frame never used.
  #
  # Everything on this entity is ENGINE work that already shipped with #633. The
  # only new logic is DriftWeatherDirector.lua, which decides which state and
  # what hour each leg gets and couples the sea to the wind — WeatherSystem
  # still owns the cross-blend and TimeOfDaySystem still owns the ephemeris.
  #
  # WHAT DRIVES WHAT, because three of these overlap and it is easy to author a
  # field that is overwritten every tick:
  #   * TimeOfDaySystem::Apply REWRITES the Sun entity's DirectionalLight
  #     Direction / Color / Intensity every rendered frame, in edit mode too.
  #     The Sun's authored values above are the pre-first-frame placeholder;
  #     SunIntensityMax below is the one that decides how bright noon is.
  #   * WeatherSystem::ApplyBlended REWRITES the scene-level Wind / Fog /
  #     Precipitation Enabled+Intensity blocks from the blended preset.
  #   * The blended preset also OVERRIDES CloudscapeComponent's Coverage,
  #     TypeBlend and Wetness. Density, the layer heights and the raymarch
  #     settings below are the authored ones that survive.
  - Entity: 879000000000002
    TagComponent:
      Tag: Atmosphere
    TransformComponent:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    ProceduralSkyComponent:
      # SunDirection here is inert: TimeOfDaySystem feeds the bake the
      # ephemeris sun. Turbidity is the marine one — a clean sea horizon, not
      # a hazy inland one.
      SunDirection: [0.3, 0.7, 0.4]
      Turbidity: 2.6
      Exposure: 0.1
      SunIntensity: 1
      SunDiskSize: 1.1
      ShowSunDisk: true
      EnableSkybox: true
      EnableIBL: true
      # Up from the 0.7 the cubemap was authored at: the procedural sky is the
      # only ambient source now, and at dusk/night it is nearly all of the
      # light on the hull.
      IBLIntensity: 0.8
      CubemapResolution: 256
    TimeOfDayComponent:
      Enabled: true
      # Leg 1's hour, so the editor frame before Play matches the first leg
      # rather than jumping when you press it. 5.2 rather than a round 6 is
      # DERIVED, not chosen: at the latitude and day below the ephemeris puts
      # the sun at +3.7 deg here, which is what "dawn" looks like. 6.6 was the
      # first guess and the sun is already 20 deg up by then — the frame reads
      # as flat mid-morning, and no amount of sky tuning fixes a sun that is
      # simply too high. Re-derive with olo_scene_set_time_of_day +
      # olo_scene_get_atmosphere if the latitude or day of year ever changes.
      TimeOfDayHours: 5.2
      DayOfYear: 172
      # Lower latitude than the engine default: a steeper sun path and a
      # shorter twilight is what an island-sailing game looks like.
      LatitudeDegrees: 34
      # 30 real minutes per game day. Between legs the director warps the clock
      # explicitly (DriftWeatherDirector.lua); this is the slow drift underneath
      # it, ~48 game seconds per real second, so the sky is never quite static.
      DayLengthMinutes: 30
      TimeScale: 1
      Paused: false
      # Off: an authoring session should not have the sun crawl across the scene
      # while you work. The inspector slider still scrubs.
      AdvanceInEditMode: false
      # THE most load-bearing number on this component, and it is pure art
      # direction. It rotates the ephemeris frame around +Y, i.e. it decides
      # WHERE in the frame the sun is. At 0 the sun rises toward +X — off the
      # starboard beam, out of shot — and the dawn and dusk legs render as a
      # flat grey sea under a colourless sky, because the warm part of the sky
      # is behind the camera and the water has nothing bright to reflect. At
      # -60 the rising sun sits almost dead ahead (+Z), which is the direction
      # the boat starts pointing and the island lies in: the low sun then lays
      # a specular track down the water straight at the bow, the island reads
      # as a silhouette against it, and the sea turns gold. Established by
      # sweeping 0 / -60 / -90 / -120 / 180 live and looking at the frames.
      NorthOffsetDegrees: -60
      SunIntensityMax: 3.6
      # Up from the 0.12 default. The night leg has to be sailable, and the only
      # thing lighting the sea is the moon.
      MoonIntensityMax: 0.22
      MoonPhase: 0.5
      SkyExposureDay: 0.1
      SkyExposureNight: 0.35
      StarIntensity: 1.2
      # A large moon is a cheap, honest way to give the night leg a specular
      # track on the water to steer along — the same job the sun does by day.
      MoonDiskSize: 1.4
      # The sky bake hash sees the clock quantized to this many GAME minutes,
      # and this number is a COST control, not a smoothness one — get it wrong
      # and the clock warp is the most expensive thing in the game.
      #
      # Do the arithmetic against the WARP, not against the free-running clock.
      # Free-running at 30 min/day the clock covers 48 game-minutes per real
      # second; a leg-1-to-leg-2 warp covers 6.8 game-HOURS in 18 s, i.e. about
      # 22.7 game-minutes per real second. At a 3-minute quantum that is ~136
      # distinct hashes, and Scene.cpp keeps only m_LastBakeHash — a monotonic
      # sweep misses the cache every single time, so it is 136 uncached
      # six-face AtmosphereSky::Generate + IBL bakes inside 18 seconds.
      #
      # 20 game-minutes brings that to ~20 bakes over the warp (about one per
      # 0.9 s, which still reads as a continuous sweep because the sun moves
      # between them) and one per 25 real seconds while the clock merely
      # drifts. Raise it further before raising CubemapResolution.
      RebakeQuantumGameMinutes: 20
    WeatherStateComponent:
      Enabled: true
      CurrentState: 0
      TargetState: 0
      # The director overwrites this per leg; the value here is what a scene
      # opened cold and played without the script would use.
      TransitionDuration: 14
      WetnessRiseRate: 0.2
      WetnessDryRate: 0.03
      # ── The three states, tuned for open water ──────────────────────────
      # Only three of the six are used. Rain / Snow / FogBank keep their engine
      # defaults: Drift never targets them, and authoring values nothing reads
      # would be three more numbers to keep honest.
      #
      # The FogHeightFalloff on all three is 0 (uniform), not the engine
      # default: a height-falloff fog thins out above its offset, and at sea
      # the camera and everything worth seeing sit within 15 m of y = 0, so a
      # falloff term only makes the fog inconsistent between the boat and the
      # island without ever reading as a layer.
      PresetClear:
        CloudCoverage: 0.18
        CloudDensity: 0.5
        CloudTypeBlend: 0.8
        CloudWetness: 0
        # FOG OFF in the clear state, and this is the single most consequential
        # line in the file — it was the first draft's worst bug.
        #
        # Exponential fog is applied by DEPTH, and the SKY sits at the far
        # plane. At 2500 m and density 0.0009 that is exp(-2.25) ~= 0.1, i.e.
        # the sky itself comes through ~90% fog colour. The result is that
        # every frame — sky, sea, island — is blended toward one pale
        # blue-grey, which is precisely the "uniform veil" failure
        # docs/agent-rules/volumetric-cloud-debugging.md is about. It was worst
        # at NIGHT, where a static pale-blue fog turned a starfield into an
        # overcast morning: the night sky measured BRIGHTER than the noon sky
        # (166 vs 68 mean luma) in the evidence captures.
        #
        # Fog colour is a per-preset constant, so it cannot follow the sun.
        # That makes "haze on a clear day" unaffordable here: the Clear state
        # is the one that has to work at BOTH dawn and night. Overcast and
        # Storm keep their fog — a veil is the point in those, and both of
        # their legs are daylit, so one colour is enough.
        FogEnabled: false
        FogDensity: 0
        FogColor: [0.66, 0.76, 0.86]
        FogHeightFalloff: 0
        FogMaxOpacity: 0.85
        WindSpeed: 2
        WindGustStrength: 0.1
        WindTurbulence: 0.2
        PrecipitationEnabled: false
        PrecipitationKind: 1
        PrecipitationIntensity: 0
        SnowAccumulationEnabled: false
        SnowAccumulationRate: 0
        SunDimming: 0
        WetnessTarget: 0
      PresetOvercast:
        CloudCoverage: 0.8
        CloudDensity: 0.75
        CloudTypeBlend: 0.2
        CloudWetness: 0.25
        FogEnabled: true
        FogDensity: 0.0016
        FogColor: [0.62, 0.66, 0.72]
        FogHeightFalloff: 0
        FogMaxOpacity: 0.9
        WindSpeed: 5
        WindGustStrength: 0.28
        WindTurbulence: 0.4
        # DRY on purpose. Three states have to be distinguishable, and "grey
        # with a sea getting up, but not raining yet" is a different frame from
        # both a clear day and a squall. Making it drizzle would collapse it
        # into a weaker Storm.
        PrecipitationEnabled: false
        PrecipitationKind: 1
        PrecipitationIntensity: 0
        SnowAccumulationEnabled: false
        SnowAccumulationRate: 0
        SunDimming: 0.4
        WetnessTarget: 0.15
      PresetStorm:
        CloudCoverage: 0.97
        CloudDensity: 1
        CloudTypeBlend: 0.85
        CloudWetness: 0.9
        FogEnabled: true
        # 0.0034, not the engine preset's 0.009. At 0.009 the island 300-550 m
        # out is gone entirely and the squall reads as a grey card — the
        # uniform-veil failure volumetric-cloud-debugging.md warns about. This
        # leaves the island heavily veiled and still findable, which is what a
        # squall you have to steer through should look like.
        FogDensity: 0.0034
        FogColor: [0.4, 0.44, 0.5]
        FogHeightFalloff: 0
        FogMaxOpacity: 0.92
        WindSpeed: 14
        WindGustStrength: 0.85
        WindTurbulence: 0.9
        PrecipitationEnabled: true
        PrecipitationKind: 1
        PrecipitationIntensity: 1
        SnowAccumulationEnabled: false
        SnowAccumulationRate: 0
        SunDimming: 0.75
        WetnessTarget: 1
    CloudscapeComponent:
      Enabled: true
      # Low and deep. The cloud SHADOWS crossing the water are most of what
      # makes weather legible in the sea rather than only in the sky, and a
      # deck this low keeps its structure inside a chase camera's frustum
      # instead of being a texture on the zenith.
      LayerBottom: 900
      LayerTop: 2600
      # Coverage / TypeBlend are overridden by the weather blend every tick;
      # these are what an inspector shows before Play.
      Coverage: 0.35
      Density: 1
      TypeBlend: 0.6
      ErosionStrength: 0.55
      # Driven per-tick by DriftWeatherDirector.lua from the sea state, so the
      # sky runs harder in a blow. This is the authored baseline.
      WindAnimationScale: 1
      WeatherMapHandle: 0
      WeatherMapScaleKm: 10
      MaxSteps: 64
      LightSteps: 6
      SunLightScale: 1
      AmbientScale: 1
      MultiScatterStrength: 0.5
      PhaseG: 0.6
      PowderStrength: 1
      CastCloudShadows: true
      ShadowStrength: 0.8
      # 6 km covers the 2 km of playable sea with room for the shadow of a cell
      # that has not arrived yet.
      ShadowMapWorldSize: 6000
      TemporalBlend: 0.9
      AffectIBL: true
    LuaScriptComponent:
      ScriptFile: Scripts/LuaScripts/DriftWeatherDirector.lua

  # ── Sea ───────────────────────────────────────────────────────────────────
  # The one surface BuoyancySystem, BoatSystem and the water shader all read.
  # UseFFT puts every one of them on the Tessendorf field: BuoyancySystem floats
  # the hull on the displaced surface (BuoyancySystem.cpp -> WaterProbe::
  # SampleSurfaceY) and BoatSystem samples the same field at the propeller and
  # the keel, so a crest that lifts the stern really does take the bite out of
  # the throttle. That coupling is most of what makes this feel like water.
  - Entity: 879000000000003
    TagComponent:
      Tag: Sea
    TransformComponent:
      # Centred on the middle of the playable water, not on the world origin:
      # the tile is 1 km square and has to cover the start line at z = -250 and
      # the island out at z = 540. WaterProbe::CollectEnabledVolumes takes the
      # tile's bounds from this transform, so a boat outside them gets no
      # buoyancy and no thrust at all — it is a hard edge, not a fade.
      Translation: [0, 0, 120]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    WaterComponent:
      WorldSizeX: 1000
      WorldSizeZ: 1000
      # THE sea, not a fallback — see the UseFFT note below. Two crossed wave
      # trains at slightly different headings: a single train gives the boat a
      # metronomic pitch that reads as a treadmill, and the beat between two is
      # most of what makes a swell feel like water. Amplitude is the sea-state
      # knob (see the header).
      WaveAmplitude: 0.12
      WaveFrequency: 0.55
      WaveSpeed: 1
      WaveDir0: [1, 0.15]
      WaveSteepness0: 0.25
      WaveDir1: [0.6, 0.8]
      WaveSteepness1: 0.15
      WaterColor: [0.09, 0.33, 0.44]
      DeepColor: [0.015, 0.075, 0.14]
      Transparency: 0.45
      Reflectivity: 0.85
      FresnelPower: 5
      SpecularIntensity: 1.4
      # Surface detail. The swell alone reads as satin — these are what make it
      # read as water: a scrolling normal map at a tiling much finer than the
      # wave geometry, plus foam that only appears on the crests. Both are
      # per-metre, so they stay right if the sea state changes.
      NoiseIntensity: 0.65
      NormalMapTiling: 5
      NormalMapScrollSpeed0: 0.05
      NormalMapScrollSpeed1: 0.035
      FoamHeightStart: 0.16
      FoamBrightness: 1.1
      FoamFadeDistance: 0.35
      # Refraction pulled well down from the defaults. The submerged half of the
      # hull is visible THROUGH the surface, and at the stock distortion it came
      # through as a stippled ghost lying alongside the boat that reads as a
      # broken reflection.
      RefractionDistortion: 0.018
      RefractionHeightFactor: 0.25
      DepthSofteningDistance: 1
      # 384 across 1 km is 2.6 m per quad against a 140 m FFT patch, i.e. ~54
      # samples per dominant wavelength. At the first-authored 256 across 2 km
      # (7.8 m per quad, 90 m patch) the surface aliased badly: the submerged
      # half of the hull came through the refraction as a striped, stippled
      # ghost lying alongside the boat, which reads as a broken reflection and
      # is not one. Grid density against patch size is the knob, not any of the
      # reflection settings — those were already off at runtime when the ghost
      # was there.
      GridResolutionX: 384
      GridResolutionZ: 384
      Enabled: true
      # Off: the mirror replay reports itself disabled at runtime in this scene
      # anyway ("[PlanarReflection] mirror replay off" in the log), so leaving
      # the flag on only advertises a feature the frame does not have.
      PlanarReflectionsEnabled: false
      PlanarReflectionIntensity: 1
      PlanarReflectionDistortion: 0.025
      UnderwaterFogColor: [0.04, 0.18, 0.3]
      UnderwaterFogDensity: 0.09
      RenderFromBelow: true
      # FFT OFF, deliberately, after an A/B on this exact scene.
      #
      # The Tessendorf path is the better ocean on paper and BuoyancySystem does
      # track its displaced surface — but here it renders the open sea as large,
      # hard-edged flat plateaus: irregular polygons a few tens of metres across,
      # darker inside with pale rims, scattered to the horizon. They read as
      # shallows or ice floes, not as water. What was ruled OUT, each by its own
      # capture: planar reflections (already reported disabled at runtime by the
      # log before the artifact was ever investigated), SSR (off, unchanged),
      # foam (off — removes the pale rims, leaves the plateaus), grid density
      # (256/2 km -> 384/1 km -> 512/600 m, unchanged), FFT patch size
      # (90 -> 140 -> 220, unchanged), choppiness (0.9 -> 0.5, unchanged), and
      # water tessellation (made it dramatically worse — whole continents). It
      # scales with FFTAmplitude and vanishes as the surface flattens, so it is
      # in how the FFT displacement is shaded, not in any of the reflection or
      # foam terms. Filed as an engine issue with the captures attached.
      #
      # The Gerstner path renders the same sea state as a clean rolling swell,
      # and WaterProbe::SampleSurfaceY reads it exactly the same way, so the
      # boat still floats on the real displaced surface and BoatSystem still
      # loses propeller bite when a crest lifts the stern. Nothing about the
      # feel work depends on which of the two is driving the height field.
      UseFFT: false
      FFTResolution: 128
      FFTPatchSize: 140
      FFTWindSpeed: 8
      FFTWindDirection: [1, 0.2]
      FFTAmplitude: 0.55
      FFTChoppiness: 0.9
      FFTHeightScale: 1

  # ── Seafloor ──────────────────────────────────────────────────────────────
  # Visual depth reference only (no collider): it is what stops the open sea
  # reading as an infinite void through the transparency.
  - Entity: 879000000000004
    TagComponent:
      Tag: Seafloor
    TransformComponent:
      Translation: [0, -22, 0]
      Rotation: [0, 0, 0]
      Scale: [2000, 1, 2000]
    MeshComponent:
      Primitive: 3
    MaterialComponent:
      AlbedoColor: [0.3, 0.29, 0.24]
      Metallic: 0
      Roughness: 0.95

  # ── Island ────────────────────────────────────────────────────────────────
  # The steering target. A single procedural heightfield tile whose origin is a
  # CORNER (SceneCameraFraming.cpp treats the terrain centre as translation +
  # half the world size), so a 480 m tile centred on (0, ., 300) starts at
  # x = -240, z = 60.
  #
  # It is sunk so that only the upper third of the height range clears the
  # water: TerrainGenerator has no radial falloff, so "island" here is a
  # landmass whose waterline does the shaping. Heights run 0..HeightScale from
  # the entity's y, i.e. -70..+50 — sea level cuts it at 0.583 of the range,
  # which is what the layer rules below are banded around.
  #
  # CollisionEnabled builds a static Jolt heightfield at runtime start, so the
  # boat can genuinely run aground and the camera boom has something to pull in
  # against near the shore.
  - Entity: 879000000000005
    TagComponent:
      Tag: Island
    TransformComponent:
      Translation: [-240, -70, 60]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    TerrainComponent:
      HeightmapPath: ""
      WorldSizeX: 480
      WorldSizeZ: 480
      HeightScale: 120
      CollisionEnabled: true
      ProceduralEnabled: true
      ProceduralSeed: 879
      ProceduralResolution: 512
      ProceduralOctaves: 6
      ProceduralFrequency: 2.2
      ProceduralLacunarity: 2
      ProceduralPersistence: 0.46
      ShapingRidgeBlend: 0.5
      ShapingWarpStrength: 0.16
      ShapingWarpFrequency: 2
      ShapingTerraceSteps: 0
      ShapingTerraceSharpness: 0.6
      ShapingHeightExponent: 1.15
      AutoMaterial: true
      SplatmapGenResolution: 512
      LayerRules:
        # Sand: the band either side of the waterline (0.583 of the range).
        - LayerIndex: 0
          MinHeight: 0
          MaxHeight: 0.63
          HeightBlend: 0.05
          MinSlopeDeg: 0
          MaxSlopeDeg: 40
          SlopeBlend: 8
          Strength: 1
        - LayerIndex: 1
          MinHeight: 0.64
          MaxHeight: 0.88
          HeightBlend: 0.06
          MinSlopeDeg: 0
          MaxSlopeDeg: 30
          SlopeBlend: 8
          Strength: 1
        - LayerIndex: 2
          MinHeight: 0
          MaxHeight: 1
          HeightBlend: 0
          MinSlopeDeg: 34
          MaxSlopeDeg: 90
          SlopeBlend: 10
          Strength: 1
        - LayerIndex: 3
          MinHeight: 0.93
          MaxHeight: 1
          HeightBlend: 0.05
          MinSlopeDeg: 0
          MaxSlopeDeg: 45
          SlopeBlend: 10
          Strength: 1
      TessellationEnabled: false
      TargetTriangleSize: 8
      MorphRegion: 0.3
      StreamingEnabled: false
      TileDirectory: ""
      TileFilePattern: tile_%d_%d.raw
      TileWorldSize: 256
      TileResolution: 513
      StreamingLoadRadius: 3
      StreamingMaxTiles: 25
      VoxelEnabled: false
      VoxelSize: 1
      SplatmapPath0: ""
      SplatmapPath1: ""
      Layers:
        - Name: Sand
          AlbedoPath: ""
          NormalPath: ""
          ARMPath: ""
          TilingScale: 22
          HeightBlendSharpness: 4
          TriplanarSharpness: 8
          BaseColor: [0.78, 0.72, 0.55]
          Roughness: 0.95
          Metallic: 0
        - Name: Scrub
          AlbedoPath: ""
          NormalPath: ""
          ARMPath: ""
          TilingScale: 24
          HeightBlendSharpness: 4
          TriplanarSharpness: 8
          BaseColor: [0.3, 0.42, 0.22]
          Roughness: 0.92
          Metallic: 0
        - Name: Rock
          AlbedoPath: ""
          NormalPath: ""
          ARMPath: ""
          TilingScale: 14
          HeightBlendSharpness: 4
          TriplanarSharpness: 8
          BaseColor: [0.44, 0.41, 0.38]
          Roughness: 0.85
          Metallic: 0
        - Name: Cliff top
          AlbedoPath: ""
          NormalPath: ""
          ARMPath: ""
          TilingScale: 18
          HeightBlendSharpness: 4
          TriplanarSharpness: 8
          BaseColor: [0.55, 0.53, 0.48]
          Roughness: 0.8
          Metallic: 0

  # ── The boat ──────────────────────────────────────────────────────────────
  # SINCE #899 THIS IS A SAILING BOAT. The wind drives it (SailComponent below);
  # the propeller is an auxiliary for getting off a lee shore and out of a flat
  # calm, and its MaxThrust was cut by an order of magnitude to say so. Read the
  # sail block before re-tuning anything here — hull drag and sail area are one
  # ratio, not two independent numbers.
  #
  # THE HULL NUMBERS. Derived rather than guessed, so they can be re-derived
  # after a change instead of being poked at:
  #
  #   * The probe box (2.7 x 0.9 x 5 m = 12.15 m^3) displaces 12150 kg fully
  #     submerged, so the 2600 kg hull floats at about a fifth of that — the
  #     origin sits a little ABOVE the waterline, which is the state every
  #     offset below assumes. The propeller (y = -0.55) and the keel
  #     (y = -0.45, taken from ProbeExtents.y by BoatSystem) are both under it.
  #     #899 widened that box and flattened it by the same factor, so the
  #     displacement — and the waterline — are unchanged; see the note on
  #     ProbeExtents below for why the beam had to grow.
  #   * Forward damping is NOT ForwardDrag alone. BuoyancyComponent's own
  #     LinearDrag damps the same velocity, scaled by the submerged fraction, so
  #     the effective coefficient is roughly
  #         ForwardDrag * hullImmersion + LinearDrag * submergedFraction.
  #     Both halves were cut for #899 (0.7 -> 0.12 and 0.8 -> 0.35), because a
  #     hull tuned to be held back by 22 kN of propeller cannot be moved by a
  #     sail: the wind can only ever supply a few kN, and it supplies them as a
  #     force that FALLS as the boat speeds up. The boat now carries its way
  #     between puffs, which is also what a sailing boat does.
  #   * Steady turn rate at full rudder is MaxRudderTorque / (YawDrag * mass) =
  #     5400 / (2.2 * 2600) = 0.94 rad/s, before DriftBoatController trims the
  #     rudder command back at speed. The rudder is unchanged by #899: it is the
  #     only control that still works with no wind at all.
  #
  # LinearDrag / AngularDrag on the rigidbody are ZERO on purpose. Buoyancy and
  # the hull model own all the damping; a second global damper on top of them
  # deadens the wave response the buoyancy probes exist to produce.
  - Entity: 879000000000020
    TagComponent:
      Tag: Boat
    TransformComponent:
      Translation: [0, 0, -250]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    Rigidbody3DComponent:
      BodyType: 1
      Mass: 2600
      LinearDrag: 0
      AngularDrag: 0
      DisableGravity: false
    BoxCollider3DComponent:
      HalfExtents: [1, 0.4, 2.5]
    BuoyancyComponent:
      Enabled: true
      # WIDER THAN THE COLLIDER, AND NARROWER IN HEIGHT, ON PURPOSE (#899).
      # This box is the submerged-hull model, and its BEAM is what sets the
      # righting moment that a loaded sail has to be fought back by. At a
      # half-beam of 1.0 it was narrower than the drawn hull actually is
      # (the model is 4.8 wide, x 0.57 = 2.74 m, so 1.37), and a rig big
      # enough to move the boat rolled her clean over — measured, upside down
      # and floating. 1.35 is the hull's real beam; the height came down from
      # 0.6 to 0.45 to keep the displaced volume, and so the waterline, where
      # it was. Stiffer, not more buoyant.
      ProbeExtents: [1.35, 0.45, 2.5]
      FluidDensity: 1000
      BuoyancyScale: 1
      # Vertical bobbing damper — but it damps SURGE too (BuoyancySystem applies
      # it to the whole velocity vector, scaled by the submerged fraction), and
      # at 0.8 it was the single biggest thing standing between the wind and the
      # boat. Halved for #899. Still low enough that the hull rides the swell.
      LinearDrag: 0.35
      # Rocking damper. This is the knob that decides whether the swell reads as
      # a boat working in a seaway or as a bath toy; 1.2 keeps the roll alive
      # without letting it build.
      AngularDrag: 2.2
      SubmergenceRamp: 0.8
    # The AUXILIARY. Everything here still works exactly as it did; it is just
    # no longer the way you get anywhere. 900 N against the reduced damping is
    # about 2 m/s — enough to claw off a lee shore or ghost out of a flat calm
    # (the Clear leg's 2 m/s wind only makes about 0.7 m/s under sail), and
    # deliberately slower than the same boat under sail in any real breeze. That
    # ordering is the whole point and is pinned by
    # SailTest's DriftSailingTest.TheEngineIsSlowerThanTheSail.
    BoatComponent:
      Enabled: true
      MaxThrust: 900
      ThrustOffsetZ: -2.2
      ThrustOffsetY: -0.55
      MaxRudderTorque: 5400
      # Full rudder authority only from 7 m/s up. Below that the rudder is soft,
      # which is what stops the boat pivoting on the spot in the harbour and
      # gives the low-speed handling a distinct character from the high-speed.
      RudderAuthoritySpeed: 7
      # Lateral >> forward is the hull: it is what makes the boat TRACK through a
      # turn instead of sliding broadside. Dropping this toward the forward value
      # is how you would author a hovercraft.
      LateralDrag: 3.5
      # Cut from 0.7 for #899 — see the effective-damping note above. LATERAL
      # drag is deliberately untouched and now towers over it: that ratio IS the
      # keel, and on a sailing boat the keel is what converts the sail's side
      # force into forward travel instead of letting the boat slide off downwind.
      ForwardDrag: 0.12
      YawDrag: 2.2
      ImmersionDepth: 0.3
      ThrottleInput: 0
      SteerInput: 0
    # ── The rig ───────────────────────────────────────────────────────────
    # THIS is the propulsion now. SailSystem reads the scene WindSettings at
    # the centre of effort, subtracts the hull's own velocity to get apparent
    # wind, braces the yard to the angle that makes the most forward drive, and
    # applies a flat-plate force NORMAL to the sail at the point below.
    #
    # Three of these numbers decide how the game plays:
    #
    #   MaxYardAngle is the SPEED GOVERNOR and the no-go zone in one. On a reach
    #     the drive goes to zero once the boat is fast enough that the apparent
    #     wind draws forward of the braced yard, which caps beam-reach speed at
    #     roughly the true wind speed — so Clear (2 m/s), Overcast (5) and Storm
    #     (14) are three genuinely different boats. 45 deg is a square rigger's
    #     brace and puts the no-go zone at about 55-60 deg either side of the
    #     wind: there is no sailing upwind, only tacking. Raise it and the boat
    #     points higher AND goes faster; both, together, always.
    #   SailArea is a GAME number and so is the hull's ForwardDrag above — what
    #     was tuned is the RATIO of the two. A 5 m hull massing 2600 kg is
    #     already not naval architecture; asking for an honest 25 m^2 of canvas
    #     on top of it would have given a boat that took four minutes to cross
    #     the bay. Change one of the pair and re-measure, never just one.
    #   CentreOfEffort is NOT cosmetic. Its HEIGHT (2.64 m, the middle of the
    #     drawn sail once the hull mesh's 0.57 scale and -0.5 offset are
    #     applied) is the whole heel: the side force acts there, above the centre
    #     of mass, and buoyancy fights it back. That replaces the roll
    #     DriftBoatController used to fake off yaw rate. Its Z (-0.36 m, the mast
    #     line) is 0.36 m AFT of the centre of mass, which gives free weather
    #     helm — a loaded sail nudges the bow up into the wind, which is why the
    #     boat now feels like it wants something.
    SailComponent:
      Enabled: true
      SailArea: 260
      AirDensity: 1.225
      MaxNormalCoefficient: 1.5
      MaxYardAngleDeg: 45
      # A yard takes a few seconds to come round. Fast enough that a tack is not
      # a wait, slow enough that it reads as being hauled rather than snapped.
      TrimRateDeg: 28
      # 2.0, not the 2.64 that is the middle of the DRAWN sail. SailArea is the
      # whole rig's area, so this has to be the whole rig's centre of effort —
      # and the sails a low-poly mesh does not show (headsail, staysail) all sit
      # lower than the one it does. Height is the heel, so this is also the
      # cheapest lever if she ever lies over too far.
      CentreOfEffortY: 2.0
      CentreOfEffortZ: -0.36
      AutoTrim: true
      TrimInput: 0
      SailSetInput: 1
    LuaScriptComponent:
      ScriptFile: Scripts/LuaScripts/DriftBoatController.lua
    RelationshipComponent:
      ParentHandle: 0
      Children:
        - 879000000000021

  # ── Hull mesh ─────────────────────────────────────────────────────────────
  # A CHILD of the physics root, which used to be load-bearing for a reason that
  # no longer applies: DriftBoatController rolled this entity to fake heel,
  # because BoatSystem applies hull drag at the centre of mass and so the body
  # could not heel at all. Since #899 the SAIL heels the body for real (its force
  # is applied above the centre of mass), the script fake is gone, and this
  # entity is once again just the hull mesh. It stays a child because the visual
  # waterline offset below belongs to the mesh and not to the collider.
  #
  # The model is the SAIL-LESS half of the original ship-small.glb. See the sail
  # entity below and KenneyVehicles/LICENSE.md for how the pair was made.
  - Entity: 879000000000021
    TagComponent:
      Tag: Boat Hull
    TransformComponent:
      # This offset is a VISUAL waterline, and it is worth more than it looks.
      # At -0.78 a good chunk of hull sat below the surface and came through the
      # refraction as a stippled brown slick trailing the boat, which reads as a
      # rendering fault rather than as a submerged hull. Raising it to -0.5 puts
      # the mesh's own waterline near the real one and the artifact goes away.
      Translation: [0, -0.5, 0]
      Rotation: [0, 0, 0]
      Scale: [0.57, 0.57, 0.57]
    ModelComponent:
      FilePath: SandboxProject/Assets/Models/KenneyVehicles/ship-small-hull.glb
      Visible: true
    RelationshipComponent:
      ParentHandle: 879000000000020
      Children:
        - 879000000000022

  # ── The sail ──────────────────────────────────────────────────────────────
  # The entity that exists so the sail can point somewhere (#899). It is a child
  # of the HULL MESH, not of the physics root, and both halves of that matter:
  #
  #   * being under the hull mesh means it inherits the 0.57 model scale and the
  #     -0.5 visual waterline, so the translation below is in the ship model's
  #     OWN coordinates and is exactly where the sail node sat inside the
  #     original single .glb. The split is invisible;
  #   * ship-small-sail.glb was re-origined onto the mast when it was extracted,
  #     so this entity's Y ROTATION IS THE YARD ANGLE. DriftBoatController copies
  #     SailComponent::yardAngle onto it every tick and the sail braces round the
  #     mast. Without the re-origin the same rotation would swing the sail around
  #     the boat instead of around its own mast.
  #
  # Rotation is authored at zero — the yard squared, which is the trim for a dead
  # run — so the first frame before any script tick looks correct.
  - Entity: 879000000000022
    TagComponent:
      Tag: Boat Sail
    TransformComponent:
      Translation: [0, 3.13852, -0.6333724]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    ModelComponent:
      FilePath: SandboxProject/Assets/Models/KenneyVehicles/ship-small-sail.glb
      Visible: true
    RelationshipComponent:
      ParentHandle: 879000000000021
      Children: []
