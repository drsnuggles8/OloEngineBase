Scene: PlayerRigFirstPerson.olo
Entities:
  - Entity: 6450000000000000001
    TagComponent:
      Tag: Sun
    TransformComponent:
      Translation: [0, 10, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    DirectionalLightComponent:
      Direction: [-0.4, -1, -0.35]
      Color: [1, 0.96, 0.9]
      Intensity: 2.5
  - Entity: 6450000000000000002
    TagComponent:
      Tag: Ground
    TransformComponent:
      Translation: [0, -0.5, 0]
      Rotation: [0, 0, 0]
      Scale: [60, 1, 60]
    MeshComponent:
      Primitive: 1
    MaterialComponent:
      AlbedoColor: [0.34, 0.36, 0.38]
      Metallic: 0
      Roughness: 0.9
    Rigidbody3DComponent:
      BodyType: 0
      Mass: 1
      LinearDrag: 0.01
      AngularDrag: 0.05
      DisableGravity: false
      IsTrigger: false
      LayerID: 0
      LockedAxes: 0
    BoxCollider3DComponent:
      HalfExtents: [30, 0.5, 30]
      Offset: [0, 0, 0]
  # ── The player ────────────────────────────────────────────────────────────
  # A capsule driven by CharacterController3DComponent, with the first-person
  # PlayerRigComponent tuning on top. m_YawBodyWithLook turns the body with the
  # look, so anything parented here (arms, a weapon) faces the same way.
  - Entity: 6450000000000000010
    TagComponent:
      Tag: Player
    TransformComponent:
      Translation: [0, 1.2, 8]
      Rotation: [0, 0, 0]
      Scale: [0.8, 1, 0.8]
    MeshComponent:
      Primitive: 4
    MaterialComponent:
      AlbedoColor: [0.85, 0.45, 0.2]
      Metallic: 0
      Roughness: 0.6
    CapsuleCollider3DComponent:
      Radius: 0.4
      HalfHeight: 0.6
      Offset: [0, 0, 0]
    CharacterController3DComponent:
      SlopeLimitDeg: 45
      StepOffset: 0.4
      JumpPower: 6
      LayerID: 0
      DisableGravity: false
      ControlMovementInAir: true
      ControlRotationInAir: false
    PlayerRigComponent:
      LookSensitivity: 0.15
      InvertLookY: false
      MinPitchDeg: -85
      MaxPitchDeg: 85
      WalkSpeed: 4.5
      SprintMultiplier: 1.8
      AirControl: 0.35
      MoveRelativeToLook: true
      YawBodyWithLook: true
      FaceMoveDirection: false
      TurnRateDeg: 720
      UseDeviceInput: true
      CaptureCursor: true
      YawDeg: 180
      PitchDeg: 0
  # ── The camera ────────────────────────────────────────────────────────────
  # BoomLength 0 IS first person: the camera sits at the pivot (the eye), pitch
  # rotates it in place, and the collision probe has nothing to shorten — which
  # is why CollisionEnabled is off here. Note this is a ROOT entity, NOT a child
  # of the player: the rig writes an absolute world pose.
  - Entity: 6450000000000000011
    TagComponent:
      Tag: Camera
    TransformComponent:
      Translation: [0, 1.9, 8]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    CameraComponent:
      Camera:
        ProjectionType: 0
        PerspectiveFOV: 1.4
        PerspectiveNear: 0.05
        PerspectiveFar: 1000
        OrthographicSize: 10
        OrthographicNear: -1
        OrthographicFar: 1
      Primary: true
      FixedAspectRatio: false
      RuntimeControl: false
      FlySpeed: 5
    CameraRigComponent:
      Target: 6450000000000000010
      PivotOffset: [0, 0.7, 0]
      BoomLength: 0
      CollisionEnabled: false
      ProbeRadius: 0.25
      MinBoomLength: 0.4
      BoomReturnSpeed: 6
      PositionSmoothTime: 0
      HeadBobAmplitude: 0.035
      HeadBobFrequency: 1.1
      FallbackPitchDeg: -12
  # ── Props ─────────────────────────────────────────────────────────────────
  # Something to walk around, step on, and jump between, so the movement feel
  # is actually judgeable rather than being a capsule on an empty plane.
  - Entity: 6450000000000000020
    TagComponent:
      Tag: Pillar_A
    TransformComponent:
      Translation: [-4, 1.5, 0]
      Rotation: [0, 0, 0]
      Scale: [1.5, 3, 1.5]
    MeshComponent:
      Primitive: 1
    MaterialComponent:
      AlbedoColor: [0.55, 0.58, 0.62]
      Metallic: 0
      Roughness: 0.7
    Rigidbody3DComponent:
      BodyType: 0
      Mass: 1
      LinearDrag: 0.01
      AngularDrag: 0.05
      DisableGravity: false
      IsTrigger: false
      LayerID: 0
      LockedAxes: 0
    BoxCollider3DComponent:
      HalfExtents: [0.75, 1.5, 0.75]
      Offset: [0, 0, 0]
  - Entity: 6450000000000000021
