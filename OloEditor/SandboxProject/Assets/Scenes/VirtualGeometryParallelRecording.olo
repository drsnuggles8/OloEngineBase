Scene: VirtualGeometryParallelRecording.olo
# ---------------------------------------------------------------------------
# VIRTUAL GEOMETRY x PARALLEL RECORDING (#1013)
#
# REQUIRES THE DEFERRED RENDERING PATH (VirtualGeometryPass self-disables on
# Forward / Forward+ — see VirtualGeometryTest.olo).
#
# Why this scene exists: VirtualGeometryPass partitions its three RecordParallel
# regions (phase-1 instance cull, G-Buffer raster, SW material resolve) with
#     itemCount = clamp(instanceCount / 32, 1, MAX_RENDER_WORKERS)
# so the regions only fork at 64+ virtual-mesh instances. VirtualGeometryTest has
# 15 and VirtualGeometryStress has 24, so before this scene every authored scene
# ran those regions inline (itemCount == 1) and no live capture exercised the
# forked path on either backend.
#
# 96 helmet instances in a 12 x 8 grid -> itemCount == 3, three secondaries.
# Mixed ErrorThresholdPixels keeps the DAG cut varied across items so the
# partition boundaries are not all identical work.
#
# Each DamagedHelmet is 15,452 source triangles sharing ONE cluster DAG (the
# registry memoizes by AssetHandle), so 96 instances stay cheap to render while
# still crossing the fork grain. A VirtualMeshComponent cannot be textured from
# a scene file, so each carries an explicit MaterialComponent instead.
# ---------------------------------------------------------------------------
PostProcessSettings:
  TonemapOperator: 0
  Exposure: 1
  Gamma: 2.2
  BloomEnabled: true
  BloomThreshold: 1.2
  BloomIntensity: 0.3
  BloomIterations: 4
  VignetteEnabled: false
  VignetteIntensity: 0.5
  VignetteSmoothness: 0.2
  ChromaticAberrationEnabled: false
  ChromaticAberrationIntensity: 0.5
  FXAAEnabled: true
  DOFEnabled: false
  DOFFocusDistance: 10
  DOFFocusRange: 5
  DOFBokehRadius: 3
  MotionBlurEnabled: false
  MotionBlurStrength: 0.5
  MotionBlurSamples: 4
  ColorGradingEnabled: false
  SSAOEnabled: true
  SSAORadius: 0.5
  SSAOBias: 0.025
  SSAOIntensity: 1
  SSAOSamples: 32
  SSAODebugView: false
Entities:
  # ── Camera: looks down the two receding rows ──
  - Entity: 800000000000001
    TagComponent:
      Tag: Camera
    TransformComponent:
      Translation: [0, 2.2, 9]
      Rotation: [-0.1, 0, 0]
      Scale: [1, 1, 1]
    CameraComponent:
      Camera:
        ProjectionType: 0
        PerspectiveFOV: 0.785398185
        PerspectiveNear: 0.1
        PerspectiveFar: 500
        OrthographicSize: 10
        OrthographicNear: -1
        OrthographicFar: 1
      Primary: true
      FixedAspectRatio: false
  # ── Skybox + IBL: the helmet is a metal/roughness PBR reference, so it needs
  #    an environment to read correctly ──
  - Entity: 800000000000002
    TagComponent:
      Tag: Skybox
    TransformComponent:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    EnvironmentMapComponent:
      FilePath: assets/textures/hdr/newport_loft.hdr
      IsCubemapFolder: false
  # ── Sun: shadow-casting, so the virtual meshes are seen to cast into the CSM ──
  - Entity: 800000000000003
    TagComponent:
      Tag: Sun
    TransformComponent:
      Translation: [0, 12, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    DirectionalLightComponent:
      Direction: [-0.35, -0.8, -0.45]
      Color: [1, 0.96, 0.88]
      Intensity: 5
      CastShadows: true
      ShadowDepthBiasTexels: 2
      ShadowNormalBias: 0.01
      MaxShadowDistance: 300
      CascadeSplitLambda: 0.92
  # ── Ground plane (classic mesh): receives the virtual meshes' shadows, and
  #    keeps the subjects off a black background ──
  - Entity: 800000000000004
    TagComponent:
      Tag: Ground Plane
    TransformComponent:
      Translation: [0, -1, -25]
      Rotation: [0, 0, 0]
      Scale: [70, 0.2, 110]
    MeshComponent:
      Primitive: 1
    MaterialComponent:
      AlbedoColor: [0.32, 0.33, 0.35]
      Metallic: 0
      Roughness: 0.9

  # ═══ 96 virtual-mesh instances — enough to fork VirtualGeometryPass ═══
  - Entity: 800000000001000
    TagComponent:
      Tag: VMesh r0 c0 thr=0.5
    TransformComponent:
      Translation: [-14.30, 0.2, 2.00]
      Rotation: [0, 0.5, 0]
      Scale: [1, 1, 1]
    VirtualMeshComponent:
      Enabled: true
      MeshSource: 4544736348022301228
      ErrorThresholdPixels: 0.5
      CastShadows: true
    MaterialComponent:
      AlbedoColor: [0.72, 0.45, 0.2]
      Metallic: 0.9
      Roughness: 0.25
  - Entity: 800000000001001
    TagComponent:
      Tag: VMesh r0 c1 thr=2.0
    TransformComponent:
      Translation: [-11.70, 0.2, 2.00]
      Rotation: [0, 0.5, 0]
      Scale: [1, 1, 1]
    VirtualMeshComponent:
      Enabled: true
      MeshSource: 4544736348022301228
      ErrorThresholdPixels: 2.0
      CastShadows: true
    MaterialComponent:
      AlbedoColor: [0.72, 0.45, 0.2]
      Metallic: 0.9
      Roughness: 0.25
  - Entity: 800000000001002
