Scene: Courtyard.olo
# ─────────────────────────────────────────────────────────────────────────────
# DENSE ARCHITECTURAL / FOLIAGE benchmark scene (issue #974).
#
# The feature-density stress axis of the benchmark trio (see
# docs/guides/renderer-benchmarks.md): every deferred-path feature enabled at
# once, in one frame, deterministically.
#
#   * Sponza atrium (opaque + alpha-masked fabric/plants) with a low sun
#     angled down the long (X) axis for long CSM shadows.
#   * 120 colored point lights in a 6x4x5 grid through the atrium
#     (SponzaForwardPlus layout), 6 shadow-casting warm points on the
#     centre-line, 16 garden points outside, 12 spots (4 shadow-casting).
#   * Realtime DDGI: LightProbeVolumeComponent (Mode 1) covering the atrium.
#   * 4 DecalComponents on the atrium floor, one per DecalMode
#     (0 Albedo / 1 Normal / 2 RMA / 3 Emissive — DecalModeMatrixTest shape).
#   * SSGI + SSR + SSAO + volumetric fog with light shafts via the scene-level
#     PostProcessSettings / FogSettings blocks below.
#   * A 192x192 procedural terrain garden east (+X) of the atrium with three
#     wind-swayed foliage layers: grass billboards (alpha-masked), pine and
#     palm meshes with octahedral impostors (Drift layout).
#   * A 48-tower InstancedMeshComponent massing ring at radius ~420-520 for
#     geometry at depth (fog integration + culling).
#
# The renderer-side switches the scene cannot serialize (Path=Deferred,
# EnableDDGI, TAA) are applied by the capture manifests under
# OloEditor/assets/benchmark/manifests/courtyard.*.yaml — open this scene by
# hand and you must set Deferred + DDGI yourself in Renderer Settings.
#
# GENERATED by OloEngine/tests/scripts/generate_courtyard_scene.py — edit the
# generator and regenerate rather than hand-editing (byte-stable output).
# ─────────────────────────────────────────────────────────────────────────────
PostProcessSettings:
  TonemapOperator: 2
  Exposure: 1
  Gamma: 2.2
  BloomEnabled: true
  BloomThreshold: 1.2
  BloomIntensity: 0.35
  BloomIterations: 5
  VignetteEnabled: false
  VignetteIntensity: 0.5
  VignetteSmoothness: 0.2
  ChromaticAberrationEnabled: false
  ChromaticAberrationIntensity: 0.5
  # FXAA off: keep the benchmark frame AA-free. TAA is neither scene-serialized
  # nor toggleable from a v1 capture manifest (RendererSettings allowlist), so
  # the temporal axis here is the SSGI/SSR temporal resolves + realtime DDGI.
  FXAAEnabled: false
  DOFEnabled: false
  DOFFocusDistance: 10
  DOFFocusRange: 5
  DOFBokehRadius: 3
  MotionBlurEnabled: false
  MotionBlurStrength: 0.5
  MotionBlurSamples: 4
  ColorGradingEnabled: false
  SSAOEnabled: true
  SSAORadius: 0.6
  SSAOBias: 0.025
  SSAOIntensity: 1
  SSAOSamples: 32
  SSAODebugView: false
  SSREnabled: true
  SSRMaxDistance: 60
  SSRThickness: 0.9
  SSRStride: 0.22
  SSRMaxSteps: 96
  SSRBinarySearchSteps: 6
  SSRIntensity: 1
  SSRMaxRoughness: 0.6
  SSREdgeFade: 0.1
  SSRDebugView: false
  SSRTemporalResolve: true
  SSGIEnabled: true
  SSGIIntensity: 1.5
  SSGIMaxDistance: 30
  SSGIThickness: 1.5
  SSGIStride: 0.5
  SSGIMaxSteps: 32
  SSGIRayCount: 16
  SSGIEdgeFade: 0.1
  SSGIDebugView: false
  SSGITemporalResolve: true
  AutoExposureEnabled: false
FogSettings:
  Enabled: true
  Mode: 1
  Color: [0.5, 0.55, 0.62]
  Density: 0.022
  Start: 0
  End: 650
  HeightFalloff: 0.35
  HeightOffset: 0
  MaxOpacity: 0.8
  EnableScattering: true
  RayleighStrength: 0.5
  MieStrength: 0.02
  MieDirectionality: 0.72
  RayleighColor: [0.27, 0.51, 0.83]
  SunIntensity: 5
  EnableVolumetric: true
  VolumetricSamples: 64
  AbsorptionCoefficient: 0.012
  EnableNoise: true
  NoiseScale: 0.05
  NoiseSpeed: 0.35
  NoiseIntensity: 0.45
  EnableLightShafts: true
  LightShaftIntensity: 1.3
WindSettings:
  Enabled: true
  Direction: [0.85, 0, 0.35]
  Speed: 9
  GustStrength: 0.5
  GustFrequency: 0.7
  TurbulenceIntensity: 0.45
  TurbulenceScale: 0.12
  GridWorldSize: 420
  GridResolution: 128
