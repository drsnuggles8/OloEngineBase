        ProjectionType: 0
        PerspectiveFOV: 0.785398185
        PerspectiveNear: 0.05
        PerspectiveFar: 300
        OrthographicSize: 10
        OrthographicNear: -1
        OrthographicFar: 1
      Primary: true
      FixedAspectRatio: false
  # -- Uniform white furnace environment (skybox visible + IBL) --
  - Entity: 974000001500002
    TagComponent:
      Tag: Furnace
    TransformComponent:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
