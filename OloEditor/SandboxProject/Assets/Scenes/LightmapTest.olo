Scene: LightmapTest.olo
# ─────────────────────────────────────────────────────────────────────────────
# Baked GI / lightmaps (issue #439) — the acceptance-criteria room: a matte
# corridor between a RED (-X) and a GREEN (+X) wall with a pillar occluder,
# lit by two white point lights. Every wall/floor/ceiling entity is marked
# LightmapStatic; the sphere is DYNAMIC (not marked) and covered by a Baked
# light-probe volume instead.
#
# To exercise the feature: Build > Bake Lightmaps, then save the scene (the
# baked .olmap handle lands in LightmapSettings below). Expected result: the
# floor beside the red wall picks up a red indirect tint, the floor beside
# the green wall a green one, and the pillar's shadowed side is no longer
# black — while the dynamic sphere keeps sampling probes. Moving any static
# entity stales the bake: the lightmap silently switches off (falls back to
# probes/IBL) and the log says why, until the next bake.
# ─────────────────────────────────────────────────────────────────────────────
LightmapSettings:
  LightmapAsset: 0
  Enabled: true
  Intensity: 1
  # Sized for a fast in-editor bake of this small room (a Debug-build editor
  # traces ~40x slower than Release); raise for production-quality bakes.
  AtlasSize: 512
  SamplesPerTexel: 64
  MaxBounces: 4
  TexelsPerMeter: 4
Entities:
  - Entity: 439000000000001
    TagComponent:
      Tag: Camera
    TransformComponent:
      Translation: [0, 1.8, 9]
      Rotation: [-0.35, 0, 0]
      Scale: [1, 1, 1]
    CameraComponent:
      Camera:
        ProjectionType: 0
        PerspectiveFOV: 1.0472
        PerspectiveNear: 0.05
        PerspectiveFar: 1000
        OrthographicSize: 10
        OrthographicNear: -1
        OrthographicFar: 1
      Primary: true
      FixedAspectRatio: false
  - Entity: 439000000000002
    TagComponent:
      Tag: Floor
    TransformComponent:
      Translation: [0, -0.25, 0]
      Rotation: [0, 0, 0]
      Scale: [7, 0.25, 25]
    MeshComponent:
      Primitive: 1
      LightmapStatic: true
    MaterialComponent:
      AlbedoColor: [0.65, 0.65, 0.65]
      Metallic: 0
      Roughness: 0.9
  - Entity: 439000000000003
    TagComponent:
      Tag: Red Wall (-X)
    TransformComponent:
      Translation: [-3.25, 2, 0]
      Rotation: [0, 0, 0]
      Scale: [0.25, 5, 25]
    MeshComponent:
