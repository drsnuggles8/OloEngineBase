Scene: GroomStrandCoat.olo
# ─────────────────────────────────────────────────────────────────────────────
# Groom strand visibility — the production path's live scene (#1246).
#
# A NEW scene rather than a change to an existing one, deliberately. Both
# neighbours are load-bearing baselines and must not move:
#   * Scenes/GroomReference.olo is #1232's import-correctness scene AND #1293's
#     Vulkan frame-arena repro; changing it would invalidate that measurement.
#   * Scenes/Benchmark/AnimalLongCoat.olo is the "long coat with no groom
#     system" baseline the benchmark fixtures are measured against, and its own
#     header says not to improve the coat there.
#
# WHAT IS IN FRAME, AND WHY EACH THING IS THERE:
#   BODY       a sphere the strands grow out of, so "depth-correct overlap
#              against the body" is something you can see rather than infer.
#   SLAB       ordinary opaque geometry crossing in front of the coat, which is
#              the other half of acceptance criterion 2. If strands render
#              THROUGH it, the strand pass is not depth-testing.
#   GROUND     a floor, so the coat has something to sit against and a silhouette
#              to read.
#   TWO GROOMS side by side, and this is the important part:
#
#     HairCoat   WidthScale 1 — the human scalp groom at its REAL 70 um.
#                This is what hair actually is, and at any framing a person
#                would use it is far thinner than a pixel (0.003-0.03 px of
#                half width; see docs/analysis/groom-strand-visibility-1246.md).
#                It renders as a coherent grey mass, not as visible individual
#                strands, and that is correct. With TAA off it renders as the
#                OpaqueRibbon fallback and most of the coat DISAPPEARS — which
#                is the measured failure the stochastic mode exists to fix, and
#                is worth toggling once to see.
#
#     BristleCoat WidthScale 25 — the same asset at a thickness a screenshot can
#                resolve. NOT a quality setting and not what hair looks like: it
#                is here so the ribbon geometry, the root-to-tip ramp and the
#                depth-correct overlap are legible by eye in a capture. Judge
#                COVERAGE from the CPU measurements, never from this entity.
#
# TAA IS ON. StochasticAlpha is refused without a temporal resolve
# (GroomCompositionFallbackReason::TemporalResolveUnavailable), so with TAA off
# this scene shows the fallback tier. The Groom inspector's "Active: <mode>"
# line says which one is running at any moment.
#
# Hair SHADING is not in this scene and is not missing by accident: #1246 is
# visibility, #1247 is fibre scattering. The coat is neutral-lit on purpose.
# ─────────────────────────────────────────────────────────────────────────────
PostProcessSettings:
  TonemapOperator: 2
  Exposure: 1
  Gamma: 2.2
  BloomEnabled: false
  BloomThreshold: 1.2
  BloomIntensity: 0.25
  BloomIterations: 5
  VignetteEnabled: false
  VignetteIntensity: 0.5
  VignetteSmoothness: 0.2
  ChromaticAberrationEnabled: false
  ChromaticAberrationIntensity: 0.5
  # FXAA off: it is a spatial edge filter, and blurring the silhouette is
  # exactly what would make a coverage judgement meaningless here.
  FXAAEnabled: false
  DOFEnabled: false
  DOFFocusDistance: 10
  DOFFocusRange: 5
  DOFBokehRadius: 3
  MotionBlurEnabled: false
  MotionBlurStrength: 0.5
  MotionBlurSamples: 4
  ColorGradingEnabled: false
  SSAOEnabled: false
  SSAORadius: 0.35
  SSAOBias: 0.025
  SSAOIntensity: 1
  SSAOSamples: 32
  SSAODebugView: false
  # ON, and load-bearing: it is what makes the selected composition mode
  # available at all. Turn it off to watch the fallback take over.
  TAAEnabled: true
  TAAFeedback: 0.9
  TAASharpness: 0.25
  Upscale: 0
  RCASSharpness: 0.5
  UpscaleTechnique: 0
  FSR2SharpeningEnabled: true
  FSR2Sharpness: 0.5
Entities:
  # ── Camera ──
  - Entity: 124600000000001
    TagComponent:
      Tag: Camera
    TransformComponent:
      Translation: [0, 0.12, 0.62]
      Rotation: [-0.08, 0, 0]
      Scale: [1, 1, 1]
    CameraComponent:
      Camera:
        ProjectionType: 0
        PerspectiveFOV: 0.7854
        PerspectiveNear: 0.02
        PerspectiveFar: 500
        OrthographicSize: 10
        OrthographicNear: -1
        OrthographicFar: 1
      Primary: true
      FixedAspectRatio: false
  # ── Key light. Neutral and bright enough to read a silhouette; the strands
  #    themselves are unlit, so this lights everything AROUND them. ──
  - Entity: 124600000000002
    TagComponent:
      Tag: Sun
    TransformComponent:
      Translation: [0, 2, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    DirectionalLightComponent:
      Direction: [-0.4, -0.65, -0.65]
      Color: [1, 0.98, 0.95]
      Intensity: 3.5
      CastShadows: true
      ShadowDepthBiasTexels: 2
      ShadowNormalBias: 0.01
      MaxShadowDistance: 20
      CascadeSplitLambda: 0.9
      CascadeDebugVisualization: false
  # ── THE BODY. Slightly under the 9 cm root radius so the roots sit proud of
  #    the surface rather than z-fighting it. ──
  - Entity: 124600000000003
    TagComponent:
      Tag: Body
    TransformComponent:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [0.088, 0.088, 0.088]
    MeshComponent:
      Primitive: 2
    MaterialComponent:
      AlbedoColor: [0.12, 0.1, 0.1]
      Metallic: 0
      Roughness: 0.85
  # ── The human scalp groom at REAL scale. ──
  - Entity: 124600000000004
    TagComponent:
      Tag: HairCoat
    TransformComponent:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    GroomComponent:
      Groom: 15952688685437936282
      RootMarkerSize: 0
      MaxPreviewStrands: 2000
      MaxRenderStrands: 200000
      WidthScale: 1
      StrandColor: [0.34, 0.24, 0.17]
      ShowPreview: false
      ShowStrands: true
      ShowRoots: true
      ShowDirection: true
      ColorByGroup: true
      GuidesOnly: false
      RenderStrands: true
      CompositionMode: 1
  # ── The same asset at a thickness a screenshot can resolve. Half a metre to
  #    the right, on its own body. ──
  - Entity: 124600000000005
    TagComponent:
      Tag: BristleBody
    TransformComponent:
      Translation: [0.36, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [0.088, 0.088, 0.088]
    MeshComponent:
      Primitive: 2
    MaterialComponent:
      AlbedoColor: [0.12, 0.1, 0.1]
      Metallic: 0
      Roughness: 0.85
  - Entity: 124600000000006
    TagComponent:
      Tag: BristleCoat
    TransformComponent:
      Translation: [0.36, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    GroomComponent:
      Groom: 15952688685437936282
      RootMarkerSize: 0
      MaxPreviewStrands: 2000
      MaxRenderStrands: 200000
      WidthScale: 25
      StrandColor: [0.62, 0.5, 0.38]
      ShowPreview: false
      ShowStrands: true
      ShowRoots: true
      ShowDirection: true
      ColorByGroup: true
      GuidesOnly: false
      RenderStrands: true
      CompositionMode: 1
  # ── ORDINARY OPAQUE GEOMETRY crossing in front of the coats. Acceptance
  #    criterion 2's other half: strands behind it must be hidden by it. ──
  - Entity: 124600000000007
    TagComponent:
      Tag: Slab
    TransformComponent:
      Translation: [0.18, -0.02, 0.16]
      Rotation: [0, 0.35, 0]
      Scale: [0.5, 0.11, 0.012]
    MeshComponent:
      Primitive: 1
    MaterialComponent:
      AlbedoColor: [0.62, 0.18, 0.15]
      Metallic: 0
      Roughness: 0.6
  # ── Ground ──
  - Entity: 124600000000008
    TagComponent:
      Tag: Ground
    TransformComponent:
      Translation: [0.18, -0.115, 0]
      Rotation: [0, 0, 0]
      Scale: [4, 0.01, 4]
    MeshComponent:
      Primitive: 1
    MaterialComponent:
      AlbedoColor: [0.3, 0.3, 0.32]
      Metallic: 0
      Roughness: 0.9
