Scene: GroomFibreCoat.olo
# ─────────────────────────────────────────────────────────────────────────────
# Groom fibre scattering — the live scene (#1247).
#
# A NEW scene rather than a change to Scenes/GroomStrandCoat.olo, deliberately:
# that one is #1246's visibility scene and its coat is neutral-lit ON PURPOSE.
# Adding a material to it would make every coverage judgement it supports a
# judgement about the lighting too, which is the exact thing its own header
# says not to do.
#
# WHAT IS IN FRAME, AND WHY:
#
#   THREE COATS, identical geometry, different PIGMENT. Left to right: a dark
#   fibre (eumelanin 4.0), a pale one (0.1 / 0.05) and a red one (0.35 / 1.4).
#   Same asset, same width, same light — so any difference between them is the
#   material and nothing else. This is acceptance criterion 3's dark / pale /
#   coloured axis, arranged so one screenshot covers it.
#
#   THE SUN POINTS INTO THE CAMERA. Direction [+0.15, -0.25, +0.85] travels
#   TOWARDS the viewer, so the coats are BACKLIT — which is where the three
#   diverge most, because backlight is carried by transmission and transmission
#   is what the pigment absorbs. Frontal and grazing are one rotation of this
#   light away, and are worth doing: the pale coat should gain on the dark one
#   as the light swings behind, and lose that lead as it swings in front.
#
#   WIDTH SCALE 25, as in #1246's BristleCoat and for the same reason: real hair
#   is far thinner than a pixel at any framing a person would use, so a coat at
#   WidthScale 1 is a coherent mass rather than legible strands. This is NOT a
#   quality setting and not what hair looks like — it is here so the lobes are
#   visible by eye. Judge the MATERIAL from the CPU measurements in
#   docs/analysis/groom-fibre-scattering-1247.md, never from this entity.
#
#   A DARK BODY AND A DARK GROUND, so the frame is measuring the coats.
#
# THE DIAGNOSTIC VIEWS are the point of the Groom Fibre Material inspector's
# "Show" dropdown: Full, R, TT, TRT, Residual, Tangent frame. Under this
# backlight the pale coat's TT should dominate and the dark coat's should be
# nearly black, while their R lobes should look the same — R never enters the
# fibre, so no amount of pigment can change it.
#
# TAA IS ON, because the composition tier underneath still refuses
# StochasticAlpha without a temporal resolve (#1246). The material is
# independent of that choice; the coat's COVERAGE is not.
# ─────────────────────────────────────────────────────────────────────────────
PostProcessSettings:
  TonemapOperator: 2
  Exposure: 1
  Gamma: 2.2
  BloomEnabled: false
  BloomThreshold: 1.2
  BloomIntensity: 0.25
  BloomIterations: 5
  VignetteEnabled: false
  VignetteIntensity: 0.5
  VignetteSmoothness: 0.2
  ChromaticAberrationEnabled: false
  ChromaticAberrationIntensity: 0.5
  # FXAA off: a spatial edge filter over sub-pixel strands blurs the very
  # thing being looked at.
  FXAAEnabled: false
  DOFEnabled: false
  DOFFocusDistance: 10
  DOFFocusRange: 5
  DOFBokehRadius: 3
  MotionBlurEnabled: false
  MotionBlurStrength: 0.5
  MotionBlurSamples: 4
  ColorGradingEnabled: false
  SSAOEnabled: false
  SSAORadius: 0.35
  SSAOBias: 0.025
  SSAOIntensity: 1
  SSAOSamples: 32
  SSAODebugView: false
  TAAEnabled: true
  TAAFeedback: 0.9
  TAASharpness: 0.25
  Upscale: 0
  RCASSharpness: 0.5
  UpscaleTechnique: 0
  FSR2SharpeningEnabled: true
  FSR2Sharpness: 0.5
Entities:
  # ── Camera ──
  - Entity: 124700000000001
    TagComponent:
      Tag: Camera
    TransformComponent:
      Translation: [0.36, 0.12, 0.85]
      Rotation: [-0.06, 0, 0]
      Scale: [1, 1, 1]
    CameraComponent:
      Camera:
        ProjectionType: 0
        PerspectiveFOV: 0.7854
        PerspectiveNear: 0.02
        PerspectiveFar: 500
        OrthographicSize: 10
        OrthographicNear: -1
        OrthographicFar: 1
      Primary: true
      FixedAspectRatio: false
  # ── THE KEY LIGHT, pointing INTO the camera: the coats are backlit, which is
  #    where the three pigments diverge most. Swing it to [-0.15, -0.25, -0.85]
  #    for the frontal case and [-0.9, -0.15, 0] for grazing. ──
  - Entity: 124700000000002
    TagComponent:
      Tag: Sun
    TransformComponent:
      Translation: [0, 2, -2]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    DirectionalLightComponent:
      Direction: [0.15, -0.25, 0.85]
      Color: [1, 0.98, 0.95]
      Intensity: 4
      CastShadows: true
      ShadowDepthBiasTexels: 2
      ShadowNormalBias: 0.01
      MaxShadowDistance: 20
      CascadeSplitLambda: 0.9
      CascadeDebugVisualization: false
  # ── DARK: eumelanin 4.0, no pheomelanin. Nearly black hair. Its TT lobe is
  #    absorbed away, so backlit it is carried by the same white surface sheen
  #    it has from the front. ──
  - Entity: 124700000000003
    TagComponent:
      Tag: DarkBody
    TransformComponent:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [0.088, 0.088, 0.088]
    MeshComponent:
      Primitive: 2
    MaterialComponent:
      AlbedoColor: [0.08, 0.07, 0.07]
      Metallic: 0
      Roughness: 0.85
  - Entity: 124700000000004
    TagComponent:
      Tag: DarkCoat
    TransformComponent:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    GroomComponent:
      Groom: 15952688685437936282
      RootMarkerSize: 0
      MaxPreviewStrands: 2000
      MaxRenderStrands: 200000
      WidthScale: 25
      StrandColor: [0.34, 0.24, 0.17]
      ShowPreview: false
      ShowStrands: true
      ShowRoots: true
      ShowDirection: true
      ColorByGroup: true
      GuidesOnly: false
      RenderStrands: true
      CompositionMode: 1
    GroomFibreComponent:
      BaseColor: [0.42, 0.26, 0.14]
      Absorption: [0.84, 1.39, 2.74]
      Eumelanin: 4
      Pheomelanin: 0
      LongitudinalRoughness: 0.3
      AzimuthalRoughness: 0.3
      TiltDegrees: 2
      IndexOfRefraction: 1.55
      Intensity: 6
      HSamples: 4
      PigmentMode: 0
      DebugMode: 0
      Enabled: true
  # ── PALE: eumelanin 0.1, pheomelanin 0.05. Blonde. Backlit this one should
  #    glow: its transmission lobe reaches the eye at roughly 180x its surface
  #    reflection, which is the measured difference from the dark coat. ──
  - Entity: 124700000000005
    TagComponent:
      Tag: PaleBody
    TransformComponent:
      Translation: [0.36, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [0.088, 0.088, 0.088]
    MeshComponent:
      Primitive: 2
    MaterialComponent:
      AlbedoColor: [0.08, 0.07, 0.07]
      Metallic: 0
      Roughness: 0.85
  - Entity: 124700000000006
    TagComponent:
      Tag: PaleCoat
    TransformComponent:
      Translation: [0.36, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    GroomComponent:
      Groom: 15952688685437936282
      RootMarkerSize: 0
      MaxPreviewStrands: 2000
      MaxRenderStrands: 200000
      WidthScale: 25
      StrandColor: [0.62, 0.5, 0.38]
      ShowPreview: false
      ShowStrands: true
      ShowRoots: true
      ShowDirection: true
      ColorByGroup: true
      GuidesOnly: false
      RenderStrands: true
      CompositionMode: 1
    GroomFibreComponent:
      BaseColor: [0.42, 0.26, 0.14]
      Absorption: [0.84, 1.39, 2.74]
      Eumelanin: 0.1
      Pheomelanin: 0.05
      LongitudinalRoughness: 0.3
      AzimuthalRoughness: 0.3
      TiltDegrees: 2
      IndexOfRefraction: 1.55
      Intensity: 6
      HSamples: 4
      PigmentMode: 0
      DebugMode: 0
      Enabled: true
  # ── RED: eumelanin 0.35, pheomelanin 1.4. Pheomelanin is flatter and weaker
  #    than eumelanin, so this stays saturated at a concentration that would
  #    make a eumelanin fibre nearly black. ──
  - Entity: 124700000000007
    TagComponent:
      Tag: RedBody
    TransformComponent:
      Translation: [0.72, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [0.088, 0.088, 0.088]
    MeshComponent:
      Primitive: 2
    MaterialComponent:
      AlbedoColor: [0.08, 0.07, 0.07]
      Metallic: 0
      Roughness: 0.85
  - Entity: 124700000000008
    TagComponent:
      Tag: RedCoat
    TransformComponent:
      Translation: [0.72, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    GroomComponent:
      Groom: 15952688685437936282
      RootMarkerSize: 0
      MaxPreviewStrands: 2000
      MaxRenderStrands: 200000
      WidthScale: 25
      StrandColor: [0.55, 0.3, 0.2]
      ShowPreview: false
      ShowStrands: true
      ShowRoots: true
      ShowDirection: true
      ColorByGroup: true
      GuidesOnly: false
      RenderStrands: true
      CompositionMode: 1
    GroomFibreComponent:
      BaseColor: [0.42, 0.26, 0.14]
      Absorption: [0.84, 1.39, 2.74]
      Eumelanin: 0.35
      Pheomelanin: 1.4
      LongitudinalRoughness: 0.3
      AzimuthalRoughness: 0.3
      TiltDegrees: 2
      IndexOfRefraction: 1.55
      Intensity: 6
      HSamples: 4
      PigmentMode: 0
      DebugMode: 0
      Enabled: true
  # ── Ground. Dark, because the coats are what the frame is measuring. ──
  - Entity: 124700000000009
    TagComponent:
      Tag: Ground
    TransformComponent:
      Translation: [0.36, -0.115, 0]
      Rotation: [0, 0, 0]
      Scale: [4, 0.01, 4]
    MeshComponent:
      Primitive: 1
    MaterialComponent:
      AlbedoColor: [0.12, 0.12, 0.13]
      Metallic: 0
      Roughness: 0.9
