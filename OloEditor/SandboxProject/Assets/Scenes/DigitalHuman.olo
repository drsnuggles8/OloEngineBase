Scene: DigitalHuman.olo
# -----------------------------------------------------------------------------
# DIGITAL HUMAN fixture (issue #1222).
#
# One real human head under a three-rig studio setup. That is the whole scene,
# and the restraint is deliberate.
#
# THE SUBJECT: assets/models/InfiniteScanHead/Head.fbx, a photogrammetry scan
# by Lee Perry-Smith, CC BY 3.0 — an ATTRIBUTION licence, unlike the CC0 models
# around it, so the credit chain in that directory's README.md has to travel
# with the file. It is the head the subsurface-scattering literature uses, and
# it is here because this repository had no human head at all: Suzanne is a
# chimpanzee and Khronos glTF-Sample-Assets, the source of every other model
# here, has no face.
#
# It carries ReferenceHead.oloskin, so it is the subject for the SKIN children
# — #1241 diffusion, #1242 transmission, #1243 layered specular.
#
# WHAT THIS SCENE DELIBERATELY DOES NOT CONTAIN, and why. The epic's first
# acceptance criterion asks for skin, eyes and mouth "integrated on an animated
# reference subject". No asset in this repository has separate eye or oral
# geometry — this scan has closed eyelids and its own lips — so an earlier
# revision of this scene ASSEMBLED one: primitive globes, lips, gums, teeth and
# a tongue positioned by hand against the head.
#
# That was a mistake and it is recorded here so nobody repeats it. The parts
# were authored against a 0.2 m sphere, so swapping in a real head left
# eyeballs on the forehead; re-placing them produced a face with spheres stuck
# to it, then a row of debris floating beside the head, and finally the parts
# hidden INSIDE the cranium purely so the scene would still spend all seven
# skin-profile slots. Hiding a thing to preserve the number it justifies is not
# evidence of anything.
#
# So criterion 1 is reported as UNMET and blocked on an asset (#1402) rather
# than satisfied by a subject we built ourselves. #1244's Eyes.olo and #1245's
# OralSurfaces.olo remain where that geometry is judged, and the SLOT BUDGET
# finding (#1393) is asserted where it can be asserted — in
# SkinDigitalHumanEvidenceTest, on a controlled multi-profile probe.
#
# WHY A NEW SCENE AND NOT AN EDIT TO ReferenceHead.olo. That fixture is a
# PINNED BENCHMARK whose captures are golden and whose manifest is asserted
# (ReferenceFixtureManifestTest); adding geometry to it would invalidate every
# number measured against it. Eyes.olo and OralSurfaces.olo each made the same
# call and stayed additive.
#
# PLACING ANYTHING AGAINST THE FACE, if that is ever needed: the scan is
# authored ~1.4 units tall for the whole BUST with its origin at the BASE OF
# THE NECK, not the head's centre, so this scene scales it 0.38 and drops it
# 0.285 to put the head on the origin.
#
# WHAT THIS SCENE IS FOR: the LIVE half of the epic's verification grid. The
# material debug views are deferred-only and reachable here through the MCP
# renderer tools, which is how the Vulkan rows get captured at all — the
# headless fixtures need a real GL 4.6 context and skip without one.
#
# THE THREE RIGS ARE ALL PRESENT AND ONLY ONE IS STRONG. Criterion 2 asks for
# soft, hard side and backlight, and a scene can only be authored in one of
# them — so all three lights exist and the other two are dimmed rather than
# deleted. Switching rig is an INTENSITY edit on lights that are already
# placed, which keeps geometry, exposure and shadow settings fixed.
#
# NOTE ON THE BACKLIGHT CELL: ReferenceHead.oloskin is still at transport
# version 1 (diffusion only), so #1242's transmission is not enabled on this
# head and the transmission debug view is black over it. Tracked as #1394.
# -----------------------------------------------------------------------------
PostProcessSettings:
  TonemapOperator: 2
  Exposure: 1
  Gamma: 2.2
  BloomEnabled: true
  # Low threshold, modest intensity — same reasoning as Eyes.olo: the corneal
  # catchlight is the brightest thing here by a wide margin, and a little bloom
  # is what makes it read as wet rather than as a white dot.
  BloomThreshold: 1.1
  BloomIntensity: 0.18
  BloomIterations: 5
  VignetteEnabled: false
  # FXAA OFF, like every measurement fixture in this project: a pixel A/B
  # against an anti-aliased frame measures the filter as much as the feature.
  FXAAEnabled: false
  SSAOEnabled: true
  SSAORadius: 0.2
  SSAOBias: 0.025
  SSAOIntensity: 1
  SSAOSamples: 32
  # SSR OFF. A wet coat and a cornea are the two most reflective things in the
  # scene, and a screen-space reflection on top of them would make "is that the
  # coat or the SSR?" unanswerable from a capture.
  SSREnabled: false
  SSGIEnabled: false
  AutoExposureEnabled: false
FogSettings:
  Enabled: false
WindSettings:
  Enabled: false
Entities:
  # -- Camera: a three-quarter head-and-shoulders, not a dead-on portrait. A
  #    head-on view is the one pose where the corneal refraction and a painted
  #    iris coincide by symmetry, and where a grazing-angle specular is
  #    smallest. Both features are judged off-axis. --
  - Entity: 1222000001000001
    TagComponent:
      Tag: Camera
    TransformComponent:
      Translation: [0.17, 0.03, 0.30]
      Rotation: [-0.05, 0.52, 0]
      Scale: [1, 1, 1]
    CameraComponent:
      Camera:
        ProjectionType: 0
        PerspectiveFOV: 0.7854
        PerspectiveNear: 0.01
        PerspectiveFar: 100
        OrthographicSize: 10
        OrthographicNear: -1
        OrthographicFar: 1
      Primary: true
      FixedAspectRatio: false
  # -- SOFT KEY (the authored rig). Broad, front-above, shadows ON so the
  #    terminator across the cheek is real. This is the rig the scene opens in.
  #    To switch rigs: raise one of the two below and drop this one. --
  - Entity: 1222000001000002
    TagComponent:
      Tag: Soft Key
    TransformComponent:
      Translation: [0.22, 0.30, 0.42]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    PointLightComponent:
      Color: [1, 0.97, 0.93]
      Intensity: 6
      Range: 3
      CastShadows: true
  # -- HARD SIDE (dimmed). Almost in the head's own plane, which is where the
  #    layered specular of #1243 and the pore band are legible. Raise to ~9 and
  #    drop the soft key to ~0.5 for the hard-side cell. --
  - Entity: 1222000001000003
    TagComponent:
      Tag: Hard Side
    TransformComponent:
      Translation: [-0.46, 0.04, 0.06]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    PointLightComponent:
      Color: [1, 0.96, 0.90]
      Intensity: 0.6
      Range: 3
      CastShadows: true
  # -- BACKLIGHT (dimmed). Behind and slightly above, pointing back at the lens.
  #    Raise to ~11 and drop the other two to ~0.3 for the backlight cell: this
  #    is the only rig under which #1242's transmission through the ears is what
  #    the picture is made of. --
  - Entity: 1222000001000004
    TagComponent:
      Tag: Backlight
    TransformComponent:
      Translation: [0.05, 0.16, -0.40]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    PointLightComponent:
      Color: [0.94, 0.95, 1]
      Intensity: 0.8
      Range: 3
      CastShadows: false
  # ---------------------------------------------------------------------------
  # THE CRANIUM — #1241 diffusion, #1242 transmission, #1243 layered specular,
  # all from ReferenceHead.oloskin. The same profile handle ReferenceHead.olo
  # and Eyes.olo name, deliberately: the epic's claim is that these features
  # compose, and re-authoring the skin for this scene would have tested a
  # different material than the one the other two fixtures measure.
  # ---------------------------------------------------------------------------
  - Entity: 1222000001000010
    TagComponent:
      Tag: Cranium
    TransformComponent:
      Translation: [0, -0.285, 0]
      Rotation: [0, 0, 0]
      Scale: [0.38, 0.38, 0.38]
    ModelComponent:
      FilePath: assets/models/InfiniteScanHead/Head.fbx
      Visible: true
    MaterialComponent:
      AlbedoColor: [0.66, 0.49, 0.42]
      Metallic: 0
      Roughness: 0.42
      MaterialKind: 2
      SkinProfile: 15952688685437936278
      # 6 mm: a cheek. Not the ears' thickness — a uniform head-wide value would
      # make the ears stop being the thin region and the backlight cell stop
      # showing anything the rest of the head does not.
      ThicknessFactor: 0.006
  - Entity: 1222000001000040
    TagComponent:
      Tag: Backdrop
    TransformComponent:
      Translation: [0, 0, -0.55]
      Rotation: [0, 0, 0]
      Scale: [2, 2, 0.02]
    MeshComponent:
      Primitive: 1
    MaterialComponent:
      AlbedoColor: [0.14, 0.14, 0.15]
      Metallic: 0
      Roughness: 0.85
