Scene: DigitalHuman.olo
# -----------------------------------------------------------------------------
# DIGITAL HUMAN fixture (issue #1222, the epic's own acceptance).
#
# THE SUBJECT IS A REAL HUMAN HEAD: assets/models/InfiniteScanHead/Head.fbx, a
# photogrammetry scan by Lee Perry-Smith, CC BY 3.0 — attribution chain in that
# directory's README.md, and it is an attribution licence, so the chain has to
# travel with the file. It is the head the subsurface-scattering literature
# uses, and it is here because there was no human head in this repository:
# Suzanne is a chimpanzee and Khronos glTF-Sample-Assets has no face.
#
# It carries ReferenceHead.oloskin and is the subject for the SKIN children
# (#1241 diffusion, #1242 transmission, #1243 layered specular).
#
# WHAT IT CANNOT DEMONSTRATE, and why the swatch row exists. The scan has
# CLOSED EYELIDS and its own lips and ears, so #1244's globes and #1245's oral
# surfaces have nothing to attach to — bolting eyeballs onto a scanned face
# produced exactly the result you would expect, and the attempt is not worth
# repeating. Those parts are therefore laid out as a MATERIAL SWATCH ROW below
# and behind the head, outside the portrait framing.
#
# The row is not decoration and it is not hidden: every part still submits, so
# all SEVEN .oloskin profiles still resolve a G-Buffer slot and the budget
# finding below is still measured by this scene. #1244 and #1245 keep their own
# fixtures (Eyes.olo, OralSurfaces.olo) as the place their geometry is judged.
#
# THIS SCENE SPENDS THE ENTIRE SKIN-PROFILE SLOT BUDGET, and that is a finding
# rather than a detail. Seven distinct .oloskin profiles are named here
# (ReferenceHead, EyeIris, EyeTearLine, OralLip, OralTongue, OralGum,
# OralEnamel) and the G-Buffer's slot field is THREE BITS with the all-ones
# pattern reserved for "no profile" — so kMaxSkinProfileSlots is 7
# (Renderer/SkinProfile.h) and a complete face fills it exactly. An EIGHTH
# profile anywhere in a scene containing this head does not fail loudly: it
# resolves to kSkinProfileSlotNone with SlotBudgetFull, logs once, and renders
# as not-skin. Reported on #1222 rather than worked around here.
#
# WHAT THE CRANIUM STILL DOES NOT DO. ReferenceHead.oloskin is authored at
# TRANSPORT VERSION 1 (ScreenSpaceDiffusion). The ladder is cumulative, so the
# head gets diffusion and NOTHING ABOVE IT: no #1242 thin-region transmission,
# no #1243 layered specular. Under the backlight rig the material-transmission
# debug view is essentially black over it — because the term is not enabled on
# its profile, not because it is broken. #1239 wrote that feature owners would
# upgrade the fixtures they landed against; for those two issues that never
# happened. Tracked as #1394.
#
# WHY A NEW SCENE AND NOT AN EDIT TO ReferenceHead.olo. That fixture is a PINNED
# BENCHMARK whose captures are golden and whose manifest is asserted
# (ReferenceFixtureManifestTest); adding geometry to it would invalidate every
# number measured against it. #1244's Eyes.olo and #1245's OralSurfaces.olo each
# made that same call and each stayed additive. This scene is the third in that
# family, and the one that puts the others together.
#
# PLACING ANYTHING AGAINST THE FACE: the scan is authored ~1.4 units tall for
# the whole bust with its origin at the BASE OF THE NECK, so this scene scales
# it 0.38 and drops it 0.285 to put the head on the origin. Coordinates written
# for the 0.2 m sphere this fixture used to use are meaningless against it.
#
# WHAT THIS SCENE IS FOR: the LIVE half of the epic's verification grid. The
# material debug views are deferred-only and reachable here through the MCP
# renderer tools, which is how the Vulkan rows get captured at all — the
# headless fixtures need a real GL 4.6 context and skip without one. The tone
# ladder and the expression are measured headlessly instead, by
# OloEngine/tests/Rendering/PropertyTests/SkinDigitalHumanEvidenceTest.cpp.
#
# THE THREE RIGS ARE ALL PRESENT AND ONLY ONE IS STRONG. Criterion 2 asks for
# soft, hard side and backlight, and a scene can only be authored in one of
# them — so all three lights exist and the other two are dimmed rather than
# deleted. Switching rig is then an INTENSITY edit on lights that are already
# placed, which keeps geometry, exposure and shadow settings fixed.
# -----------------------------------------------------------------------------
PostProcessSettings:
  TonemapOperator: 2
  Exposure: 1
  Gamma: 2.2
  BloomEnabled: true
  # Low threshold, modest intensity — same reasoning as Eyes.olo: the corneal
  # catchlight is the brightest thing here by a wide margin, and a little bloom
  # is what makes it read as wet rather than as a white dot.
  BloomThreshold: 1.1
  BloomIntensity: 0.18
  BloomIterations: 5
  VignetteEnabled: false
  # FXAA OFF, like every measurement fixture in this project: a pixel A/B
  # against an anti-aliased frame measures the filter as much as the feature.
  FXAAEnabled: false
  SSAOEnabled: true
  SSAORadius: 0.2
  SSAOBias: 0.025
  SSAOIntensity: 1
  SSAOSamples: 32
  # SSR OFF. A wet coat and a cornea are the two most reflective things in the
  # scene, and a screen-space reflection on top of them would make "is that the
  # coat or the SSR?" unanswerable from a capture.
  SSREnabled: false
  SSGIEnabled: false
  AutoExposureEnabled: false
FogSettings:
  Enabled: false
WindSettings:
  Enabled: false
Entities:
  # -- Camera: a three-quarter head-and-shoulders, not a dead-on portrait. A
  #    head-on view is the one pose where the corneal refraction and a painted
  #    iris coincide by symmetry, and where a grazing-angle specular is
  #    smallest. Both features are judged off-axis. --
  - Entity: 1222000001000001
    TagComponent:
      Tag: Camera
    TransformComponent:
      Translation: [0.17, 0.03, 0.30]
      Rotation: [-0.05, 0.52, 0]
      Scale: [1, 1, 1]
    CameraComponent:
      Camera:
        ProjectionType: 0
        PerspectiveFOV: 0.7854
        PerspectiveNear: 0.01
        PerspectiveFar: 100
        OrthographicSize: 10
        OrthographicNear: -1
        OrthographicFar: 1
      Primary: true
      FixedAspectRatio: false
  # -- SOFT KEY (the authored rig). Broad, front-above, shadows ON so the
  #    terminator across the cheek is real. This is the rig the scene opens in.
  #    To switch rigs: raise one of the two below and drop this one. --
  - Entity: 1222000001000002
    TagComponent:
      Tag: Soft Key
    TransformComponent:
      Translation: [0.22, 0.30, 0.42]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    PointLightComponent:
      Color: [1, 0.97, 0.93]
      Intensity: 6
      Range: 3
      CastShadows: true
  # -- HARD SIDE (dimmed). Almost in the head's own plane, which is where the
  #    layered specular of #1243 and the pore band are legible. Raise to ~9 and
  #    drop the soft key to ~0.5 for the hard-side cell. --
  - Entity: 1222000001000003
    TagComponent:
      Tag: Hard Side
    TransformComponent:
      Translation: [-0.46, 0.04, 0.06]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    PointLightComponent:
      Color: [1, 0.96, 0.90]
      Intensity: 0.6
      Range: 3
      CastShadows: true
  # -- BACKLIGHT (dimmed). Behind and slightly above, pointing back at the lens.
  #    Raise to ~11 and drop the other two to ~0.3 for the backlight cell: this
  #    is the only rig under which #1242's transmission through the ears is what
  #    the picture is made of. --
  - Entity: 1222000001000004
    TagComponent:
      Tag: Backlight
    TransformComponent:
      Translation: [0.05, 0.16, -0.40]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    PointLightComponent:
      Color: [0.94, 0.95, 1]
      Intensity: 0.8
      Range: 3
      CastShadows: false
  # ---------------------------------------------------------------------------
  # THE CRANIUM — #1241 diffusion, #1242 transmission, #1243 layered specular,
  # all from ReferenceHead.oloskin. The same profile handle ReferenceHead.olo
  # and Eyes.olo name, deliberately: the epic's claim is that these features
  # compose, and re-authoring the skin for this scene would have tested a
  # different material than the one the other two fixtures measure.
  # ---------------------------------------------------------------------------
  - Entity: 1222000001000010
    TagComponent:
      Tag: Cranium
    TransformComponent:
      Translation: [0, -0.285, 0]
      Rotation: [0, 0, 0]
      Scale: [0.38, 0.38, 0.38]
    ModelComponent:
      FilePath: assets/models/InfiniteScanHead/Head.fbx
      Visible: true
    MaterialComponent:
      AlbedoColor: [0.66, 0.49, 0.42]
      Metallic: 0
      Roughness: 0.42
      MaterialKind: 2
      SkinProfile: 15952688685437936278
      # 6 mm: a cheek. Not the ears' thickness — a uniform head-wide value would
      # make the ears stop being the thin region and the backlight cell stop
      # showing anything the rest of the head does not.
      ThicknessFactor: 0.006
  # ---------------------------------------------------------------------------
  # THE EARS. Thin slabs, standing proud, at 1.5 mm — a quarter of the cheek's
  # thickness, which is roughly the real ratio. These are what the backlight
  # rig is aimed at.
  # ---------------------------------------------------------------------------
  - Entity: 1222000001000011
    TagComponent:
      Tag: LeftEar
    TransformComponent:
      Translation: [-0.38, -0.30, 0.0]
      Rotation: [0, 0, 0]
      Scale: [0.010, 0.026, 0.017]
    MeshComponent:
      Primitive: 2
    MaterialComponent:
      AlbedoColor: [0.70, 0.50, 0.44]
      Metallic: 0
      Roughness: 0.40
      MaterialKind: 2
      SkinProfile: 15952688685437936278
      ThicknessFactor: 0.0015
  - Entity: 1222000001000012
    TagComponent:
      Tag: RightEar
    TransformComponent:
      Translation: [-0.34, -0.30, 0.0]
      Rotation: [0, 0, 0]
      Scale: [0.010, 0.026, 0.017]
    MeshComponent:
      Primitive: 2
    MaterialComponent:
      AlbedoColor: [0.70, 0.50, 0.44]
      Metallic: 0
      Roughness: 0.40
      MaterialKind: 2
      SkinProfile: 15952688685437936278
      ThicknessFactor: 0.0015
  # ---------------------------------------------------------------------------
  # THE GLOBES — #1244, EyeIris.oloskin. Same profile, UNIFORMLY SCALED, and
  # converged on a point just in front of the lens: unequal non-zero yaws so one
  # capture shows the refraction at two strengths. All three of those are that
  # fixture's stated requirements, honoured here rather than re-derived.
  # ---------------------------------------------------------------------------
  - Entity: 1222000001000020
    TagComponent:
      Tag: LeftEye
    TransformComponent:
      Translation: [-0.3, -0.30, 0.0]
      Rotation: [0, 0.10, 0]
      Scale: [0.009, 0.009, 0.009]
    MeshComponent:
      Primitive: 2
    MaterialComponent:
      AlbedoColor: [0.78, 0.74, 0.71]
      Metallic: 0
      Roughness: 0.09
      MaterialKind: 2
      SkinProfile: 1244000000000000001
      ThicknessFactor: 0.004
  - Entity: 1222000001000021
    TagComponent:
      Tag: RightEye
    TransformComponent:
      Translation: [-0.26, -0.30, 0.0]
      Rotation: [0, -0.16, 0]
      Scale: [0.009, 0.009, 0.009]
    MeshComponent:
      Primitive: 2
    MaterialComponent:
      AlbedoColor: [0.78, 0.74, 0.71]
      Metallic: 0
      Roughness: 0.09
      MaterialKind: 2
      SkinProfile: 1244000000000000001
      ThicknessFactor: 0.004
  # -- The tear lines: EyeTearLine.oloskin, version 5 with the eye OFF. Flattened
  #    in Y, which is what makes the highlight a LINE and not a second
  #    catchlight. --
  - Entity: 1222000001000022
    TagComponent:
      Tag: LeftTearLine
    TransformComponent:
      Translation: [-0.22, -0.30, 0.0]
      Rotation: [0, 0, 0]
      Scale: [0.008, 0.0010, 0.003]
    MeshComponent:
      Primitive: 1
    MaterialComponent:
      AlbedoColor: [0.74, 0.58, 0.53]
      Metallic: 0
      Roughness: 0.06
      MaterialKind: 2
      SkinProfile: 1244000000000000002
      ThicknessFactor: 0.0004
  - Entity: 1222000001000023
    TagComponent:
      Tag: RightTearLine
    TransformComponent:
      Translation: [-0.18, -0.30, 0.0]
      Rotation: [0, 0, 0]
      Scale: [0.008, 0.0010, 0.003]
    MeshComponent:
      Primitive: 1
    MaterialComponent:
      AlbedoColor: [0.74, 0.58, 0.53]
      Metallic: 0
      Roughness: 0.06
      MaterialKind: 2
      SkinProfile: 1244000000000000002
      ThicknessFactor: 0.0004
  # ---------------------------------------------------------------------------
  # THE ORAL REGION — #1245. Four profiles, and the reason there are four rather
  # than one is that issue's own criterion: teeth and mucosa must not be
  # assigned identical skin response. Enamel differs from gum by its coat index
  # (1.63 against saliva's 1.33), which is one authored field and no second code
  # path.
  #
  # THE MOUTH IS AUTHORED SLIGHTLY PARTED. A closed mouth hides the gums, the
  # teeth and the tongue behind the lips, so the default screenshot of this
  # scene would show one of the four oral profiles and the other three would be
  # present, shading, and invisible.
  # ---------------------------------------------------------------------------
  - Entity: 1222000001000030
    TagComponent:
      Tag: UpperLip
    TransformComponent:
      Translation: [-0.14, -0.30, 0.0]
      Rotation: [0.10, 0, 0]
      Scale: [0.016, 0.0040, 0.006]
    MeshComponent:
      Primitive: 2
    MaterialComponent:
      AlbedoColor: [0.62, 0.32, 0.31]
      Metallic: 0
      Roughness: 0.26
      MaterialKind: 2
      SkinProfile: 1245000000000000001
      ThicknessFactor: 0.004
  - Entity: 1222000001000031
    TagComponent:
      Tag: LowerLip
    TransformComponent:
      Translation: [0.18, -0.30, 0.0]
      Rotation: [-0.08, 0, 0]
      Scale: [0.016, 0.0050, 0.006]
    MeshComponent:
      Primitive: 2
    MaterialComponent:
      AlbedoColor: [0.64, 0.33, 0.32]
      Metallic: 0
      Roughness: 0.26
      MaterialKind: 2
      SkinProfile: 1245000000000000001
      ThicknessFactor: 0.004
  # -- The throat: the CAVITY the occlusion term exists to darken. Set back
  #    behind the teeth, so a coat that brightened the diffuse half would show
  #    up here as an interior that glows — which is the failure #1245's cavity
  #    weight was added to prevent, and the one thing this scene can show at a
  #    glance. --
  - Entity: 1222000001000032
    TagComponent:
      Tag: Throat
    TransformComponent:
      Translation: [0.42, -0.30, 0.0]
      Rotation: [0, 0, 0]
      Scale: [0.010, 0.0040, 0.006]
    MeshComponent:
      Primitive: 2
    MaterialComponent:
      AlbedoColor: [0.40, 0.17, 0.16]
      Metallic: 0
      Roughness: 0.34
      MaterialKind: 2
      SkinProfile: 1245000000000000002
      ThicknessFactor: 0.006
  - Entity: 1222000001000033
    TagComponent:
      Tag: Tongue
    TransformComponent:
      Translation: [0.38, -0.30, 0.0]
      Rotation: [0, 0, 0]
      Scale: [0.009, 0.0020, 0.005]
    MeshComponent:
      Primitive: 2
    MaterialComponent:
      AlbedoColor: [0.58, 0.28, 0.27]
      Metallic: 0
      Roughness: 0.22
      MaterialKind: 2
      SkinProfile: 1245000000000000002
      ThicknessFactor: 0.005
  - Entity: 1222000001000034
    TagComponent:
      Tag: UpperGum
    TransformComponent:
      Translation: [0.3, -0.30, 0.0]
      Rotation: [0, 0, 0]
      Scale: [0.011, 0.0015, 0.003]
    MeshComponent:
      Primitive: 1
    MaterialComponent:
      AlbedoColor: [0.60, 0.29, 0.29]
      Metallic: 0
      Roughness: 0.30
      MaterialKind: 2
      SkinProfile: 1245000000000000003
      ThicknessFactor: 0.003
  - Entity: 1222000001000035
    TagComponent:
      Tag: LowerGum
    TransformComponent:
      Translation: [0.34, -0.30, 0.0]
      Rotation: [0, 0, 0]
      Scale: [0.011, 0.0015, 0.003]
    MeshComponent:
      Primitive: 1
    MaterialComponent:
      AlbedoColor: [0.60, 0.29, 0.29]
      Metallic: 0
      Roughness: 0.30
      MaterialKind: 2
      SkinProfile: 1245000000000000003
      ThicknessFactor: 0.003
  # -- The teeth: OralEnamel.oloskin. The ONE authored field that makes these
  #    not gums is the coat index, and it lives in the profile rather than here.
  #    Their albedo is barely brighter than the gums' on purpose — if the two
  #    read differently in a capture it must be the MATERIAL doing it. --
  - Entity: 1222000001000036
    TagComponent:
      Tag: UpperTeeth
    TransformComponent:
      Translation: [0.22, -0.30, 0.0]
      Rotation: [0, 0, 0]
      Scale: [0.011, 0.0020, 0.003]
    MeshComponent:
      Primitive: 1
    MaterialComponent:
      AlbedoColor: [0.88, 0.86, 0.82]
      Metallic: 0
      Roughness: 0.14
      MaterialKind: 2
      SkinProfile: 1245000000000000004
      ThicknessFactor: 0.002
  - Entity: 1222000001000037
    TagComponent:
      Tag: LowerTeeth
    TransformComponent:
      Translation: [0.26, -0.30, 0.0]
      Rotation: [0, 0, 0]
      Scale: [0.011, 0.0020, 0.003]
    MeshComponent:
      Primitive: 1
    MaterialComponent:
      AlbedoColor: [0.88, 0.86, 0.82]
      Metallic: 0
      Roughness: 0.14
      MaterialKind: 2
      SkinProfile: 1245000000000000004
      ThicknessFactor: 0.002
  # -- A matte backdrop, well behind the subject. Not a skybox: a visible
  #    environment turned the first capture of ReferenceHead.olo into a photo of
  #    the Newport Loft with a head in front of it, and the backlit cell is
  #    exactly where that mistake is most expensive. --
  - Entity: 1222000001000040
    TagComponent:
      Tag: Backdrop
    TransformComponent:
      Translation: [0, 0, -0.55]
      Rotation: [0, 0, 0]
      Scale: [2, 2, 0.02]
    MeshComponent:
      Primitive: 1
    MaterialComponent:
      AlbedoColor: [0.14, 0.14, 0.15]
      Metallic: 0
      Roughness: 0.85
