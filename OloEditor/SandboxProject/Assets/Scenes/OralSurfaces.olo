Scene: OralSurfaces.olo
# -----------------------------------------------------------------------------
# ORAL SURFACES fixture (issue #1245).
#
# Lips, gums, tongue and teeth with EXPLICIT material assignments and authored
# parameters, at skin transport version 4 - the version that adds the wet coat
# and the cavity weight. Four distinct .oloskin profiles, one per tissue:
#
#   Assets/Materials/OralLip.oloskin      translucent, modestly wet, cavity 0.35
#   Assets/Materials/OralTongue.oloskin   the wettest surface, cavity 1.0
#   Assets/Materials/OralGum.oloskin      matte under its film, cavity 1.0
#   Assets/Materials/OralEnamel.oloskin   coat IOR 1.63, near-achromatic transport
#
# WHY A SEPARATE SCENE AND NOT THE REFERENCE HEAD. Assets/Scenes/Benchmark/
# ReferenceHead.olo is a PINNED BENCHMARK fixture: its captures are golden and
# its manifest is asserted (ReferenceFixtureManifestTest). Adding geometry to it
# would invalidate every number measured against it, for a feature that has
# nothing to do with what it measures. This scene is additive instead, and the
# reference head keeps naming ReferenceHead.oloskin exactly as it did.
#
# WHY PRIMITIVES. The engine's supplied head is Suzanne, whose mouth is a closed
# slit with no interior, no gums and no teeth - there is no authored oral
# anatomy in this repo to assign materials to, and the issue's scope boundary
# excludes generating any. What the FEATURE needs from geometry is a CAVITY: a
# set of surfaces that enclose a volume, so that "the inside of a closed mouth"
# is a place a pixel can be. Primitives give that exactly and without a licensed
# asset. Dropping a scanned head in here changes the subject and nothing else,
# because every claim this fixture supports is a claim about the MATERIAL.
#
# THE JAW OPENS by moving the entities tagged Lower* and Tongue down in Y. They
# are authored CLOSED, which is the pose the "no glowing interiors" failure
# lives in: under the back light the thin-region transmission of issue #1242
# lights an interior it cannot see, and the cavity weight is what stops it.
# Open the jaw in the editor to see the other half of the pair.
# -----------------------------------------------------------------------------
PostProcessSettings:
  TonemapOperator: 2
  Exposure: 1
  Gamma: 2.2
  BloomEnabled: true
  BloomThreshold: 1.2
  BloomIntensity: 0.2
  BloomIterations: 5
  VignetteEnabled: false
  FXAAEnabled: false
  SSAOEnabled: true
  SSAORadius: 0.2
  SSAOBias: 0.025
  SSAOIntensity: 1
  SSAOSamples: 32
  SSREnabled: false
  SSGIEnabled: false
  AutoExposureEnabled: false
FogSettings:
  Enabled: false
WindSettings:
  Enabled: false
Entities:
  # -- Camera: a CLOSE-UP, which is what this feature is judged at --
  - Entity: 1245000002000001
    TagComponent:
      Tag: Camera
    TransformComponent:
      Translation: [0, 0, 0.62]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    CameraComponent:
      Camera:
        ProjectionType: 0
        PerspectiveFOV: 0.7854
        PerspectiveNear: 0.01
        PerspectiveFar: 100
        OrthographicSize: 10
        OrthographicNear: -1
        OrthographicFar: 1
      Primary: true
      FixedAspectRatio: false
  # -- Key: front-right-above. The wet highlight's source. --
  - Entity: 1245000002000002
    TagComponent:
      Tag: Key Light
    TransformComponent:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    DirectionalLightComponent:
      Direction: [-0.4, -0.55, -0.73]
      Color: [1, 0.97, 0.93]
      Intensity: 5
      CastShadows: true
      ShadowDepthBiasTexels: 2
      ShadowNormalBias: 0.01
      MaxShadowDistance: 12
      CascadeSplitLambda: 0.85
      CascadeDebugVisualization: false
  # -- Side: almost in the image plane. The grazing row of the capture matrix,
  #    and where a coat's Fresnel is largest. --
  - Entity: 1245000002000003
    TagComponent:
      Tag: Side Light
    TransformComponent:
      Translation: [-0.75, 0.05, 0.12]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    PointLightComponent:
      Color: [0.95, 0.92, 0.9]
      Intensity: 6
      Range: 3
      Attenuation: 1
      CastShadows: false
      ShadowBias: 0.005
      ShadowNormalBias: 0.01
  # -- Back: BEHIND the mouth. This is the light the cavity term exists for -
  #    the thin-region transmission fires where dot(N, L) is NEGATIVE, so this
  #    is the only light that can make a closed interior glow. --
  - Entity: 1245000002000004
    TagComponent:
      Tag: Back Light
    TransformComponent:
      Translation: [0.05, 0.02, -0.9]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    PointLightComponent:
      Color: [1, 0.88, 0.82]
      Intensity: 10
      Range: 3
      Attenuation: 1
      CastShadows: false
      ShadowBias: 0.005
      ShadowNormalBias: 0.01
  # The back of the cavity. Thick, so it transmits little even
  # before the cavity weight - a throat that glowed would be the
  # loudest version of this bug.
  - Entity: 1245000002000010
    TagComponent:
      Tag: Throat
    TransformComponent:
      Translation: [0, -0.012, -0.175]
      Rotation: [0, 0, 0]
      Scale: [0.14, 0.1, 0.08]
    MeshComponent:
      Primitive: 2
    MaterialComponent:
      AlbedoColor: [0.34, 0.12, 0.11]
      Metallic: 0
      Roughness: 0.42
      MaterialKind: 2
      SkinProfile: 1245000000000000002
      ThicknessFactor: 0.01
  # Tongue. The wettest surface here, and an interior one:
  # cavity fully spent.
  - Entity: 1245000002000011
    TagComponent:
      Tag: Tongue
    TransformComponent:
      Translation: [0, -0.038, -0.065]
      Rotation: [0, 0, 0]
      Scale: [0.122, 0.03, 0.128]
    MeshComponent:
      Primitive: 2
    MaterialComponent:
      AlbedoColor: [0.55, 0.22, 0.21]
      Metallic: 0
      Roughness: 0.42
      MaterialKind: 2
      SkinProfile: 1245000000000000002
      ThicknessFactor: 0.006
  - Entity: 1245000002000012
    TagComponent:
      Tag: UpperGum
    TransformComponent:
      Translation: [0, 0.047, -0.07]
      Rotation: [0, 0, 0]
      Scale: [0.182, 0.03, 0.079]
    MeshComponent:
      Primitive: 1
    MaterialComponent:
      AlbedoColor: [0.52, 0.2, 0.2]
      Metallic: 0
      Roughness: 0.42
      MaterialKind: 2
      SkinProfile: 1245000000000000003
      ThicknessFactor: 0.005
  - Entity: 1245000002000013
    TagComponent:
      Tag: LowerGum
    TransformComponent:
      Translation: [0, -0.047, -0.07]
      Rotation: [0, 0, 0]
      Scale: [0.182, 0.03, 0.079]
    MeshComponent:
      Primitive: 1
    MaterialComponent:
      AlbedoColor: [0.52, 0.2, 0.2]
      Metallic: 0
      Roughness: 0.42
      MaterialKind: 2
      SkinProfile: 1245000000000000003
      ThicknessFactor: 0.005
  # Teeth. The ONLY entities naming OralEnamel.oloskin - a coat
  # IOR of 1.63 against the mucosa's 1.33, and a near-achromatic
  # transport. That is the third acceptance criterion as
  # authoring rather than as a branch.
  - Entity: 1245000002000014
    TagComponent:
      Tag: UpperTeeth
    TransformComponent:
      Translation: [0, 0.021, -0.056]
      Rotation: [0, 0, 0]
      Scale: [0.168, 0.028, 0.047]
    MeshComponent:
      Primitive: 1
    MaterialComponent:
      AlbedoColor: [0.86, 0.84, 0.79]
      Metallic: 0
      Roughness: 0.42
      MaterialKind: 2
      SkinProfile: 1245000000000000004
      ThicknessFactor: 0.003
  - Entity: 1245000002000015
    TagComponent:
      Tag: LowerTeeth
    TransformComponent:
      Translation: [0, -0.021, -0.056]
      Rotation: [0, 0, 0]
      Scale: [0.168, 0.028, 0.047]
    MeshComponent:
      Primitive: 1
    MaterialComponent:
      AlbedoColor: [0.86, 0.84, 0.79]
      Metallic: 0
      Roughness: 0.42
      MaterialKind: 2
      SkinProfile: 1245000000000000004
      ThicknessFactor: 0.003
  # Lips. The one pair that faces OUTWARD as well as in, which is
  # why their cavity weight is 0.35 and not 1: the transmitted rim
  # on a lip is the effect, not the bug.
  - Entity: 1245000002000016
    TagComponent:
      Tag: UpperLip
    TransformComponent:
      Translation: [0, 0.079, 0.012]
      Rotation: [0, 0, 0]
      Scale: [0.215, 0.037, 0.061]
    MeshComponent:
      Primitive: 2
    MaterialComponent:
      AlbedoColor: [0.55, 0.24, 0.24]
      Metallic: 0
      Roughness: 0.42
      MaterialKind: 2
      SkinProfile: 1245000000000000001
      ThicknessFactor: 0.004
  - Entity: 1245000002000017
    TagComponent:
      Tag: LowerLip
    TransformComponent:
      Translation: [0, -0.079, 0.012]
      Rotation: [0, 0, 0]
      Scale: [0.215, 0.042, 0.065]
    MeshComponent:
      Primitive: 2
    MaterialComponent:
      AlbedoColor: [0.58, 0.26, 0.26]
      Metallic: 0
      Roughness: 0.42
      MaterialKind: 2
      SkinProfile: 1245000000000000001
      ThicknessFactor: 0.004
