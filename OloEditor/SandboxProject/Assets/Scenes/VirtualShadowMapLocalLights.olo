Scene: VirtualShadowMapLocalLights.olo
# ─────────────────────────────────────────────────────────────────────────────
# Virtual shadow pages for POINT and SPOT lights (issue #703).
#
# 22 shadow-casting local lights — 16 point + 6 spot — over a colonnade of props
# that stand BETWEEN the lights and the floor, so every light has something to
# cast. That count is the whole point: the budgeted atlas (issue #435) caps out
# at 16 LIGHTS and 32 ENTRIES, and a point light costs six entries, so this scene
# starves it by construction. Under the atlas most of these lights get
# `AtlasCasterRecord::Allocated == false` and simply have no shadow.
#
# HOW TO USE IT:
#   1. Renderer Settings -> Active Path -> Deferred
#   2. Renderer Settings -> Shadows -> Virtual Shadow Maps -> Enable VSM
#      ("Local Lights (point / spot)" is on by default underneath it)
#   Toggle VSM off and on and watch the props' shadows: with it OFF only the
#   highest-scoring handful of lamps cast at all, and the rest light the props
#   with no shadow under them. With it ON every lamp casts.
#
#   The panel prints the numbers the issue asks for, underneath the directional
#   ones: "local lights N  layers L/256" and "local pages drawn / resident". The
#   two things to read:
#     * "local starved" must not appear at all — that is acceptance criterion 1;
#     * with the camera held still, "local pages drawn" should settle to ~0,
#       which is the page cache doing its job for local lights the same way it
#       already does for the sun.
#
#   Over MCP the same switch is
#   olo_renderer_settings_set {"setting":"virtualshadowmaps","value":"on"}.
#
# WHY THE LIGHTS ARE AT TWO SCALES OF DISTANCE. The near ring sits inside ~12 m
# of the default camera and the far ring at 60-140 m. That spread is what makes
# acceptance criterion 2 visible: a far lamp's pages resolve to a coarse mip and
# cost a handful of pages for a whole cube face, while a near lamp of IDENTICAL
# authored range and intensity resolves to mip 0. Under the atlas the two would
# differ only by their priority RANK, and a far lamp that happened to rank high
# would still be handed a 1024 px tile.
#
# ATTENUATION IS 0.03, NOT THE COMPONENT DEFAULT OF 2.0, on every lamp here. The
# shading path uses it as the QUADRATIC coefficient, so the default is 1/(1+2d^2)
# — half a percent of the light at 10 m — and a scene built on it is lit by
# ambient alone. A scene like that shows no shadows whichever technique is
# running, which makes it worthless as a demo AND indistinguishable from the
# feature being broken. Do not "tidy" these back to the default.
#
# NO DIRECTIONAL LIGHT, deliberately. It keeps the frame's shadows attributable
# to the local path alone, and it exercises the case that used to skip the whole
# shadow pass: with no sun and an empty atlas, `AnyShadowsRequested()` had no
# third source and ShadowRenderPass was culled entirely.
# ─────────────────────────────────────────────────────────────────────────────
PostProcessSettings:
  TonemapOperator: 2
  Exposure: 0.9
  Gamma: 2.2
  BloomEnabled: false
  ColorGradingEnabled: false
  FXAAEnabled: true
  SSAOEnabled: false
  GTAOEnabled: false
  SSREnabled: false
  SSGIEnabled: false
  ContactShadowEnabled: false
Entities:
  # ── Camera: high enough to see the floor between the props, angled down the
  #    colonnade so both light rings are on screen at once. ──
  - Entity: 703000000000001
    TagComponent:
      Tag: Camera
    TransformComponent:
      Translation: [0, 9, 26]
      Rotation: [-0.28, 0, 0]
      Scale: [1, 1, 1]
    CameraComponent:
      Camera:
        ProjectionType: 0
        PerspectiveFOV: 0.785398185
        PerspectiveNear: 0.05
        PerspectiveFar: 2000
        OrthographicSize: 10
        OrthographicNear: -1
        OrthographicFar: 1
      Primary: true
      FixedAspectRatio: false
  # ── Very dim IBL. Low on purpose: the local lamps have to be what lights the
  #    scene, or a missing shadow is hidden by ambient. ──
  - Entity: 703000000000002
    TagComponent:
      Tag: Skybox
    TransformComponent:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    EnvironmentMapComponent:
      FilePath: assets/textures/hdr/newport_loft.hdr
      IsCubemapFolder: false
      EnableSkybox: true
      Rotation: 0
      Exposure: 0.15
      BlurAmount: 0
      EnableIBL: true
      IBLIntensity: 0.05
      Tint: [1, 1, 1]
  # ── The receiver. ──
  - Entity: 703000000000003
    TagComponent:
      Tag: Floor
    TransformComponent:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [400, 1, 400]
    MeshComponent:
      Primitive: 3
    MaterialComponent:
      AlbedoColor: [0.7, 0.7, 0.72]
      Metallic: 0
      Roughness: 1
  # ── NEAR colonnade: eight posts in two rows, each with a lamp above and
  #    between them so the post casts a long shadow across the floor. A thin post
  #    is the classic caster a coarse shadow map loses entirely, which makes it
  #    the clearest read on per-light texel density. ──
