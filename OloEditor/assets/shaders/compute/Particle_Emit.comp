#version 450 core

layout(local_size_x = 64) in;

// Per-particle data (std430, 96 bytes)
struct GPUParticle
{
    vec4 PositionLifetime;     // xyz = pos, w = remaining lifetime
    vec4 VelocityMaxLifetime;  // xyz = vel, w = max lifetime
    vec4 Color;                // rgba
    vec4 InitialColor;         // rgba
    vec4 InitialVelocitySize;  // xyz = initial vel, w = current size
    vec4 Misc;                 // x = initial size, y = rotation, z = alive (1/0), w = entityID
};

layout(std430, binding = 0) buffer ParticleBuffer
{
    GPUParticle particles[];
};

layout(std430, binding = 2) buffer CounterBuffer
{
    uint aliveCount;
    uint deadCount;
    uint emitCount;
    uint pad;
} counters;

layout(std430, binding = 3) buffer FreeListBuffer
{
    uint freeList[];
};

layout(std430, binding = 5) buffer EmitStagingBuffer
{
    GPUParticle staged[];
};

// Previous-frame particle snapshot (xyz pos, w unused; then x rot, y size, zw unused) —
// seeded on spawn so the first rendered frame of a newly emitted particle emits
// zero motion (prev quad basis matches current exactly).
struct PrevParticleData
{
    vec4 Position;      // xyz = prev world position, w unused
    vec4 RotationSize;  // x = prev rotation (radians), y = prev size, zw unused
};

layout(std430, binding = 14) buffer PrevPositionBuffer
{
    PrevParticleData prevData[];
};

// ---------------------------------------------------------------------------
// Particle simulation parameters.
// Former bare uniforms, migrated to a std140 block (issue #691 Phase 7):
// GLSL-for-Vulkan forbids a non-opaque uniform outside a block, and
// VulkanComputeShader::Set* is a deliberate no-op there — so these were both a
// hard SPIR-V compile error and a guaranteed zero-read on the Vulkan route.
// Legal on BOTH routes (GL compute at 460 core takes UBO blocks), so the
// declaration does not fork per backend.
// Declared VERBATIM in Particle_Simulate/_Emit/_Compact.comp — one binding, one
// layout, each shader reading only the members it needs. C++ twin:
// UBOStructures::GPUParticleParamsUBO (ShaderBindingLayout::UBO_PARTICLE_SIM).
// ---------------------------------------------------------------------------
layout(std140, binding = 61) uniform ParticleSimParams
{
    vec3  u_Gravity;               // 0
    float u_DeltaTime;             // 12
    float u_DragCoefficient;       // 16
    uint  u_MaxParticles;          // 20
    int   u_EmitCount;             // 24
    int   u_EnableGravity;         // 28
    int   u_EnableDrag;            // 32
    int   u_EnableWind;            // 36
    float u_WindInfluence;         // 40
    int   u_EnableNoise;           // 44
    float u_NoiseStrength;         // 48
    float u_NoiseFrequency;        // 52
    int   u_EnableGroundCollision; // 56
    float u_GroundY;               // 60
    float u_CollisionBounce;       // 64
    float u_CollisionFriction;     // 68
    vec2  _particlePad0;           // 72
};

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= u_EmitCount)
        return;

    // Atomically claim a free slot
    uint freeIdx = atomicAdd(counters.deadCount, uint(-1));

    // No free slots available — deadCount was 0 and wrapped or reached 0
    if (freeIdx == 0 || freeIdx > u_MaxParticles)
    {
        // Undo the atomic decrement
        atomicAdd(counters.deadCount, 1);
        return;
    }

    // freeIdx was the count before decrement, so the slot index is freeIdx - 1
    uint slot = freeList[freeIdx - 1];

    // Validate slot is within particle buffer bounds
    if (slot >= u_MaxParticles)
    {
        // Corrupted free list entry — undo the claim and skip
        atomicAdd(counters.deadCount, 1);
        return;
    }

    // Copy staged particle data into the particle buffer
    particles[slot] = staged[idx];
    particles[slot].Misc.z = 1.0; // Mark alive
    prevData[slot].Position = vec4(staged[idx].PositionLifetime.xyz, 0.0);
    // Misc.y = rotation, InitialVelocitySize.w = current size
    prevData[slot].RotationSize = vec4(staged[idx].Misc.y, staged[idx].InitialVelocitySize.w, 0.0, 0.0);
}
