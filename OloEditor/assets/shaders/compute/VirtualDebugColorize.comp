#version 460 core

// VirtualDebugColorize.comp — turns the per-pixel overdraw count (R32UI) into a
// heat colour in the RGBA8 debug target (issue #629). Dispatched by
// VirtualGeometryPass only in the Overdraw debug mode, after both raster paths
// have accumulated their per-fragment counts. Empty pixels stay black.

layout(local_size_x = 8, local_size_y = 8) in;

#include "../include/BindlessHeap.glsl"

// Heap-bindless conversion (issue #691). Under OLO_BINDLESS the
// declarations move into main() as locals built from the heap descriptors at
// these image units; the body below is unchanged either way.
#ifndef OLO_BINDLESS
layout(rgba8, binding = 0) uniform writeonly image2D u_DebugColor;
layout(r32ui, binding = 1) uniform readonly uimage2D u_DebugCount;
#endif

// ---- Visibility-buffer / debug-target parameters ----
// Former bare uniforms, migrated to a std140 block (issue #691):
// GLSL-for-Vulkan forbids a non-opaque uniform outside a block, and
// VulkanComputeShader::Set* is a deliberate no-op there — so these were both a
// hard SPIR-V compile error and a guaranteed zero-read on the Vulkan route.
// Legal on BOTH routes (GL compute at 460 core takes UBO blocks), so the
// declaration does not fork per backend.
// Declared VERBATIM in VirtualClusterRaster.comp (both the portable and the
// INT64 variant of that one file) and VirtualDebugColorize.comp — whose former
// u_Width/u_Height ARE these u_ViewportWidth/u_ViewportHeight, renamed so one
// block serves both. C++ twin: UBOStructures::VirtualRasterUBO
// (ShaderBindingLayout::UBO_VIRTUAL_RASTER).
layout(std140, binding = 70) uniform VirtualRasterParams
{
    uint  u_ViewportWidth;  // 0  — visibility-buffer / debug-target width in pixels
    uint  u_ViewportHeight; // 4
    uint  u_Phase;          // 8  — portable raster: 0 = depth atomicMin, 1 = payload write
                            //      (ignored in INT64 mode)
    float u_OverdrawScale;  // 12 — colorize: count that maps to the hot end of the ramp
    // 16 — records the software-raster work list can hold (issue #1058). The
    //      raster bounds its work-list index by THIS and not by the list's own
    //      Count: the cull's atomicAdd on Count is unguarded (#862 bounded the
    //      append, not the counter), so a GPU overflow would inflate the very
    //      number the read is bounded by. 0 = an empty list.
    uint  u_SwListCapacity;
    uint  _vrPad0;          // 20 — std140 rounds the block to a 16-byte multiple;
    uint  _vrPad1;          // 24   explicit so the C++ mirror is a plain struct.
    uint  _vrPad2;          // 28
};

// blue (low) -> green (mid) -> red (high)
vec3 Heat(float t)
{
    t = clamp(t, 0.0, 1.0);
    return vec3(t, 1.0 - abs(t - 0.5) * 2.0, 1.0 - t);
}

void main()
{
#ifdef OLO_BINDLESS
    OLO_HEAP_IMAGE(rgba8, writeonly, image2D, u_DebugColor, 0);
    OLO_HEAP_IMAGE(r32ui, OLO_HEAP_IMAGE_RW, uimage2D, u_DebugCount, 1);
#endif
    uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= u_ViewportWidth || px.y >= u_ViewportHeight)
        return;

    uint count = imageLoad(u_DebugCount, ivec2(px)).r;

    // Alpha is the "a virtual fragment landed here" bit, not a colour — the viewport overlay
    // (VirtualDebugOverlay.glsl) discards on it so the lit frame shows through everywhere the
    // virtual geometry did not draw. Writing alpha = 1 unconditionally (as this used to) marks
    // every empty pixel as written and blacks out the whole viewport. RGB is unchanged, so the
    // capture target and its test — which inspect RGB only — see exactly what they did before.
    vec3 c = (count == 0u) ? vec3(0.0) : Heat(float(count) / max(u_OverdrawScale, 1.0));
    float a = (count == 0u) ? 0.0 : 1.0;
    imageStore(u_DebugColor, ivec2(px), vec4(c, a));
}
