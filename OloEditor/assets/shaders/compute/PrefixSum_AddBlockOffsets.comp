#version 460 core

// =============================================================================
// PrefixSum_AddBlockOffsets.comp — the fold-back half of the device-level
// exclusive scan (issue #713).
//
// After PrefixSum_Scan.comp has scanned each block independently, element `i`
// holds its prefix WITHIN its own block. `blockSums[]` has meanwhile been
// exclusive-scanned in turn, so `blockSums[b]` holds the number of items in all
// blocks before `b`. Adding it makes every prefix global.
//
// Block 0's offset is 0 for free — that is the point of scanning the block
// totals EXCLUSIVELY rather than inclusively, and it is why this shader needs
// no special case for the first block.
//
// This one may early-return: it contains no barrier.
// =============================================================================

layout(local_size_x = 256) in;

// Work-group size of PrefixSum_Scan.comp — the block an element belongs to is
// `idx / this`. The two MUST agree; a mismatch reads the wrong block's offset
// and produces a scan that is plausible but wrong in the tail of every block.
const uint kPrefixSumBlockSize = 256u;

// Must match ShaderBindingLayout::SSBO_PREFIX_SUM_*.
layout(std430, binding = 54) buffer PrefixSumValues { uint values[]; };
layout(std430, binding = 55) readonly buffer PrefixSumBlockSums { uint blockSums[]; };

// Declared VERBATIM in PrefixSum_Scan.comp — see that file for the block's
// documentation. This shader reads only u_Count.
layout(std140, binding = 79) uniform PrefixSumParams
{
    uint u_Count;          // 0
    uint u_WriteBlockSums; // 4  (unused here)
    uint u_WriteTotal;     // 8  (unused here)
    uint _prefixSumPad0;   // 12
};

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= u_Count)
        return;

    values[idx] += blockSums[idx / kPrefixSumBlockSize];
}
