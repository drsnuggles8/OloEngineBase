#version 460 core

// ============================================================================
// Snow_Deform.comp — Stamp-based snow deformation.
//
// Each invocation checks one texel against all deformer stamps and subtracts
// snow depth within the stamp radius (radial falloff). Stamps are uploaded
// to an SSBO by SnowAccumulationSystem::SubmitDeformers.
// ============================================================================

layout(local_size_x = 16, local_size_y = 16) in;

#include "../include/BindlessHeap.glsl"

// Heap-bindless conversion (issue #691). Under OLO_BINDLESS the
// declaration moves into main() as a local built from the heap descriptor at
// this image unit; the body below is unchanged either way.
#ifndef OLO_BINDLESS
layout(r32f, binding = 0) uniform image2D u_SnowDepth;
#endif

struct DeformerStamp
{
    vec4 posAndRadius;       // xyz = world position, w = radius
    vec4 depthAndFalloff;    // x = deform depth, y = falloff exponent, z = compaction (reserved, not yet used), w = unused
};

layout(std430, binding = 7) readonly buffer DeformerBuffer
{
    DeformerStamp stamps[];
};

// ---- Snow clipmap parameters ----
// Former bare uniforms, migrated to a std140 block (issue #691):
// GLSL-for-Vulkan forbids a non-opaque uniform outside a block, and
// VulkanComputeShader::Set* is a deliberate no-op there — so these were both a
// hard SPIR-V compile error and a guaranteed zero-read on the Vulkan route.
// Legal on BOTH routes (GL compute at 460 core takes UBO blocks), so the
// declaration does not fork per backend.
// Declared VERBATIM in Snow_Accumulate.comp and Snow_Deform.comp: the two agree
// on the clipmap trio and each reads its own tail. C++ twin:
// UBOStructures::SnowComputeUBO (ShaderBindingLayout::UBO_SNOW_COMPUTE).
layout(std140, binding = 66) uniform SnowComputeParams
{
    vec2  u_ClipmapCenter;    // 0  — world XZ center
    float u_ClipmapExtent;    // 8  — world-space side length
    int   u_Resolution;       // 12 — texture resolution per axis
    float u_DeltaTime;        // 16 — Snow_Accumulate from here down
    float u_AccumulationRate; // 20 — meters of snow per second
    float u_MaxDepth;         // 24 — maximum snow depth (meters)
    float u_MeltRate;         // 28 — meters lost per second
    float u_RestorationRate;  // 32 — deformation fill-back speed (m/s)
    float u_SnowDensity;      // 36 — 0 = powder, 1 = packed
    int   u_StampCount;       // 40 — Snow_Deform only
    int   _snowPad0;          // 44
};

void main()
{
#ifdef OLO_BINDLESS
    OLO_HEAP_IMAGE(r32f, OLO_HEAP_IMAGE_RW, image2D, u_SnowDepth, 0);
#endif
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= u_Resolution || texel.y >= u_Resolution)
        return;

    // Compute world XZ from texel
    vec2 uv = (vec2(texel) + 0.5) / float(u_Resolution);
    vec2 worldXZ = u_ClipmapCenter + (uv - 0.5) * u_ClipmapExtent;

    float currentDepth = imageLoad(u_SnowDepth, texel).r;
    float totalDeform = 0.0;

    for (int i = 0; i < u_StampCount; ++i)
    {
        vec3 stampPos = stamps[i].posAndRadius.xyz;
        float radius = stamps[i].posAndRadius.w;
        float deformDepth = clamp(stamps[i].depthAndFalloff.x, 0.0, 10.0);
        float falloff = max(stamps[i].depthAndFalloff.y, 0.0);

        vec2 diff = worldXZ - stampPos.xz;
        float dist = length(diff);
        float normalizedDist = dist / max(radius, 0.001);

        if (normalizedDist < 1.0)
        {
            // Radial falloff: 1 at center, 0 at edge
            float factor = pow(1.0 - normalizedDist, falloff);
            totalDeform += deformDepth * factor;
        }
    }

    float newDepth = max(currentDepth - totalDeform, 0.0);
    imageStore(u_SnowDepth, texel, vec4(newDepth, 0.0, 0.0, 0.0));
}
