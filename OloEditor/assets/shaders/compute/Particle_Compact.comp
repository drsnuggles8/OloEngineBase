#version 450 core

// =============================================================================
// Particle_Compact.comp — pass 1 of 3 of the GPU particle compaction.
//
// RETROFITTED ONTO THE PREFIX-SUM PRIMITIVE (issue #713). This shader used to
// BE the whole compaction:
//
//     if (alive) { aliveIndices[atomicAdd(counters.aliveCount, 1)] = idx; }
//     else       { freeList    [atomicAdd(counters.deadCount,  1)] = idx; }
//
// which had two problems. Every one of up to `u_MaxParticles` invocations hit
// ONE of two counters — the most contended atomic in the engine — and, worse,
// the slot a particle received depended on which invocation reached the atomic
// first. So `aliveIndices` came out in a different order every frame from an
// identical particle buffer, and since `ParticleBatchRenderer` draws instance
// `i` as `aliveIndices[i]`, that is the BLEND ORDER of every transparent
// particle in the scene re-rolled per frame. It also made the free list, which
// `Particle_Emit.comp` pops as a stack, recycle slots in an arbitrary order.
//
// The compaction is now: this pass writes a 0/1 alive flag per particle,
// `GPUPrefixSum` exclusive-scans those flags, and `Particle_CompactScatter.comp`
// turns each prefix into a slot. Same set, ascending-particle-index order, and
// no contended counter anywhere.
//
// Deliberately still a plain flag write with an early return: it contains no
// barrier (the scan does, in its own dispatch), so the usual
// `if (idx >= count) return;` opening is fine here.
// =============================================================================

layout(local_size_x = 256) in;

// Per-particle data (std430, 96 bytes)
struct GPUParticle
{
    vec4 PositionLifetime;     // xyz = pos, w = remaining lifetime
    vec4 VelocityMaxLifetime;  // xyz = vel, w = max lifetime
    vec4 Color;                // rgba
    vec4 InitialColor;         // rgba
    vec4 InitialVelocitySize;  // xyz = initial vel, w = current size
    vec4 Misc;                 // x = initial size, y = rotation, z = alive (1/0), w = entityID
};

layout(std430, binding = 0) readonly buffer ParticleBuffer
{
    GPUParticle particles[];
};

// The scan's working buffer (ShaderBindingLayout::SSBO_PREFIX_SUM_VALUES). This
// pass fills it with alive flags; GPUPrefixSum then scans it IN PLACE, so by the
// time Particle_CompactScatter.comp reads it the flags have become prefixes.
// One buffer, two meanings, one dispatch apart — that is the whole trick, and
// the reason the scatter pass re-reads `Misc.z` instead of the flag it can no
// longer see.
layout(std430, binding = 54) writeonly buffer ParticleAliveFlags
{
    uint aliveFlags[];
};

// ---------------------------------------------------------------------------
// Particle simulation parameters.
// Former bare uniforms, migrated to a std140 block (issue #691):
// GLSL-for-Vulkan forbids a non-opaque uniform outside a block, and
// VulkanComputeShader::Set* is a deliberate no-op there — so these were both a
// hard SPIR-V compile error and a guaranteed zero-read on the Vulkan route.
// Legal on BOTH routes (GL compute at 460 core takes UBO blocks), so the
// declaration does not fork per backend.
// Declared VERBATIM in Particle_Simulate/_Emit/_Compact/_CompactScatter.comp —
// one binding, one layout, each shader reading only the members it needs. C++
// twin: UBOStructures::GPUParticleParamsUBO (ShaderBindingLayout::UBO_PARTICLE_SIM).
// ---------------------------------------------------------------------------
layout(std140, binding = 61) uniform ParticleSimParams
{
    vec3  u_Gravity;               // 0
    float u_DeltaTime;             // 12
    float u_DragCoefficient;       // 16
    uint  u_MaxParticles;          // 20
    int   u_EmitCount;             // 24
    int   u_EnableGravity;         // 28
    int   u_EnableDrag;            // 32
    int   u_EnableWind;            // 36
    float u_WindInfluence;         // 40
    int   u_EnableNoise;           // 44
    float u_NoiseStrength;         // 48
    float u_NoiseFrequency;        // 52
    int   u_EnableGroundCollision; // 56
    float u_GroundY;               // 60
    float u_CollisionBounce;       // 64
    float u_CollisionFriction;     // 68
    vec2  _particlePad0;           // 72
};

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= u_MaxParticles)
        return;

    aliveFlags[idx] = (particles[idx].Misc.z > 0.5) ? 1u : 0u;
}
