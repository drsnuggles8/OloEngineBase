#version 450 core

// =============================================================================
// Terrain virtual texture — indirection map, write pass (issue #715).
//
// Stamp ONE mip's changed texels into that mip of the indirection texture. The
// CPU sorts the update list by mip and hands each dispatch its [base, count)
// window, so the whole list is uploaded once and read by up to `mipCount`
// dispatches — one per level, because a storage image binds a single level.
//
// alpha = 255 marks the texel as a DIRECT mapping; the propagation pass leaves
// those alone and fills everything else from the coarser level.
//
// The list is a DELTA, and it carries unmappings too ──────────────
//
// The original handed this pass every resident page after clearing the whole map.
// Since slice 2 it is the frame's *changes* — and an eviction is one of them,
// written as an all-zero texel (alpha = 0), exactly what the clear pass used to
// leave behind. That is the entry that stops an evicted page's stale physical
// address surviving into a tile some other page now owns; without it the
// terrain samples the wrong cache tile and looks merely different, not broken.
//
// C++ twin of the record: VTIndirectionUpdate in
// OloEngine/Terrain/VirtualTexture/TerrainVirtualTextureTypes.h.
// =============================================================================

layout(local_size_x = 64) in;

layout(rgba8, binding = 0) uniform writeonly image2D u_VTIndirectionTarget;

struct VTIndirectionUpdate
{
    uint TexelCoord; // x | (y << 16), already at this mip
    uint Packed;     // tileX | tileY << 8 | residentMip << 16 | direct << 24
};

// The same block the propagation pass declares, and it must stay identical:
// both kernels read the same buffer, so a member added to one is a silent
// misalignment in the other. C++ twin: VTIndirectionHeader in
// TerrainVirtualTexture.cpp.
// binding 79 = SSBO_TERRAIN_VT, shared with the feedback and bake buffers
// and rebound before every use (issue #1015).
layout(std430, binding = 79) readonly buffer TerrainVTIndirectionUpdates
{
    uvec4 u_VTUpdateParams; // x = base index, y = count, zw = unused
    uvec4 u_VTFillParams;   // xy = rect origin, zw = rect size, in texels of this mip
    VTIndirectionUpdate b_VTUpdates[];
};

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= u_VTUpdateParams.y)
        return;

    VTIndirectionUpdate update = b_VTUpdates[u_VTUpdateParams.x + index];

    ivec2 texel = ivec2(int(update.TexelCoord & 0xFFFFu), int(update.TexelCoord >> 16u));

    vec4 color;
    color.x = float( update.Packed        & 0xFFu) / 255.0;
    color.y = float((update.Packed >>  8u) & 0xFFu) / 255.0;
    color.z = float((update.Packed >> 16u) & 0xFFu) / 255.0;
    color.w = float((update.Packed >> 24u) & 0xFFu) / 255.0;

    imageStore(u_VTIndirectionTarget, texel, color);
}
