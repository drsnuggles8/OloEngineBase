#version 460 core

// ============================================================================
// Ocean_FFTButterfly.comp — Tessendorf FFT ocean, radix-2 butterfly pass
// (docs/design/WATER_FUTURE_IMPROVEMENTS.md §1.2).
//
// One pass of the iterative Cooley-Tukey *inverse* FFT (e^{+i2πkn/N} kernel),
// the same algorithm as the CPU reference in OceanFFT.cpp so the two outputs
// are directly comparable. The host dispatches log2(N) horizontal passes then
// log2(N) vertical passes, ping-ponging between two 4-layer RGBA32F image
// arrays. Each texel carries TWO complex numbers (rg and ba) and the same
// twiddle applies to both, so the 8 ocean spectra transform in one chain.
//
// u_Butterfly is a log2(N)×N LUT (x = stage, y = output index):
//   rg = twiddle factor (sign baked in: bottom butterfly wings store -w, so
//        the kernel is uniformly out = in[a] + w·in[b])
//   ba = the two gather indices a, b (stage 0's indices are bit-reversed,
//        absorbing the reorder step of the CPU implementation)
//
// The 1/N² inverse normalisation is NOT applied here — Ocean_Assemble.comp
// folds it in once at the end (the host's debug readback divides on the CPU).
// ============================================================================

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Converted with OceanFFTGpu's bind — bindless variant, see §5c.
#ifdef OLO_BINDLESS
#define u_Butterfly OLO_HEAP_TEX_2D(0)
#else
layout(binding = 0) uniform sampler2D u_Butterfly; // rg = twiddle, ba = gather indices
#endif

#include "../include/BindlessHeap.glsl"

// Heap-bindless conversion (issue #691). Under OLO_BINDLESS the
// declarations move into main() as locals built from the heap descriptors at
// these image units; the body below is unchanged either way.
#ifndef OLO_BINDLESS
layout(rgba32f, binding = 0) readonly uniform image2DArray u_Input;
layout(rgba32f, binding = 1) writeonly uniform image2DArray u_Output;
#endif

// Former bare uniforms, migrated to a std140 block (issue #691):
// GLSL-for-Vulkan forbids a non-opaque uniform outside a block, and
// VulkanComputeShader::Set* is a deliberate no-op there — so these were both a
// hard SPIR-V compile error and a guaranteed zero-read on the Vulkan route.
// Declared VERBATIM-IDENTICAL in Ocean_SpectrumEvolve.comp,
// Ocean_FFTButterfly.comp and Ocean_Assemble.comp (the SnowComputeParams
// precedent): the three agree on u_Resolution and each reads its own slice of
// the tail, with the host refilling the whole block before every dispatch.
// C++ twin: UBOStructures::OceanFFTUBO (ShaderBindingLayout::UBO_OCEAN_FFT).
layout(std140, binding = 73) uniform OceanFFTParams
{
    int   u_Resolution;  // 0  — N (power of two), read by all three passes
    float u_PatchSize;   // 4  — L, world tile size (metres) — SpectrumEvolve only
    float u_Gravity;     // 8  — g — SpectrumEvolve only
    float u_Time;        // 12 — t (seconds) — SpectrumEvolve only
    int   u_Stage;       // 16 — 0 .. log2(N)-1 — FFTButterfly only
    int   u_Vertical;    // 20 — 0 = rows, 1 = columns — FFTButterfly only
    float u_Choppiness;  // 24 — λ, horizontal-displacement scale — Assemble only
    int   u_CascadeLayer; // 28 — target cascade array layer — Assemble only (#969)
};

// Complex multiply.
vec2 cmul(vec2 a, vec2 b)
{
    return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

void main()
{
#ifdef OLO_BINDLESS
    OLO_HEAP_IMAGE(rgba32f, OLO_HEAP_IMAGE_RW, image2DArray, u_Input, 0);
    OLO_HEAP_IMAGE(rgba32f, writeonly, image2DArray, u_Output, 1);
#endif
    ivec3 gid = ivec3(gl_GlobalInvocationID);
    if (gid.x >= u_Resolution || gid.y >= u_Resolution)
        return;

    int coord = (u_Vertical == 1) ? gid.y : gid.x;
    vec4 bf = texelFetch(u_Butterfly, ivec2(u_Stage, coord), 0);
    vec2 w = bf.xy;
    int ia = int(bf.z);
    int ib = int(bf.w);

    ivec2 pa;
    ivec2 pb;
    if (u_Vertical == 1)
    {
        pa = ivec2(gid.x, ia);
        pb = ivec2(gid.x, ib);
    }
    else
    {
        pa = ivec2(ia, gid.y);
        pb = ivec2(ib, gid.y);
    }

    vec4 va = imageLoad(u_Input, ivec3(pa, gid.z));
    vec4 vb = imageLoad(u_Input, ivec3(pb, gid.z));

    // Butterfly on both packed complex pairs: out = in[a] + w·in[b].
    vec4 result = vec4(va.xy + cmul(w, vb.xy), va.zw + cmul(w, vb.zw));
    imageStore(u_Output, gid, result);
}
