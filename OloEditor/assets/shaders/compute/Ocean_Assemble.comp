#version 460 core

// ============================================================================
// Ocean_Assemble.comp — Tessendorf FFT ocean, output-assembly pass
// (docs/design/water-ocean.md §1.2).
//
// Reads the inverse-transformed spectra array (spatial domain after the
// butterfly chain; real parts in .x/.z, imaginary parts ≈ 0 thanks to the
// Hermitian h̃ construction), applies the deferred 1/N² inverse-FFT
// normalisation, and packs the SAME two RGBA32F textures the CPU path
// uploads — so Water.glsl is untouched (§6.4 transition path):
//
//   displacement[layer]: rgb = (λ·dx, height, λ·dz), a = foam = saturate(1 - J)
//   derivatives [layer]: rgb = unit surface normal,  a = Jacobian J
//
// Both outputs are 2D ARRAYS, one layer per cascade band (issue #969). A
// single-cascade field is a one-layer array, so there is one code path.
//
// Mirrors the final packing loop of OceanSpectrum.cpp::EvaluateField +
// OceanFFTField::Upload.
// ============================================================================

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "../include/BindlessHeap.glsl"

// Heap-bindless conversion (issue #691). Under OLO_BINDLESS the
// declarations move into main() as locals built from the heap descriptors at
// these image units; the body below is unchanged either way.
#ifndef OLO_BINDLESS
layout(rgba32f, binding = 0) readonly uniform image2DArray u_Spectra;
layout(rgba32f, binding = 1) writeonly uniform image2DArray u_Displacement;
layout(rgba32f, binding = 2) writeonly uniform image2DArray u_Derivatives;
#endif

// Former bare uniforms, migrated to a std140 block (issue #691):
// GLSL-for-Vulkan forbids a non-opaque uniform outside a block, and
// VulkanComputeShader::Set* is a deliberate no-op there — so these were both a
// hard SPIR-V compile error and a guaranteed zero-read on the Vulkan route.
// Declared VERBATIM-IDENTICAL in Ocean_SpectrumEvolve.comp,
// Ocean_FFTButterfly.comp and Ocean_Assemble.comp (the SnowComputeParams
// precedent): the three agree on u_Resolution and each reads its own slice of
// the tail, with the host refilling the whole block before every dispatch.
// C++ twin: UBOStructures::OceanFFTUBO (ShaderBindingLayout::UBO_OCEAN_FFT).
layout(std140, binding = 73) uniform OceanFFTParams
{
    int   u_Resolution;  // 0  — N (power of two), read by all three passes
    float u_PatchSize;   // 4  — L, world tile size (metres) — SpectrumEvolve only
    float u_Gravity;     // 8  — g — SpectrumEvolve only
    float u_Time;        // 12 — t (seconds) — SpectrumEvolve only
    int   u_Stage;       // 16 — 0 .. log2(N)-1 — FFTButterfly only
    int   u_Vertical;    // 20 — 0 = rows, 1 = columns — FFTButterfly only
    float u_Choppiness;  // 24 — λ, horizontal-displacement scale — Assemble only
    int   u_CascadeLayer; // 28 — target cascade array layer — Assemble only (#969)
};

void main()
{
#ifdef OLO_BINDLESS
    OLO_HEAP_IMAGE(rgba32f, OLO_HEAP_IMAGE_RW, image2DArray, u_Spectra, 0);
    OLO_HEAP_IMAGE(rgba32f, writeonly, image2DArray, u_Displacement, 1);
    OLO_HEAP_IMAGE(rgba32f, writeonly, image2DArray, u_Derivatives, 2);
#endif
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= u_Resolution || gid.y >= u_Resolution)
        return;

    // Deferred inverse-FFT normalisation (1/N per dimension).
    float s = 1.0 / (float(u_Resolution) * float(u_Resolution));

    vec4 l0 = imageLoad(u_Spectra, ivec3(gid, 0)) * s; // h, dispX
    vec4 l1 = imageLoad(u_Spectra, ivec3(gid, 1)) * s; // dispZ, slopeX
    vec4 l2 = imageLoad(u_Spectra, ivec3(gid, 2)) * s; // slopeZ, dxdx
    vec4 l3 = imageLoad(u_Spectra, ivec3(gid, 3)) * s; // dzdz, dxdz

    float height = l0.x;
    float lambda = u_Choppiness;
    vec2 disp = lambda * vec2(l0.z, l1.x);

    // Analytic normal from the slope field.
    float sx = l1.z;
    float sz = l2.x;
    vec3 normal = normalize(vec3(-sx, 1.0, -sz));

    // Folding Jacobian of the horizontal displacement (J < 1 ⇒ foam).
    float jxx = 1.0 + lambda * l2.z;
    float jzz = 1.0 + lambda * l3.x;
    float jxz = lambda * l3.z;
    float jacobian = jxx * jzz - jxz * jxz;
    float foam = clamp(1.0 - jacobian, 0.0, 1.0);

    // One chain per cascade band, each landing in its own array layer
    // (issue #969). The single-cascade fallback is layer 0 of a one-layer
    // array, so this addressing is the same code on both paths.
    ivec3 dst = ivec3(gid, u_CascadeLayer);
    imageStore(u_Displacement, dst, vec4(disp.x, height, disp.y, foam));
    imageStore(u_Derivatives, dst, vec4(normal, jacobian));
}
