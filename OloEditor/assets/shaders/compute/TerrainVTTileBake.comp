#version 450 core

// =============================================================================
// Terrain virtual texture — physical cache tile bake (issue #715).
//
// **This is where the splat blend moved to.** One invocation per cache texel
// composites the whole up-to-8-layer triplanar + height blend ONCE and writes
// the result into the physical cache; the fragment stages then do a single
// indirection lookup plus a cache sample, which is what makes terrain shading
// cost independent of layer count.
//
// gl_GlobalInvocationID.z selects the tile, so every page the CPU mapped this
// frame is baked by one dispatch.
//
// Three things differ from the fragment path on purpose:
//
//  - **Explicit footprint.** A compute invocation has no derivatives, so the
//    layer arrays are sampled with a LOD (top projection) or gradients (side
//    projections) derived from the page's own texel density and the height
//    field's slope. That is not a workaround — it is more correct than the
//    fragment path's screen-space derivatives, because a cache texel's
//    footprint is known exactly.
//  - **Absolute world height.** The side projections run texture V down world
//    Y, so the bake takes the terrain's ABSOLUTE model matrix rather than the
//    camera-relative one the draw path uses (issue #429). The cache is
//    invalidated if that matrix moves.
//  - **One scale.** The fragment path's two-scale sampling fades on view
//    distance, which a baked tile does not have, so it is off for a terrain
//    that shades through this cache (u_TerrainLayerScale is zero there, which
//    also keeps the per-pixel fallback of an unready sector matching its
//    neighbours).
//
// The blend math itself is shared with both fragment paths via
// include/TerrainLayerBlend.glsl — three evaluators of one blend is exactly the
// shape that drifts silently.
// =============================================================================

#include "../include/TerrainLayerBlend.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 23) uniform sampler2D u_TerrainHeightmap;
layout(binding = 24) uniform sampler2D u_TerrainSplatmap0;
layout(binding = 25) uniform sampler2DArray u_TerrainAlbedoArray;
layout(binding = 26) uniform sampler2DArray u_TerrainNormalArray;
layout(binding = 27) uniform sampler2DArray u_TerrainARMArray;
layout(binding = 28) uniform sampler2D u_TerrainSplatmap1;

// Layer 0 = albedo.rgb + AO, layer 1 = normal.xy + roughness + metallic.
layout(rgba8, binding = 0) uniform writeonly image2DArray u_VTCache;

struct VTBakeRequest
{
    uint PageKey; // mip << 24 | y << 12 | x (atlas space; informational here)
    uint TileX;   // destination tile — or the scratch slot on the compressed path
    uint TileY;
    uint Pad;
    // Terrain-UV rect of the page CONTENT: xy = min, z = span, w unused.
    // Resolved on the CPU (VTPageTerrainUVRect): under adaptivity a page's
    // terrain footprint depends on the owning sector's current image size,
    // which this kernel has no business knowing.
    vec4 UVRect;
};

// binding 79 = SSBO_TERRAIN_VT, shared with the feedback and indirection
// buffers and rebound before every use (issue #1015).
layout(std430, binding = 79) readonly buffer TerrainVTBake
{
    uvec4 u_VTBakeConfig0; // x = pagesWide, y = pageTexels, z = borderTexels, w = requestCount
    uvec4 u_VTBakeConfig1; // x = layerCount, y = tileTexels, z = layerResolution, w = unused
    vec4  u_VTBakeWorld;   // x = worldSizeX, y = worldSizeZ, z = heightScale, w = triplanarSharpness
    vec4  u_VTBakeTexel;   // x = heightmap texel size, yzw = unused
    mat4  u_VTBakeModel;   // terrain-local -> ABSOLUTE world
    vec4  u_VTBakeTiling0;
    vec4  u_VTBakeTiling1;
    vec4  u_VTBakeSharp0;
    vec4  u_VTBakeSharp1;
    VTBakeRequest b_VTBakeRequests[];
};

float layerTiling(int layer)
{
    return oloTerrainLayerTiling(layer, u_VTBakeTiling0, u_VTBakeTiling1);
}

// The height field's slope, in metres of height per metre along X and along Z —
// the same four-tap central difference the tess_eval stage uses, so the
// triplanar decision here matches the geometry the shaded pixel actually sits
// on.
vec2 terrainSlope(vec2 uv)
{
    float texelSize = u_VTBakeTexel.x;
    float heightScale = u_VTBakeWorld.z;

    float hL = textureLod(u_TerrainHeightmap, uv + vec2(-texelSize, 0.0), 0.0).r * heightScale;
    float hR = textureLod(u_TerrainHeightmap, uv + vec2( texelSize, 0.0), 0.0).r * heightScale;
    float hD = textureLod(u_TerrainHeightmap, uv + vec2(0.0, -texelSize), 0.0).r * heightScale;
    float hU = textureLod(u_TerrainHeightmap, uv + vec2(0.0,  texelSize), 0.0).r * heightScale;

    float dX = (hR - hL) / (2.0 * texelSize * u_VTBakeWorld.x);
    float dZ = (hU - hD) / (2.0 * texelSize * u_VTBakeWorld.y);
    return vec2(dX, dZ);
}

// One array, all the projections the texel uses — the bake's twin of
// oloTerrainSampleLayer in include/TerrainLayerSampling.glsl. The top
// projection keeps its explicit LOD; the side projections take the gradients
// of their own coordinates, because along world Y a cache texel's footprint is
// stretched by the slope and a single LOD would either alias it or blur the
// horizontal axis.
struct BakeFootprint
{
    float TopLod;   // before the per-layer tiling: log2(texels per cache texel) at tiling 1, resolution 1
    vec2 SideXDx;
    vec2 SideXDy;
    vec2 SideZDx;
    vec2 SideZDy;
};

vec4 sampleLayer(sampler2DArray layers, int layer, OloTerrainProjection proj, BakeFootprint footprint, vec3 w,
                 bool useTriplanar, float tiling, float layerResolution)
{
    float lod = log2(max(footprint.TopLod * tiling * layerResolution, 1e-6));
    if (!useTriplanar)
        return textureLod(layers, vec3(proj.Top * tiling, float(layer)), lod);

    vec4 result = vec4(0.0);
    if (w.y > 0.0)
        result += textureLod(layers, vec3(proj.Top * tiling, float(layer)), lod) * w.y;
    if (w.x > 0.0)
    {
        result += textureGrad(layers, vec3(proj.SideX * tiling, float(layer)), footprint.SideXDx * tiling,
                              footprint.SideXDy * tiling) * w.x;
    }
    if (w.z > 0.0)
    {
        result += textureGrad(layers, vec3(proj.SideZ * tiling, float(layer)), footprint.SideZDx * tiling,
                              footprint.SideZDy * tiling) * w.z;
    }
    return result;
}

// A layer's normal in the top projection's tangent frame — the bake's twin of
// oloTerrainSampleLayerNormal.
vec3 sampleLayerNormal(int layer, OloTerrainProjection proj, BakeFootprint footprint, vec3 surfaceNormal, mat3 tbn,
                       vec3 w, bool useTriplanar, float tiling, float layerResolution)
{
    float lod = log2(max(footprint.TopLod * tiling * layerResolution, 1e-6));
    if (!useTriplanar)
        return textureLod(u_TerrainNormalArray, vec3(proj.Top * tiling, float(layer)), lod).rgb * 2.0 - 1.0;

    vec3 tangentTop = vec3(0.0, 0.0, 1.0);
    vec3 tangentSideX = vec3(0.0, 0.0, 1.0);
    vec3 tangentSideZ = vec3(0.0, 0.0, 1.0);
    if (w.y > 0.0)
        tangentTop = textureLod(u_TerrainNormalArray, vec3(proj.Top * tiling, float(layer)), lod).rgb * 2.0 - 1.0;
    if (w.x > 0.0)
    {
        tangentSideX = textureGrad(u_TerrainNormalArray, vec3(proj.SideX * tiling, float(layer)),
                                   footprint.SideXDx * tiling, footprint.SideXDy * tiling).rgb * 2.0 - 1.0;
    }
    if (w.z > 0.0)
    {
        tangentSideZ = textureGrad(u_TerrainNormalArray, vec3(proj.SideZ * tiling, float(layer)),
                                   footprint.SideZDx * tiling, footprint.SideZDy * tiling).rgb * 2.0 - 1.0;
    }
    return oloTerrainTriplanarNormal(surfaceNormal, tbn, tangentTop, tangentSideX, tangentSideZ, w);
}

void main()
{
    uint requestIndex = gl_GlobalInvocationID.z;
    if (requestIndex >= u_VTBakeConfig0.w)
        return;

    uint tileTexels = u_VTBakeConfig1.y;
    uvec2 localTexel = gl_GlobalInvocationID.xy;
    if (localTexel.x >= tileTexels || localTexel.y >= tileTexels)
        return;

    VTBakeRequest request = b_VTBakeRequests[requestIndex];

    float pageTexels = float(u_VTBakeConfig0.y);
    float border = float(u_VTBakeConfig0.z);
    float span = request.UVRect.z;

    // EXACT INVERSE of oloVTVirtualToPhysicalUV: that maps page-local [0,1) to
    // physical texel `border + local * pageTexels`, so texel centre j + 0.5 must
    // hold the content at page-local (j + 0.5 - border) / pageTexels. Outside
    // [0,1) is the border, which is why it holds the true neighbouring content
    // rather than a clamped edge.
    vec2 pageLocal = (vec2(localTexel) + 0.5 - border) / pageTexels;
    vec2 uv = request.UVRect.xy + pageLocal * span;
    // The terrain's own maps do not tile, so a border that runs off the terrain
    // clamps rather than wrapping to the far edge.
    vec2 uvClamped = clamp(uv, vec2(0.0), vec2(1.0));

    // min(): weights[]/heights[] below are fixed at 8, and an out-of-bounds
    // GLSL array write is undefined rather than caught. TerrainMaterial::AddLayer
    // already refuses past MAX_TERRAIN_LAYERS so the producer cannot send more,
    // but that invariant lives in another file — this keeps the array bound
    // provable from the loop that uses it.
    int layerCount = min(int(u_VTBakeConfig1.x), 8);
    float layerResolution = float(u_VTBakeConfig1.z);

    float weights[8];
    vec4 splat0 = textureLod(u_TerrainSplatmap0, uvClamped, 0.0);
    weights[0] = splat0.r;
    weights[1] = splat0.g;
    weights[2] = splat0.b;
    weights[3] = splat0.a;
    if (layerCount > 4)
    {
        vec4 splat1 = textureLod(u_TerrainSplatmap1, uvClamped, 0.0);
        weights[4] = splat1.r;
        weights[5] = splat1.g;
        weights[6] = splat1.b;
        weights[7] = splat1.a;
    }
    else
    {
        weights[4] = 0.0; weights[5] = 0.0; weights[6] = 0.0; weights[7] = 0.0;
    }

    vec2 slope = terrainSlope(uvClamped);
    vec3 localNormal = normalize(vec3(-slope.x, 1.0, -slope.y));
    vec3 projectionWeights = oloTerrainProjectionWeights(oloTerrainTriplanarWeights(localNormal, u_VTBakeWorld.w));
    bool useTriplanar = oloTerrainUseTriplanar(localNormal);
    mat3 tbn = oloTerrainTangentFrame(localNormal);

    float height = textureLod(u_TerrainHeightmap, uvClamped, 0.0).r * u_VTBakeWorld.z;
    vec3 worldPos = (u_VTBakeModel * vec4(uv.x * u_VTBakeWorld.x, height, uv.y * u_VTBakeWorld.y, 1.0)).xyz;

    // Where the layers are sampled — the SAME function the fragment paths call
    // (include/TerrainLayerBlend.glsl), from the unclamped UV so a border texel
    // continues the tiling, and from the absolute world height.
    OloTerrainProjection proj = oloTerrainProjection(uv, worldPos.y, u_VTBakeWorld.xy);

    // One cache texel is `uvPerTexel` of terrain UV along each axis. Over that
    // step the height changes by slope * (uvPerTexel * worldSize) metres, which
    // is the side projections' V gradient (V runs DOWN world Y, over the same
    // world size oloTerrainProjection divides by).
    float uvPerTexel = span / pageTexels;
    BakeFootprint footprint;
    footprint.TopLod = uvPerTexel;
    float heightPerTexelX = slope.x * uvPerTexel * u_VTBakeWorld.x; // metres per texel step along terrain U
    float heightPerTexelZ = slope.y * uvPerTexel * u_VTBakeWorld.y; // metres per texel step along terrain V
    footprint.SideXDx = vec2(0.0, -heightPerTexelX / max(u_VTBakeWorld.y, 0.0001));
    footprint.SideXDy = vec2(uvPerTexel, -heightPerTexelZ / max(u_VTBakeWorld.y, 0.0001));
    footprint.SideZDx = vec2(uvPerTexel, -heightPerTexelX / max(u_VTBakeWorld.x, 0.0001));
    footprint.SideZDy = vec2(0.0, -heightPerTexelZ / max(u_VTBakeWorld.x, 0.0001));

    // The ARM alpha is the layer's height for the height blend: sampled only
    // for the layers the splatmap puts at this texel, and kept for the blend
    // loop — the fragment paths' rule, which the bake has to share or a tile
    // and the per-pixel fallback beside it blend differently.
    float heights[8];
    vec4 layerARMs[8];
    for (int i = 0; i < 8; ++i)
    {
        heights[i] = 0.0;
        layerARMs[i] = vec4(0.0);
    }
    int sampledMask = 0;
    for (int i = 0; i < 8; ++i)
    {
        if (i >= layerCount)
            break;
        if (oloTerrainLayerIsDead(weights[i]))
            continue;
        layerARMs[i] = sampleLayer(u_TerrainARMArray, i, proj, footprint, projectionWeights, useTriplanar,
                                   layerTiling(i), layerResolution);
        heights[i] = layerARMs[i].a;
        sampledMask |= (1 << i);
    }

    oloTerrainHeightBlend(weights, heights, layerCount, u_VTBakeSharp0, u_VTBakeSharp1);

    vec3 albedo = vec3(0.0);
    vec3 normalMap = vec3(0.0);
    float ao = 0.0;
    float roughness = 0.0;
    float metallic = 0.0;

    for (int i = 0; i < 8; ++i)
    {
        if (i >= layerCount)
            break;
        if (weights[i] < 0.001)
            continue;

        float tiling = layerTiling(i);

        vec4 layerARM = layerARMs[i];
        if ((sampledMask & (1 << i)) == 0)
        {
            layerARM = sampleLayer(u_TerrainARMArray, i, proj, footprint, projectionWeights, useTriplanar, tiling,
                                   layerResolution);
        }
        vec4 layerAlbedo = sampleLayer(u_TerrainAlbedoArray, i, proj, footprint, projectionWeights, useTriplanar,
                                       tiling, layerResolution);
        vec3 layerNormal = sampleLayerNormal(i, proj, footprint, localNormal, tbn, projectionWeights, useTriplanar,
                                             tiling, layerResolution);

        albedo    += layerAlbedo.rgb * weights[i];
        normalMap += layerNormal * weights[i];
        ao        += layerARM.r * weights[i];
        roughness += layerARM.g * weights[i];
        metallic  += layerARM.b * weights[i];
    }

    normalMap = normalize(normalMap);
    // Guard the degenerate case (every weight below the 0.001 cull): normalize()
    // of a zero vector is a NaN that would be baked into the cache permanently.
    if (!(dot(normalMap, normalMap) > 0.5))
        normalMap = vec3(0.0, 0.0, 1.0);

    ivec3 dst = ivec3(int(request.TileX * tileTexels + localTexel.x),
                      int(request.TileY * tileTexels + localTexel.y), 0);
    imageStore(u_VTCache, dst, vec4(albedo, ao));

    dst.z = 1;
    // Only xy is stored; the shading side reconstructs z from the upper
    // hemisphere, which buys the roughness byte.
    imageStore(u_VTCache, dst, vec4(normalMap.xy * 0.5 + 0.5, roughness, metallic));
}
