#version 450 core

layout(local_size_x = 256) in;
#define OLO_PREFIX_SUM_GROUP_SIZE 256
#include "../include/PrefixSum.glsl"
#include "../include/FoliageCullCommon.glsl"
#include "../include/FoliageCullCompaction.glsl"
#include "../include/FoliageLodTransition.glsl"
#include "../include/GPUReadbackStats.glsl"

uint oloFoliageMark(uint idx)
{
    // ── Level 1: did this plant's patch survive? ──
    uint group = l_Tail[l_RowGroupOffset + idx];
    if (group >= s_GroupCount || s_Tail[group] == 0u)
        return 0u;

    // ── Level 2: the plant itself ──
    FoliageInstanceRow row = b_SrcInstances[idx];
    vec3 lo;
    vec3 hi;
    oloFoliageInstanceBounds(row.PositionScale.xyz, row.PositionScale.w, row.RotationHeight.y, lo, hi);

    if (!oloFoliageBoxVisible(lo, hi))
        return kFoliageOneTested;
    if (oloFoliageBoxDistance(lo, hi) > s_DistanceOrigin.w)
        return kFoliageOneTested;

    // ── Level 3: coverage-preserving density (issue #1237) ──
    //
    // The row is dropped only where the vertex stages would have drawn it at
    // ALPHA ZERO — the same hash, the same keep fraction, the same fade ramp,
    // from the shared include both sides compile. That equality is the whole
    // safety argument: this kernel is an optimisation over a decision the draw
    // makes anyway, so a disagreement could only ever delete a visible plant,
    // and there is no second copy of the rule to disagree with.
    //
    // Measured from the PIVOT here, while the tests above use the padded AABB.
    // Deliberate, and the same split the mesh hand-over makes: the bounds test
    // must be conservative (a bent plant whose box still reaches the frustum is
    // kept), while the thinning is a per-plant identity decision that has to
    // give the same answer as the vertex stage's, which reads the pivot.
    //
    // TERRAIN-LOCAL, like every other distance in this kernel — s_DistanceOrigin
    // is the main eye put into the same space as the rows (see its comment in
    // FoliageCullCommon.glsl), so no per-instance transform is needed. The
    // vertex stages measure the same distance in RENDER-RELATIVE world, and the
    // two agree exactly while the owning terrain's transform is a rigid motion,
    // which every authored terrain here is. Under a SCALED terrain transform
    // they would differ by that scale — the pre-existing draw-distance test two
    // lines up has the identical property, so this inherits the convention
    // rather than introducing it, but it is the thing to look at first if a
    // scaled terrain ever drops a plant that is plainly on screen.
    if (foliageDensityEnabled(s_LodTransition0))
    {
        float lodDist = distance(row.PositionScale.xyz, s_DistanceOrigin.xyz);
        float lodHash = foliageLodInstanceHash(row.PositionScale.xyz);
        if (foliageDensityAlphaAt(s_LodTransition0, s_LodTransition1, lodHash, lodDist) <= 0.0)
            return kFoliageOneTested;
    }


    bool mesh = s_MeshRegionBase != 0u &&
                distance(row.PositionScale.xyz, s_DistanceOrigin.xyz) <= s_MeshReach;
    return kFoliageOneTested + 1u + (mesh ? kFoliageOneMesh : 0u);
}

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    uint mark = idx < s_InstanceCount ? oloFoliageMark(idx) : 0u;
    uint total;
    uint rank = OloPrefixSumExclusive(mark, total);

    if (idx < s_InstanceCount)
    {
        uint flags = (mark & 1u) != 0u ? kFoliageKeepCard : 0u;
        if ((mark & kFoliageOneMesh) != 0u)
            flags |= kFoliageKeepMesh;
        s_Tail[s_ScratchOffset + idx] = rank | flags;
    }

    if (gl_LocalInvocationIndex == 0u)
    {
        s_Tail[oloFoliageTileOffset(gl_WorkGroupID.x)] = total;
        if (s_EmitStats != 0u)
        {
            oloStatAdd(OLO_STAT_FoliageCullGenerated, min(s_InstanceCount - idx, gl_WorkGroupSize.x));
            oloStatAdd(OLO_STAT_FoliageCullTested, (total >> 18u) & kFoliageCountMask);
            oloStatAdd(OLO_STAT_FoliageCullVisible, total & kFoliageCountMask);
        }
    }
}
