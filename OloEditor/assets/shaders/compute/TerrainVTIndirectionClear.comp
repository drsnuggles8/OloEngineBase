#version 450 core

// =============================================================================
// Terrain virtual texture — indirection map, clear pass (issue #715).
//
// Zero one mip of the indirection texture.
//
// This now runs ONLY on a full rebuild ────────────────────────────
//
// The original ran it before every write pass, because "page P is no longer resident"
// was expressed as an absence: clear everything, re-stamp what is left. The
// delta path expresses it as an explicit all-zero update instead
// (VTIndirectionDelta::Unmap), so the per-frame clear is gone.
//
// What still needs it is the case where the map's contents are not KNOWN rather
// than merely stale: a freshly created indirection texture, whose storage is
// undefined until something writes it, and the escape hatch when an accumulated
// delta outgrows its upload buffer. Both go through
// VTIndirectionDelta::MarkEverythingDirty(), and that is the only caller.
//
// The alpha channel is the flag the other two passes key on — 0 here means
// "nothing direct at this texel", which is exactly the state a cleared texel
// should be in.
// =============================================================================

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba8, binding = 0) uniform writeonly image2D u_VTIndirectionTarget;

void main()
{
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    // imageSize(), not a uniform: the bound level IS the authority on its own
    // extent, so the bound-check cannot disagree with the dispatch.
    if (any(greaterThanEqual(texel, imageSize(u_VTIndirectionTarget))))
        return;

    imageStore(u_VTIndirectionTarget, texel, vec4(0.0));
}
