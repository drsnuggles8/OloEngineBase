#version 460 core

// =============================================================================
// GTAO.comp — Ground Truth Ambient Occlusion (XeGTAO) compute shader
//
// 16x16 workgroups. Each thread computes AO for one pixel using:
//   - 9 angular slices around the pixel
//   - 3 depth samples per slice (R1 quasi-random distance distribution)
//   - Adaptive HZB mip sampling for efficient depth lookups
//   - Cosine-weighted horizon angle integration
//
// Inputs:  HZB depth pyramid (sampler2D), view-space normals (sampler2D)
// Outputs: R8 AO term (image2D), R8 edge weights (image2D)
//
// Based on Intel XeGTAO / Hazel Engine implementation.
// =============================================================================

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// ---------------------------------------------------------------------------
// UBO: GTAO parameters (binding 28, must match C++ GTAOUBO in ShaderBindingLayout.h)
// ---------------------------------------------------------------------------
layout(std140, binding = 28) uniform GTAOParams
{
    vec2  u_NDCToViewMul;
    vec2  u_NDCToViewAdd;

    vec2  u_NDCToViewMul_x_PixelSize;
    float u_EffectRadius;
    float u_EffectFalloffRange;

    float u_RadiusMultiplier;
    float u_FinalValuePower;
    float u_DenoiseBlurBeta;
    float u_SampleDistributionPower;

    float u_ThinOccluderCompensation;
    float u_DepthMIPSamplingOffset;
    int   u_NoiseIndex;
    float u_DepthLinearizeA;

    vec2  u_HZBUVFactor;
    int   u_ScreenWidth;
    int   u_ScreenHeight;

    int   u_DenoiseEnabled;
    int   u_DenoisePasses;
    float u_DepthLinearizeB;
    int   u_DebugView;

    mat4  u_ViewMatrix;    // World-to-view transform for normal conversion

    // Variable Rate Compute Shading (issue #683). APPENDED, never inserted:
    // GTAO_Denoise.comp declares a SHORTER prefix of this same block, which
    // std140 allows, and inserting a member would silently relayout every
    // field the denoise shader reads. x = consume the rate image, y = paint the
    // rate heatmap into the AO term instead of the AO, zw reserved.
    ivec4 u_VRCSParams;
};

// ---------------------------------------------------------------------------
// Resources
// ---------------------------------------------------------------------------
#include "../include/BindlessHeap.glsl"
#include "../include/VRCS.glsl"

// Heap-bindless conversion (issue #691). Under OLO_BINDLESS the
// declarations move into main() as locals built from the heap descriptors at
// these image units; the body below is unchanged either way.
#ifndef OLO_BINDLESS
layout(binding = 0, r8) writeonly uniform image2D o_AOTerm;
layout(binding = 1, r8) writeonly uniform image2D o_Edges;
#endif

// Sampler inputs converted alongside GTAORenderPass's binds. They could not move
// separately: this shader is already a bindless variant (its output images are
// converted above), so IsBoundProgramBindless() is true and a seam call for a
// still-slot-based declaration would record an offset and issue no bind — see
// glsl-shaders.md §5c. Note the UNSIGNED sampler for the Hilbert LUT: a heap
// handle carries no type, so reading an R16UI table through the float macro
// would reinterpret the same uvec2 and silently return garbage (§5d).
#ifdef OLO_BINDLESS
#define u_HZBDepth OLO_HEAP_TEX_2D(3)
#define u_ViewNormals OLO_HEAP_TEX_2D(4)
#define u_HilbertLUT OLO_HEAP_TEX_2D_UINT(5)
#define u_ShadingRate OLO_HEAP_TEX_2D_UINT(6)
#else
layout(binding = 3) uniform sampler2D u_HZBDepth;        // HZB depth pyramid
layout(binding = 4) uniform sampler2D u_ViewNormals;     // Octahedral-encoded view normals

layout(binding = 5) uniform usampler2D u_HilbertLUT;     // 64x64 R16UI Hilbert curve index

// VRCS per-tile shading rate (R8UI, one texel per 8x8 pixels — issue #683).
// UNSIGNED sampler, like the Hilbert LUT above and for the same reason: a heap
// handle carries no type, so reading an R8UI image through the float macro
// reinterprets the same uvec2 and returns garbage with no diagnostic (§5d).
layout(binding = 6) uniform usampler2D u_ShadingRate;
#endif

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------
#define XE_GTAO_SLICE_COUNT         9
#define XE_GTAO_STEPS_PER_SLICE     3
#define XE_GTAO_DEPTH_MIP_LEVELS    5
#define XE_GTAO_PI                  3.14159265358979
#define XE_GTAO_HALF_PI             1.57079632679490

// Far-plane (sky) classification tolerance. Never compare a sampled depth
// against 1.0 exactly: any filtered read of a D24 depth source can
// legitimately come back a few ULPs below 1.0 (1 D24 ULP ~= 5.96e-8), and an
// exact >= 1.0 test then treats the entire sky as geometry sitting at the
// far plane. 1e-6 (~17 ULPs) of slack is far below any depth separation real
// geometry can have this close to the far plane.
#define XE_GTAO_FAR_DEPTH_THRESHOLD (1.0 - 1e-6)

// ---------------------------------------------------------------------------
// Octahedral decode (must match the encoder in forward shaders)
// Normals are stored in RG16F with range [-1,1] — no remapping needed.
// ---------------------------------------------------------------------------
vec3 OctDecode(vec2 f)
{
    vec3 n = vec3(f.xy, 1.0 - abs(f.x) - abs(f.y));
    float t = max(-n.z, 0.0);
    n.x += (n.x >= 0.0) ? -t : t;
    n.y += (n.y >= 0.0) ? -t : t;
    return normalize(n);
}

// ---------------------------------------------------------------------------
// Linearize depth from [0,1] device-Z to positive view-space distance.
// Standard OpenGL projection: z_view = proj[3][2] / (deviceZ * 2.0 - 1.0 + proj[2][2])
// Returns positive distance (negated view-space Z).
// ---------------------------------------------------------------------------
float LinearizeDepth(float deviceZ)
{
    float ndc = deviceZ * 2.0 - 1.0;
    return u_DepthLinearizeB / (ndc + u_DepthLinearizeA);
}

float SampleHZBDepth(vec2 screenUV, float mipLevel)
{
    vec2 clampedScreenUV = clamp(screenUV, vec2(0.0), vec2(1.0));
    return textureLod(u_HZBDepth, clampedScreenUV * u_HZBUVFactor, mipLevel).r;
}

// ---------------------------------------------------------------------------
// Compute view-space position from screen position and depth
// ---------------------------------------------------------------------------
vec3 ComputeViewspacePosition(vec2 screenPos, float viewspaceDepth)
{
    vec3 ret;
    ret.xy = (u_NDCToViewMul * screenPos + u_NDCToViewAdd) * viewspaceDepth;
    ret.z = -viewspaceDepth;
    return ret;
}

// ---------------------------------------------------------------------------
// R2 quasi-random sequence (spatiotemporal noise via Hilbert LUT).
//
// The Hilbert LUT stores an ORDERING, not a noise value, and it is locality-
// PRESERVING by construction: neighbouring pixels get indices one apart. The R2
// sequence (an irrational stride, so successive indices land maximally far
// apart in [0,1)) is what converts that ordering into blue-noise-like values.
// Both halves are load-bearing and must not be "simplified":
//   - Using the index directly ((idx + noiseIndex) & 0xFF) / 256 hands adjacent
//     pixels near-identical noise, so the slice angle and sample distances vary
//     SMOOTHLY along the curve. The round() quantisation of sampleOffset below
//     then turns that smooth ramp into coherent contours instead of per-pixel
//     dither: a woven "goosebump" lattice carrying this LUT's 64px tile period,
//     worst wherever pixelRadius puts the contours at a visible spacing.
//   - The 288-per-frame temporal stride is what lets TAA resolve the dither.
//     Advancing the index by 1 instead only slides the SAME spatial pattern
//     along the curve, so every frame has identical structure and temporal
//     averaging has nothing to cancel — the lattice survives TAA untouched.
// Both were live bugs; see docs/agent-rules/glsl-shaders.md.
// ---------------------------------------------------------------------------
vec2 SpatioTemporalNoise(ivec2 pixCoord)
{
    uint idx = texelFetch(u_HilbertLUT, pixCoord & ivec2(63), 0).r;
    idx += 288u * (uint(u_NoiseIndex) & 63u);
    return fract(0.5 + vec2(idx) * vec2(0.75487766624669276005, 0.5698402909980532659114));
}

// ---------------------------------------------------------------------------
// Edge detection from depth (4 neighbours vs center)
// Packed into [0,1] for denoise edge-aware weighting.
// ---------------------------------------------------------------------------
float CalculateEdges(float centerZ, float leftZ, float rightZ, float topZ, float bottomZ)
{
    vec4 edgesLRTB = vec4(leftZ, rightZ, topZ, bottomZ) - centerZ;
    vec4 edgesLRTBSlopeAdjusted = edgesLRTB + edgesLRTB.yxwz;
    edgesLRTB = min(abs(edgesLRTB), abs(edgesLRTBSlopeAdjusted));
    vec4 threshold = vec4(centerZ) * 0.02;
    return dot(vec4(greaterThan(edgesLRTB, threshold)), vec4(0.25));
}

// ---------------------------------------------------------------------------
// Write this invocation's AO and edge weight across its VRCS footprint (#683).
//
// At full rate (footprint 1) this is exactly the two imageStores the shader
// always did. At 2x2 / 4x4 it is the BROADCAST half of the contract in
// include/VRCS.glsl.
//
// THE EDGE WEIGHT IS BROADCAST TOO, which an earlier version of this shader
// deliberately did not do — it computed the edge term per pixel on the grounds
// that the denoise pass uses it as bilateral guidance and must not blur across
// a discontinuity. That reasoning was right about the risk and wrong about
// where it applies: inside a coarse tile the classifier has already certified
// planarity AND normal agreement, so there is no discontinuity for the edge
// term to protect and its per-pixel variation there is noise. Keeping it
// per-pixel also meant every follower invocation still did five HZB taps, so
// no invocation could retire early — which is most of why the first
// measured build was 43% SLOWER rather than faster (see §4 of
// docs/agent-rules/variable-rate-compute-shading.md).
//
// The bounds test is not optional — a footprint may hang off the right or
// bottom edge of the viewport even though its leader is inside (footprints are
// origin-aligned, so the leader is the minimum corner).
//
// The images are declared HERE rather than in main() because under OLO_BINDLESS
// the heap macro declares and initialises a FUNCTION-SCOPED local, so it has to
// be repeated in every function that touches the image (glsl-shaders.md §5b).
// ---------------------------------------------------------------------------
void StoreResultFootprint(ivec2 base, uint footprint, float ao, float edge)
{
#ifdef OLO_BINDLESS
    OLO_HEAP_IMAGE(r8, writeonly, image2D, o_AOTerm, 0);
    OLO_HEAP_IMAGE(r8, writeonly, image2D, o_Edges, 1);
#endif
    for (uint dy = 0u; dy < footprint; ++dy)
    {
        for (uint dx = 0u; dx < footprint; ++dx)
        {
            ivec2 target = base + ivec2(int(dx), int(dy));
            if (target.x < u_ScreenWidth && target.y < u_ScreenHeight)
            {
                imageStore(o_AOTerm, target, vec4(ao));
                imageStore(o_Edges, target, vec4(edge));
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Map this invocation to the pixel it should SHADE, compacting the work so
// whole waves retire (issue #683).
//
// THIS IS THE STEP THAT MAKES VRCS FASTER RATHER THAN SLOWER, and leaving it
// out is the whole of the first build's 43% regression. The obvious
// implementation — every invocation keeps its own pixel and returns unless it
// is its footprint's leader — masks lanes but does not retire waves. Leaders
// sit at even x and even y, so with a 16x16 group every 32-lane wave still
// contains 8 of them and still pays the full latency of the slice loop; the
// only thing the "saving" bought was an extra fetch, an extra branch and four
// times the stores.
//
// So instead: the group's 256 invocations are handed out as a COMPACTED list of
// the leaders of the four 8x8 tiles the group covers. With all four tiles at
// 2x2 that is 64 work items, so lanes 64-255 — six of the eight waves — retire
// on a single comparison and never touch a texture.
//
// Returns false when this invocation has no work.
// ---------------------------------------------------------------------------
bool ResolveVRCSWorkItem(out ivec2 pixCoord, out uint footprint)
{
    uint lane = gl_LocalInvocationIndex;

    // VRCS off: the identity mapping, byte-for-byte the pre-#683 path. A
    // group-uniform branch on a uniform, so it costs nothing, and it keeps the
    // disabled path's memory access pattern EXACTLY as it was rather than
    // as a permutation that happens to cover the same pixels.
    if (u_VRCSParams.x == 0)
    {
        pixCoord = ivec2(gl_GlobalInvocationID.xy);
        footprint = OLO_VRCS_RATE_1X1;
        return true;
    }

    ivec2 groupTile = ivec2(gl_WorkGroupID.xy) * 2;

    uint fps[4];
    uint counts[4];
    uint total = 0u;
    for (uint t = 0u; t < 4u; ++t)
    {
        // An out-of-range texelFetch on the rate image returns 0, which decodes
        // to full rate — so a group hanging off the tile grid degrades to
        // correct-and-slow rather than to a coarse block of nothing.
        ivec2 tc = groupTile + ivec2(int(t & 1u), int(t >> 1u));
        uint f = OloVRCSDecodeFootprint(texelFetch(u_ShadingRate, tc, 0).r);
        uint perSide = uint(OLO_VRCS_TILE_SIZE) / f;
        fps[t] = f;
        counts[t] = perSide * perSide;
        total += counts[t];
    }

    if (lane >= total)
    {
        pixCoord = ivec2(0);
        footprint = OLO_VRCS_RATE_1X1;
        return false;
    }

    // Which tile does this work item belong to, and which leader within it?
    uint t = 0u;
    uint local = lane;
    while (t < 3u && local >= counts[t])
    {
        local -= counts[t];
        ++t;
    }

    uint f = fps[t];
    uint perSide = uint(OLO_VRCS_TILE_SIZE) / f;
    ivec2 tileOrigin = (groupTile + ivec2(int(t & 1u), int(t >> 1u))) * OLO_VRCS_TILE_SIZE;

    pixCoord = tileOrigin + ivec2(int((local % perSide) * f), int((local / perSide) * f));
    footprint = f;
    return true;
}

// ---------------------------------------------------------------------------
// Main AO computation
// ---------------------------------------------------------------------------
void main()
{
    // Variable Rate Compute Shading (issue #683). Every invocation that gets
    // past this point OWNS a footprint and shades it; the ones with no work
    // have already retired, in whole waves wherever the group's tiles are
    // coarse. With VRCS off this is the identity mapping and every line below
    // behaves exactly as it did before — there is deliberately no second copy
    // of the AO code to keep in sync.
    ivec2 pixCoord;
    uint vrcsFootprint;
    if (!ResolveVRCSWorkItem(pixCoord, vrcsFootprint))
    {
        return;
    }

    if (pixCoord.x >= u_ScreenWidth || pixCoord.y >= u_ScreenHeight)
    {
        return;
    }

    // Rate-visualisation heatmap: 1.0 full rate, 0.5 at 2x2, 0.25 at 4x4,
    // written into the AO term so the existing GTAO debug view displays it.
    //
    // Derived from the footprint this invocation ACTUALLY used, never re-read
    // from the rate image, so the overlay cannot disagree with what ran.
    //
    // Placed FIRST, above every early-out, so the heatmap is uniform: a sky or
    // sentinel tile takes an early return that publishes AO = 1.0, and reading
    // that as "full rate" in the overlay would paint a legitimately-coarse sky
    // tile white. GTAORenderPass also suppresses the denoise while this is on,
    // because four bilateral blur passes over a block pattern is a blur of the
    // thing the overlay exists to show.
    if (u_VRCSParams.y != 0)
    {
        StoreResultFootprint(pixCoord, vrcsFootprint, OloVRCSDebugShade(vrcsFootprint), 0.0);
        return;
    }

    vec2 pixelSize = vec2(1.0) / vec2(u_ScreenWidth, u_ScreenHeight);
    vec2 normalizedScreenPos = (vec2(pixCoord) + 0.5) * pixelSize;

    // Sample depth from HZB mip 0 (HZB maps scene UV [0,1] to full texture)
    float deviceZ = SampleHZBDepth(normalizedScreenPos, 0.0);

    if (deviceZ <= 0.0 || deviceZ >= XE_GTAO_FAR_DEPTH_THRESHOLD)
    {
        // Classification refuses to coarsen a tile that mixes sky and
        // geometry, so every pixel of this footprint is on the same side of
        // this test as the invocation that took it.
        StoreResultFootprint(pixCoord, vrcsFootprint, 1.0, 0.0);
        return;
    }

    // Match SSAO: no normal means no occlusion, so store full visibility.
    //
    // Tested next to the depth early-out rather than at the decode below: a
    // sentinel pixel produces exactly this result regardless of depth,
    // neighbour depths, edges or reconstructed position, so computing those
    // first is pure waste. On a forward-path frame the overlay shaders cover
    // a large share of the screen.
    vec2 encodedNormal = texelFetch(u_ViewNormals, pixCoord, 0).rg;
    if (encodedNormal.x < -1.5)
    {
        // Same argument as the sky case: a tile containing a sentinel normal is
        // never coarsened, so this footprint is uniform in that respect too.
        StoreResultFootprint(pixCoord, vrcsFootprint, 1.0, 0.0);
        return;
    }

    float viewspaceZ = LinearizeDepth(deviceZ);

    // Neighbour depths for edge detection
    float pixLZ = LinearizeDepth(SampleHZBDepth((vec2(pixCoord) + vec2(-1.0, 0.0) + 0.5) * pixelSize, 0.0));
    float pixRZ = LinearizeDepth(SampleHZBDepth((vec2(pixCoord) + vec2( 1.0, 0.0) + 0.5) * pixelSize, 0.0));
    float pixTZ = LinearizeDepth(SampleHZBDepth((vec2(pixCoord) + vec2( 0.0,-1.0) + 0.5) * pixelSize, 0.0));
    float pixBZ = LinearizeDepth(SampleHZBDepth((vec2(pixCoord) + vec2( 0.0, 1.0) + 0.5) * pixelSize, 0.0));

    // Edge weight for the denoise's bilateral guidance. Broadcast across the
    // footprint alongside the AO term — see StoreResultFootprint for why that
    // is safe inside a tile the classifier has already certified as planar and
    // normal-consistent, and why keeping it per-pixel was what stopped any
    // invocation from retiring.
    float edgeWeight = CalculateEdges(viewspaceZ, pixLZ, pixRZ, pixTZ, pixBZ);

    // Reconstruct view-space position
    vec3 pixCenterPos = ComputeViewspacePosition(normalizedScreenPos, viewspaceZ);

    // Per-pixel view vector (from the shaded point toward the camera, which
    // sits at the view-space origin). Used below as the slice plane's
    // reference axis instead of a globally-fixed screen axis, so the
    // tangent-elevation basis tracks the true per-pixel perspective ray
    // (a fixed axis is only a good approximation near screen centre; it
    // diverges from the real view ray increasingly toward the edges).
    vec3 viewVec = normalize(-pixCenterPos);

    // Decode world-space normal from GBuffer and convert to view-space.
    //
    // (-2,-2) is the engine-wide "no normal here" sentinel, written by every
    // shader that draws into the scene normal RT without a meaningful surface
    // normal: InfiniteGrid, the four Particle_* shaders, and the Renderer2D_*
    // quad/circle/line/text/polygon shaders. It is outside any valid
    // octahedral range, so decoding it yields a garbage normal and GTAO
    // FABRICATES occlusion wherever those shaders drew.
    //
    // SSAO.glsl has always guarded this ("sentinel value (-2,-2) means no
    // normal"); GTAO.comp did not, which is why the forward path baked the
    // editor grid into the AO buffer as a lattice of dark lines while the
    // deferred path stayed clean -- the G-Buffer never carries those overlay
    // draws, so only forward sees the sentinel. It cost ~4/255 mean absolute
    // difference between the two paths at an off-axis pose.
    //
    vec3 viewNormal = normalize(mat3(u_ViewMatrix) * OctDecode(encodedNormal));

    // Noise for slice rotation (.x) and sample distance along the slice (.y).
    // These come from the two independent R2 dimensions; deriving the second
    // from the first (fract(noiseSlice * golden)) is NOT independent — with
    // noiseSlice quantised to k/256 it reduces to fract(k * 0.00241), a plain
    // ramp spanning only [0, 0.62), which biases every sample inward.
    vec2 noise = SpatioTemporalNoise(pixCoord);
    float noiseSlice = noise.x;
    float noiseSample = noise.y;

    // World-space AO radius → pixel radius on screen
    // proj[0][0] = 2 / NDCToViewMul.x, half-screen in pixels = screenWidth / 2
    // pixelRadius = radius * proj[0][0] * (screenWidth / 2) / |z_view|
    float projScale = 1.0 / u_NDCToViewMul.x; // = proj[0][0] / 2
    float pixelRadius = u_EffectRadius * projScale * float(u_ScreenWidth) / abs(pixCenterPos.z);

    // Too small to matter — skip
    if (pixelRadius < 2.0)
    {
        StoreResultFootprint(pixCoord, vrcsFootprint, 1.0, edgeWeight);
        return;
    }

    // =======================================================================
    // XeGTAO: Slice-based horizon integration
    // =======================================================================
    float visibility = 0.0;

    for (int slice = 0; slice < XE_GTAO_SLICE_COUNT; slice++)
    {
        float sliceAngle = (float(slice) + noiseSlice) * (XE_GTAO_PI / float(XE_GTAO_SLICE_COUNT));
        vec2 omega = vec2(cos(sliceAngle), sin(sliceAngle));

        // Direction in view-space (projected onto the tangent plane)
        vec3 directionVS = vec3(omega.x, omega.y, 0.0);
        // orthoDirectionVS / axisVS / projectedNormal / cosN all measure the
        // surface normal's tilt relative to the SLICE PLANE, which is spanned
        // by the per-pixel view vector and the slice's screen direction --
        // NOT relative to the surface normal itself, and NOT relative to a
        // globally-fixed screen axis. Two related bugs lived here (issue
        // #533):
        //   1. axisVS was built as cross(directionVS, viewNormal). Crossing
        //      anything with viewNormal is perpendicular to viewNormal for
        //      ANY input, so dot(viewNormal, axisVS) == 0 identically,
        //      collapsing projectedNormal to viewNormal and n to exactly 0
        //      for every slice on every pixel -- see
        //      docs/agent-rules/glsl-shaders.md's cross(X,V)⊥V note.
        //   2. Even after basing axisVS on the view axis instead, cosN dotted
        //      projectedNormal against viewNormal -- but for an orthogonal
        //      projection P = V - axis*dot(V,axis), dot(P,V) == |P|^2 is a
        //      plain linear-algebra identity, so that cosN always reduced to
        //      projectedNormalLen again: non-degenerate, but still not the
        //      intended "elevation relative to the slice plane's reference
        //      axis" quantity, which left surfaces away from dead-on self-
        //      occluded and washed out real, localised occlusion (e.g. a
        //      contact crease) into the same flat wrongness.
        // Fixed by using the per-pixel viewVec (not viewNormal, not a fixed
        // axis) throughout this block.
        vec3 orthoDirectionVS = directionVS - dot(directionVS, viewVec) * viewVec;
        vec3 axisVS = normalize(cross(directionVS, viewVec));
        vec3 projectedNormal = viewNormal - axisVS * dot(viewNormal, axisVS);
        float projectedNormalLen = length(projectedNormal);

        float signN = sign(dot(orthoDirectionVS, projectedNormal));
        float cosN = clamp(dot(projectedNormal, viewVec) / max(projectedNormalLen, 1e-6), 0.0, 1.0);
        float n = signN * acos(cosN);

        // Horizon angles, initialised to "no occluder found on this side".
        //
        // These MUST start at -1 (horizon fully behind the surface), not at
        // cos(n +/- HALF_PI). The h0/h1 reconstruction below recovers an angle
        // with acos(), which discards the sign of (n -/+ HALF_PI) -- so for the
        // unoccluded case the old initialisation produced:
        //     n = 0        ->  h0 = -HALF_PI, h1 = +HALF_PI  -> visibility 1  (correct)
        //     n = HALF_PI  ->  h0 =  0,       h1 =  0        -> visibility 0  (wrong)
        // i.e. a surface with NO occluders reported full occlusion, with the
        // error growing continuously as the surface tilts away from dead-on.
        // That is why this was invisible looking straight down (n == 0) and why
        // a grazing view across a large flat surface -- a sea, a quay, a floor
        // seen edge-on -- went uniformly black, then pinned at the 0.03
        // visibility floor below (0.03 * 255 = 8, the exact value observed).
        // With -1 both sides reconstruct symmetrically (acos(-1) = PI), giving
        // h0 = n - HALF_PI and h1 = n + HALF_PI for every n, and max() in the
        // march below still lets any real occluder raise the horizon.
        float horizonCos0 = -1.0;
        float horizonCos1 = -1.0;

        // March along the slice direction
        for (int step = 0; step < XE_GTAO_STEPS_PER_SLICE; step++)
        {
            float stepBaseNoise = float(step) + noiseSample;
            float stepNoise = pow(stepBaseNoise / float(XE_GTAO_STEPS_PER_SLICE), u_SampleDistributionPower);

            // Sample offset in pixels, then convert to UV
            float sampleOffsetPixels = max(stepNoise * pixelRadius, 1.0);

            // Adaptive mip level from pixel distance
            float mipLevel = clamp(log2(sampleOffsetPixels) - u_DepthMIPSamplingOffset, 0.0, float(XE_GTAO_DEPTH_MIP_LEVELS));

            vec2 sampleOffset = round(omega * sampleOffsetPixels) * pixelSize;

            // Positive direction
            vec2 sampleScreenPos0 = normalizedScreenPos + sampleOffset;
            float SZ0 = LinearizeDepth(SampleHZBDepth(sampleScreenPos0, mipLevel));
            vec3 samplePos0 = ComputeViewspacePosition(sampleScreenPos0, SZ0);

            // Negative direction
            vec2 sampleScreenPos1 = normalizedScreenPos - sampleOffset;
            float SZ1 = LinearizeDepth(SampleHZBDepth(sampleScreenPos1, mipLevel));
            vec3 samplePos1 = ComputeViewspacePosition(sampleScreenPos1, SZ1);

            // Horizon angle updates
            vec3 sampleDelta0 = samplePos0 - pixCenterPos;
            vec3 sampleDelta1 = samplePos1 - pixCenterPos;
            float dist0 = length(sampleDelta0);
            float dist1 = length(sampleDelta1);

            vec3 sampleHorizon0 = sampleDelta0 / max(dist0, 1e-6);
            vec3 sampleHorizon1 = sampleDelta1 / max(dist1, 1e-6);

            // Falloff based on distance relative to effect radius
            float falloffBase0 = dist0 / u_EffectRadius;
            float falloffBase1 = dist1 / u_EffectRadius;
            float falloffRange = u_EffectFalloffRange;
            float weight0 = clamp(1.0 - (falloffBase0 - (1.0 - falloffRange)) / falloffRange, 0.0, 1.0);
            float weight1 = clamp(1.0 - (falloffBase1 - (1.0 - falloffRange)) / falloffRange, 0.0, 1.0);

            // Update horizon cosines (max with existing, weighted by falloff)
            float newHorizonCos0 = dot(sampleHorizon0, viewNormal);
            float newHorizonCos1 = dot(sampleHorizon1, viewNormal);

            // Thin occluder compensation
            //
            // The compensation term must be measured from -1 (the "no occluder
            // found" horizon set above), NOT from 0. Scaling horizonCos itself
            // makes thinComp negative while the horizon is still unoccluded, so
            // horizonCos - thinComp = -1 + compensation RAISES the floor above
            // -1 and re-introduces exactly the phantom occlusion the -1
            // initialisation exists to prevent -- a slice that found nothing
            // would report itself partly occluded. Basing it on the distance
            // from -1 keeps an unoccluded horizon pinned at -1 (thinComp == 0)
            // and only decays a horizon some real occluder already raised.
            if (u_ThinOccluderCompensation > 0.0)
            {
                float thinComp0 = (horizonCos0 + 1.0) * u_ThinOccluderCompensation;
                float thinComp1 = (horizonCos1 + 1.0) * u_ThinOccluderCompensation;
                horizonCos0 = max(horizonCos0 - thinComp0, mix(horizonCos0, newHorizonCos0, weight0));
                horizonCos1 = max(horizonCos1 - thinComp1, mix(horizonCos1, newHorizonCos1, weight1));
            }
            else
            {
                horizonCos0 = max(horizonCos0, mix(horizonCos0, newHorizonCos0, weight0));
                horizonCos1 = max(horizonCos1, mix(horizonCos1, newHorizonCos1, weight1));
            }
        }

        // Integrate visibility from horizon angles
        // Clamp to the normal hemisphere
        horizonCos0 = clamp(horizonCos0, -1.0, 1.0);
        horizonCos1 = clamp(horizonCos1, -1.0, 1.0);

        float h0 = n + max(-acos(horizonCos0) - n, -XE_GTAO_HALF_PI);
        float h1 = n + min( acos(horizonCos1) - n,  XE_GTAO_HALF_PI);

        // Inner integral: 0.25 * (cos(2h-n) + 2h*sin(n) + cos(n))
        float iarc0 = -cos(2.0 * h0 - n) + cos(n) + 2.0 * h0 * sin(n);
        float iarc1 = -cos(2.0 * h1 - n) + cos(n) + 2.0 * h1 * sin(n);
        float localVisibility = 0.25 * (iarc0 + iarc1) * projectedNormalLen;

        visibility += localVisibility;
    }

    // Normalize across slices
    visibility /= float(XE_GTAO_SLICE_COUNT);
    if (isnan(visibility) || isinf(visibility))
    {
        visibility = 1.0;
    }
    visibility = clamp(visibility, 0.03, 1.0);

    // Apply power curve for contrast, then preserve a floor so GTAO cannot
    // collapse the final scene color to black when the horizon integral is
    // very conservative for a frame.
    visibility = pow(visibility, u_FinalValuePower);
    visibility = clamp(visibility, 0.03, 1.0);

    // Store results across this invocation's footprint.
    StoreResultFootprint(pixCoord, vrcsFootprint, visibility, edgeWeight);
}
