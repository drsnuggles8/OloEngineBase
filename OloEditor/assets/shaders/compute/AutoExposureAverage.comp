#version 460 core

// =============================================================================
// AutoExposureAverage.comp — reduce the 256-bin histogram to an adapted
// luminance + exposure multiplier (one workgroup, one thread per bin).
//
// CPU mirror: OloEngine/Renderer/AutoExposure.h :: ComputeAverageLuminance,
// AdaptLuminance, EV100FromLuminance, ExposureFromEV100, ComputeExposure.
// Pinned by AutoExposureMathTest — keep all three in lock-step.
//
//   1. Weighted-average bin over the non-black pixels (bin 0 excluded).
//   2. Frame-rate-independent eye adaptation toward that target.
//   3. Lagarde/Frostbite EV100 -> exposure, clamped to [min,max].
//
// The adapted luminance (state[1]) persists across frames; state[0] is the
// exposure the ToneMap shader consumes.
// =============================================================================

#define NUM_BINS 256

layout(local_size_x = NUM_BINS, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 19) buffer HistogramBuffer
{
    uint histogram[NUM_BINS];
};

layout(std430, binding = 20) buffer ExposureState
{
    float state[]; // [0] = exposure multiplier, [1] = adapted luminance (persists)
};

// Former bare uniforms, migrated to a std140 block (issue #691): the
// Vulkan SPIR-V route cannot express non-block uniforms and its
// ComputeShader::Set* calls are deliberate no-ops. The block is shared
// VERBATIM with AutoExposureHistogram.comp (one C++ struct fills both).
// The percentile band: only the non-black population inside
// (u_LowPercentile, u_HighPercentile] contributes to the metered average
// (UE EyeAdaptation Low/HighPercent style) — robust against composition
// shifts AND compact glints; (0, 1) reproduces the plain weighted mean.
layout(std140, binding = 72) uniform AutoExposureParams
{
    vec2  u_MeterSize;              // metering grid dimensions (unused here)
    float u_MinLogLum;              // histogram lower bound (log2 luminance)
    float u_InvLogLumRange;         // 1.0 / (maxLogLum - minLogLum) (unused here)
    float u_LogLumRange;            // maxLogLum - minLogLum
    float u_Dt;                     // frame delta time (seconds)
    float u_SpeedUp;                // adaptation rate when brightening
    float u_SpeedDown;              // adaptation rate when darkening
    float u_ExposureCompensation;
    float u_MinExposure;
    float u_MaxExposure;
    float u_LowPercentile;
    float u_HighPercentile;
    float _aePad0;
    vec2  _aePad1;
};

const float BLACK_THRESHOLD = 0.0001;

shared uint s_Counts[NUM_BINS];

// Mirrors AutoExposure::BinToLuminance.
float binToLuminance(float bin)
{
    float logLum01 = clamp((bin - 1.0) / 254.0, 0.0, 1.0);
    return exp2(logLum01 * u_LogLumRange + u_MinLogLum);
}

void main()
{
    uint i = gl_LocalInvocationIndex;
    s_Counts[i] = histogram[i];
    barrier();

    // Parallel reduction for the total pixel count.
    for (uint cutoff = NUM_BINS / 2u; cutoff > 0u; cutoff >>= 1u)
    {
        if (i < cutoff)
        {
            s_Counts[i] += s_Counts[i + cutoff];
        }
        barrier();
    }

    if (i != 0u)
        return;

    // --- Percentile-banded average luminance ---
    // Mirrors AutoExposure::ComputeAverageLuminance exactly (CPU twin pinned
    // by AutoExposureMathTest): clip each bin's population to the
    // [low, high) band of the cumulative non-black distribution, with the
    // boundary bins contributing fractionally.
    uint totalCount = s_Counts[0];
    uint numBlack = histogram[0];
    uint nonBlack = (totalCount > numBlack) ? (totalCount - numBlack) : 0u;

    float targetLum;
    if (nonBlack == 0u)
    {
        targetLum = binToLuminance(0.0);
    }
    else
    {
        float lo = clamp(u_LowPercentile, 0.0, 1.0);
        float hi = clamp(u_HighPercentile, 0.0, 1.0);
        if (!(hi > lo))
        {
            lo = 0.0; // degenerate band — fall back to the untrimmed mean
            hi = 1.0;
        }
        float lowCount = float(nonBlack) * lo;
        float highCount = float(nonBlack) * hi;
        float weighted = 0.0;
        float used = 0.0;
        float cumulative = 0.0;
        for (uint b = 1u; b < NUM_BINS; ++b)
        {
            float binStart = cumulative;
            cumulative += float(histogram[b]);
            float take = max(0.0, min(cumulative, highCount) - max(binStart, lowCount));
            weighted += float(b) * take;
            used += take;
        }
        float avgBin = (used > 0.0) ? (weighted / used) : 0.0;
        targetLum = binToLuminance(avgBin);
    }

    // --- Eye adaptation (AutoExposure::AdaptLuminance) ---
    float current = state[1];
    if (!(current > 0.0)) // first frame / uninitialised history snaps to target
        current = targetLum;
    float adapted = current;
    if (u_Dt > 0.0)
    {
        float speed = (targetLum > current) ? u_SpeedUp : u_SpeedDown;
        adapted = (speed > 0.0) ? current + (targetLum - current) * (1.0 - exp(-u_Dt * speed))
                                : targetLum;
    }

    // --- EV100 -> exposure (AutoExposure::ComputeExposure) ---
    float ev100 = log2(max(adapted, BLACK_THRESHOLD) * 100.0 / 12.5) - u_ExposureCompensation;
    float maxLum = 1.2 * exp2(ev100);
    float exposure = 1.0 / max(maxLum, BLACK_THRESHOLD);
    exposure = clamp(exposure, min(u_MinExposure, u_MaxExposure), max(u_MinExposure, u_MaxExposure));

    state[0] = exposure;
    state[1] = adapted;
}
