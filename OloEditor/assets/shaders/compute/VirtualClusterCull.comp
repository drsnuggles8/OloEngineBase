#version 460 core

// VirtualClusterCull.comp — DAG-cut selection + frustum + cone backface cull
// for the virtualized-geometry cluster pipeline (issue #629).
//
// One dispatch per virtual-mesh instance (u_InstanceIndex), one thread per
// cluster. Selection mirrors the CPU reference cut rule in
// VirtualMesh::IsClusterSelectedProjected (parity pinned by
// VirtualClusterCullParityTest): a cluster is drawn iff the projected error of
// its member group is OVER the instance threshold AND it is original geometry
// (RefinedGroup == ~0u) or the projected error of the group that produced it is
// at or under the threshold. Group errors are monotone and group LOD spheres
// nested (builder invariants), so the resulting cut is watertight.
//
// Survivors are compacted into per-instance segments of the shared draw-command
// buffer via atomicAdd on this instance's DrawArgs.DrawCount, which the raster
// side reads directly as the glMultiDrawElementsIndirectCount parameter — the
// visible count never touches the CPU.
//
// Frustum planes are derived from CullViewProjection() with the same row-of-VP
// technique as InstanceFrustumCull.comp / Frustum::Update() — keeping that
// math in sync with the C++ side is a load-bearing invariant.
//
// TWO-PHASE OCCLUSION (issue #682). The shader runs twice per frame:
//   * PHASE 1 (u_Phase2 == 0, one dispatch per instance, u_InstanceIndex) — the
//     full cut + frustum + cone, then a Hi-Z test against the PREVIOUS frame's
//     depth pyramid. That pyramid was built from last frame's FINAL depth, so it
//     contains virtual geometry: this is the step that lets a foreground VG
//     building occlude the VG city behind it. A hit is appended to the reject
//     list (u_WriteRejected) rather than dropped.
//   * PHASE 2 (u_Phase2 != 0, one dispatch over the reject list) — after the
//     phase-1 survivors have been drawn and the pyramid rebuilt from the now
//     current depth, every reject is re-tested against it and the ones that
//     turned out visible are emitted into a second command region.
// Phase 1 may therefore reject wrongly (reprojection error, camera cut,
// disocclusion) with no visible consequence; only a phase-2 reject is final.

// CLUSTER-BOUNDS VISUALIZATION (issue #725). The cut, frustum and cone verdicts
// above are made per cluster on the GPU and, before this, never came back — so
// "why did that cluster disappear" was answerable only by adding a debug colour
// output and reloading. `u_DebugDrawClusters` makes each verdict emit the
// cluster's world-space cull sphere into the shader debug-draw channel, colour
// coded by which test decided it. Off by default; see the uniform's comment for
// the modes and the sub-sampling knob (a real Nanite scene has far more clusters
// than any channel capacity, so pushing all of them is not a visualization).
#define OLO_DEBUG_DRAW_SPHERE
#include "../include/DebugDrawCommon.glsl"

layout(local_size_x = 64) in;

// Mirrors OloEngine::VirtualClusterGpuRecord (VirtualMeshGpuData.h, 64 B std430).
// Drift here produces silent culling corruption; pinned by static_asserts + parity test.
struct VirtualCluster {
    vec4 CullSphere;   // xyz mesh-local center, w radius
    vec4 Cone;         // xyz mesh-local axis, w cutoff (>= 1 disables)
    uint VertexBase;
    uint IndexBase;
    uint IndexCount;
    uint GroupIndex;
    uint RefinedGroup; // ~0u for LOD-0 clusters
    uint _p0; uint _p1; uint _p2;
};

// Mirrors OloEngine::VirtualGroupGpuRecord (32 B std430).
struct VirtualGroup {
    vec4 LODSphere;    // xyz mesh-local center, w radius
    float Error;       // absolute object-space error; FLT_MAX marks terminal groups
    float _p0; float _p1; float _p2;
};

// Mirrors OloEngine::VirtualInstanceGpuRecord (224 B std430).
struct VirtualInstance {
    mat4 Transform;      // render-origin-relative
    mat4 PrevTransform;
    mat4 NormalMatrix;
    uint ClusterBase;
    uint ClusterCount;
    uint GroupBase;
    int  EntityID;
    float MaxScale;
    float ErrorThresholdPixels;
    uint CommandBase;
    uint Flags;          // bit0 = uniform scale (enables the cone test)
};

// DrawElementsIndirectCommand, 32 B stride (matches GPUFrustumCuller's IndirectCommandPOD).
struct DrawCommand {
    uint Count;
    uint InstanceCount;
    uint FirstIndex;
    uint BaseVertex;
    uint BaseInstance;
    uint _p0; uint _p1; uint _p2;
};

// Mirrors OloEngine::VirtualDrawArgs (16 B stride — the raster side binds this
// buffer as GL_PARAMETER_BUFFER with offset instanceIndex * 16).
struct DrawArgs {
    uint DrawCount;
    uint TestedCount;
    uint CutSelected;
    uint SwCount;
};

// Mirrors OloEngine::VirtualVisibleCluster (16 B std430).
struct VisibleCluster {
    uint InstanceIndex;
    uint ClusterIndex;
    uint _p0; uint _p1;
};

layout(std430, binding = 33) readonly buffer VirtualClusters { VirtualCluster clusters[]; };
layout(std430, binding = 34) readonly buffer VirtualGroups { VirtualGroup groups[]; };
layout(std430, binding = 35) readonly buffer VirtualInstances { VirtualInstance instances[]; };
layout(std430, binding = 36) writeonly buffer VirtualDrawCommands { DrawCommand commands[]; };
layout(std430, binding = 37) buffer VirtualDrawArgsBuf { DrawArgs args[]; };
layout(std430, binding = 38) writeonly buffer VirtualVisible { VisibleCluster visible[]; };

// Software-raster work list (slice 3): header count + records, appended for
// clusters whose projected coverage is under u_SwRasterThresholdPixels.
layout(std430, binding = 40) buffer VirtualSwList {
    uint Count;
    uint _h0; uint _h1; uint _h2;
    VisibleCluster Records[];
} swList;

// Streaming residency states (slice 5), one uint per group/page:
//   bit0 = page resident (CPU-written), bit1 = requested (GPU), bit2 = touched (GPU LRU).
layout(std430, binding = 43) buffer VirtualGroupStates { uint groupStates[]; };

// Two-phase occlusion reject list (issue #682), the cluster-level analogue of
// InstanceOcclusionCull.comp's InstanceCullRejected buffer. In PHASE 1 a
// cluster that survives the DAG cut + frustum + cone but is hidden by the
// PREVIOUS frame's depth pyramid is appended here instead of being dropped;
// PHASE 2 re-tests exactly these against a pyramid rebuilt from THIS frame's
// depth and emits the ones that turned out visible. Only touched when
// u_WriteRejected / u_Phase2 are set, so single-phase callers (the shadow
// cascades, the parity test) never bind it.
layout(std430, binding = 44) buffer VirtualRejectList {
    uint Count;
    uint _j0; uint _j1; uint _j2;
    VisibleCluster Records[];
} rejectList;

layout(std140, binding = 0) uniform CameraMatrices
{
    mat4 u_ViewProjection;
    mat4 u_View;
    mat4 u_Projection;
    vec3 u_CameraPosition;
    float _padding0;
    mat4 u_PrevViewProjection;
    vec3 u_RenderOrigin;
    float _padding1;
    // Reconstruction flavour of u_Projection (#691): GL-convention z
    // rows for NearPlane()'s extraction below — u_Projection's rasterizer
    // flavour has remapped z rows on Vulkan and breaks the formula. Identical
    // to u_Projection on GL.
    mat4 u_ProjectionForReconstruction;
};

// ---------------------------------------------------------------------------
// Cull parameters — ONE block for the whole shader.
// Former bare uniforms, migrated to a std140 block (issue #691):
// GLSL-for-Vulkan forbids a non-opaque uniform outside a block, and
// VulkanComputeShader::Set* is a deliberate no-op there — so these were both a
// hard SPIR-V compile error and a guaranteed zero-read on the Vulkan route.
// Legal on BOTH routes (GL compute at 460 core takes UBO blocks), so the
// declaration does not fork per backend.
// The three former runs of bare uniforms (view/LOD routing, the Hi-Z occlusion
// set, the two-phase + debug controls) are collapsed here; their original
// comment blocks stay at their old sites to explain the mechanisms. Refilled
// PER DISPATCH — the main view loops one dispatch per instance with
// u_InstanceIndex changing, and the shadow path re-fills the whole block in
// ortho mode. C++ twin: UBOStructures::VirtualClusterCullUBO
// (ShaderBindingLayout::UBO_VIRTUAL_CLUSTER_CULL).
// ---------------------------------------------------------------------------
layout(std140, binding = 69) uniform VirtualClusterCullParams
{
    mat4  u_OcclusionViewProjection; // 0   — the VP the bound pyramid was rendered with
    vec2  u_HZBSize;                 // 64  — HZB texture size in texels (power-of-2)
    vec2  u_HZBUVFactor;             // 72  — viewport / HZB size — screenUV -> HZB UV
    uint  u_InstanceIndex;           // 80
    float u_ViewportHeight;          // 84  — pixels
    float u_SwRasterThresholdPixels; // 88  — projected-radius routing threshold; 0 disables the SW path
    int   u_OrthoMode;               // 92  — 1 = orthographic view (shadow cascades): constant error
                                     //        scale, no cone/backface or SW routing (shadows need back faces)
    float u_OrthoErrorScale;         // 96  — ortho mode: pixels per world-space error unit
    int   u_OcclusionEnabled;        // 100 — 0 = skip the Hi-Z test entirely
    int   u_HZBMipCount;             // 104 — mip levels in the HZB pyramid
    float u_OcclusionDepthBias;      // 108 — device-Z slack before a reject fires
    int   u_WriteRejected;           // 112 — phase 1: defer an occluded cluster instead of dropping it
    int   u_Phase2;                  // 116 — 1 = re-test the reject list against the fresh pyramid
    uint  u_RejectCapacity;          // 120 — reject-list record capacity (this frame's cluster count)
    uint  u_CommandSlotBase;         // 124 — added to inst.CommandBase (0 / the frame's cluster count)
    uint  u_ArgsSlotBase;            // 128 — added to the instance index when indexing args[]
    int   u_DebugDrawClusters;       // 132 — cluster-bounds debug bit field, 0 = off (issue #725)
    uint  u_DebugDrawClusterStride;  // 136 — emit only every Nth cluster
    uint  u_SwCapacity;              // 140 — SW-raster work-list record capacity (this frame's cluster count)
    // ---- Culling-camera override (issue #726) ---------------------------
    // A FLAGGED override, not an unconditional replacement like the one in
    // InstanceCullParams: this program is bound by two different views, and the
    // ortho shadow cascades legitimately want the light matrices the camera UBO
    // already carries. They leave the value-initialised block alone, so
    // u_CullCameraPosition.w == 0 and every read below falls back to the camera
    // UBO exactly as before. The main perspective view always sets it, frozen or
    // not, so the override is exercised every frame.
    mat4  u_CullViewProjection;      // 144 - render-origin-relative culling VP
    vec4  u_CullCameraPosition;      // 208 - xyz relative pos, w = override enable
    vec4  u_CullProjParams;          // 224 - x = |proj[1][1]|, y = near plane
};

// The culling camera's view-projection, or the bound camera UBO's when no
// override was supplied (the shadow-cascade path).
mat4 CullViewProjection()
{
    return (u_CullCameraPosition.w != 0.0) ? u_CullViewProjection : u_ViewProjection;
}

// The culling camera's position. LOD screen error and the backface cone test
// both measure distance from it, and both must keep using the frozen camera or
// flying closer silently refines a cut the frozen camera never made.
vec3 CullCameraPosition()
{
    return (u_CullCameraPosition.w != 0.0) ? u_CullCameraPosition.xyz : u_CameraPosition;
}

// Hi-Z occlusion (issue #629, made two-phase by #682): reject clusters whose
// screen-space bounding rectangle is entirely behind a max-reduction scene-depth
// pyramid. Never in ortho/shadow mode: shadow maps must rasterize every caster.
// Conservative, exactly like InstanceOcclusionCull.comp — a false survivor only
// wastes a draw, a false cull would punch a visible hole.
//
// WHICH pyramid depends on the phase, and u_OcclusionViewProjection always names
// the VP that MATCHES the bound pyramid:
//   * phase 1 — the PREVIOUS frame's final-depth pyramid, which already contains
//     last frame's virtual geometry (that is what makes VG occlude VG), so the
//     bounds are reprojected with the previous frame's VP and the cluster's
//     PrevTransform;
//   * phase 2 — a pyramid rebuilt from THIS frame's depth (opaque scene + the
//     phase-1 virtual-geometry draws), so the current VP and current transform.
#include "../include/BindlessHeap.glsl"

// Heap-bindless conversion (issue #691, bucket 1). This shader was
// previously grouped with VirtualGeometryPass's 'deferrals'; it is not
// blocked. The G-Buffer restriction applies to VirtualMeshGBuffer.glsl, not
// to the cull compute, and the gl_BaseInstance this file mentions is in a
// COMMENT — a grep on raw text said otherwise.
#ifdef OLO_BINDLESS
#define u_HZB OLO_HEAP_TEX_2D(0)
#else
layout(binding = 0) uniform sampler2D u_HZB; // max-reduction depth pyramid (device-Z, smaller = nearer)
#endif
// (u_OcclusionEnabled / u_OcclusionViewProjection / u_HZBSize / u_HZBUVFactor /
//  u_HZBMipCount / u_OcclusionDepthBias now live in VirtualClusterCullParams
//  above — issue #691.)

// ── Two-phase controls (issue #682). All default to 0, so the shadow cascades
// and the GPU/CPU parity test — which set none of them — keep the exact
// single-phase behaviour and never touch the reject buffer. ──
// (u_WriteRejected / u_Phase2 / u_RejectCapacity / u_CommandSlotBase /
//  u_ArgsSlotBase now live in VirtualClusterCullParams above — #691.)

// ── Cluster-bounds debug visualization (issue #725) ──
// Bit field, 0 = off:
//   bit0 — clusters that survive every test and are drawn      (green)
//   bit1 — clusters the FRUSTUM rejected                       (red)
//   bit2 — clusters the normal CONE rejected as backfacing     (blue)
//   bit3 — clusters the phase-1 Hi-Z rejected as occluded      (yellow)
// Only ever set for the main perspective view (the shadow cascades bind the same
// program with u_OrthoMode = 1 and would otherwise emit a second, differently
// culled set on top of the first).
// (u_DebugDrawClusters lives in VirtualClusterCullParams above — #691.)
// Emit only every Nth cluster. A Nanite-class scene selects tens of thousands of
// clusters per frame and the channel holds a few thousand, so the useful setting
// is almost never 1 — and an overflow, while reported rather than silent, is
// still a picture of an arbitrary prefix rather than of the scene.
// (u_DebugDrawClusterStride lives in VirtualClusterCullParams above — #691.)

const uint kNoRefinedGroup = 0xFFFFFFFFu;

// Emit one cluster's world-space cull sphere if `modeBit` is enabled.
void DebugEmitCluster(uint clusterIndex, vec3 worldCenter, float worldRadius, int modeBit, vec3 color)
{
    if ((u_DebugDrawClusters & modeBit) == 0 || u_OrthoMode != 0)
        return;
    uint stride = max(u_DebugDrawClusterStride, 1u);
    if ((clusterIndex % stride) != 0u)
        return;
    OloDebugDrawSphere(worldCenter, worldRadius, color, OLO_DEBUG_SPACE_WORLD);
}

// Near-plane distance recovered from the standard GL perspective projection:
// n = P[3][2] / (P[2][2] - 1). Guarded so a degenerate projection cannot
// produce a zero/negative denominator in the error projection.
float NearPlane()
{
    // Culling-camera override (#726): the frozen projection is not on the GPU
    // anywhere else, so its near plane arrives pre-extracted rather than being
    // re-derived from a matrix that now describes the observer.
    if (u_CullCameraPosition.w != 0.0)
        return max(u_CullProjParams.y, 1e-4);
    // Reconstruction flavour (#691): the GL-form extraction needs
    // unremapped z rows.
    return max(u_ProjectionForReconstruction[3][2] / (u_ProjectionForReconstruction[2][2] - 1.0), 1e-4);
}

// Approximate perspective-projected screen-space error in PIXELS. Mirrors
// VirtualLODBounds::ProjectError (mesh space) after transforming the sphere and
// error to world space: u_Projection[1][1] == cot(fovY/2); * 0.5 maps the NDC
// height to [0,1]; * viewport height yields pixels.
float ProjectErrorPixels(vec3 worldCenter, float worldRadius, float worldError)
{
    float dist = length(worldCenter - CullCameraPosition());
    float denom = max(dist - worldRadius, NearPlane());
    // abs(): [1][1] is NEGATIVE on Vulkan (projection-seam y flip, #691
    // Phase 8) — unsigned, every projected error would be negative and no
    // cluster would ever refine. A magnitude is wanted; abs is a no-op on GL.
    float proj11 = (u_CullCameraPosition.w != 0.0) ? u_CullProjParams.x : abs(u_Projection[1][1]);
    return worldError / denom * (proj11 * 0.5) * u_ViewportHeight;
}

float ProjectGroupErrorPixels(VirtualGroup grp, VirtualInstance inst)
{
    vec3 worldCenter = (inst.Transform * vec4(grp.LODSphere.xyz, 1.0)).xyz;
    float worldRadius = grp.LODSphere.w * inst.MaxScale;
    // FLT_MAX * scale may overflow to +inf — both compare > threshold, which is
    // exactly the terminal-group semantic (never refined away).
    float worldError = grp.Error * inst.MaxScale;
    if (u_OrthoMode != 0)
    {
        // Orthographic projection: error size on screen is distance-independent
        return worldError * u_OrthoErrorScale;
    }
    return ProjectErrorPixels(worldCenter, worldRadius, worldError);
}

// Same row-of-VP plane extraction as InstanceFrustumCull.comp / Frustum::Update().
vec4 extractPlane(int col, float colSign)
{
    mat4 vp = CullViewProjection();
    vec4 p = vec4(
        vp[0][3] + colSign * vp[0][col],
        vp[1][3] + colSign * vp[1][col],
        vp[2][3] + colSign * vp[2][col],
        vp[3][3] + colSign * vp[3][col]
    );
    float len = length(p.xyz);
    return p / len;
}

// True when the world-space cull sphere is fully hidden by the bound HZB (safe
// to cull). Mirrors InstanceOcclusionCull.comp::isOccluded. Bounds project with
// u_OcclusionViewProjection — the VP that matches the bound pyramid, NOT
// necessarily this frame's camera (see the uniform block above). Conservative:
// returns false — keep the cluster — whenever the projection is unreliable.
bool IsOccluded(vec3 worldCenter, float worldRadius)
{
    // Screen-space rectangle + nearest device-Z of the sphere's world AABB.
    vec2 rectMin = vec2( 1e30);
    vec2 rectMax = vec2(-1e30);
    float nearestZ = 1e30;
    for (int i = 0; i < 8; ++i)
    {
        vec3 corner = worldCenter + worldRadius * vec3(
            (i & 1) != 0 ? 1.0 : -1.0,
            (i & 2) != 0 ? 1.0 : -1.0,
            (i & 4) != 0 ? 1.0 : -1.0);
        vec4 clip = u_OcclusionViewProjection * vec4(corner, 1.0);
        if (clip.w <= 0.0)
            return false; // straddles / behind camera — cannot project safely
        vec3 ndc = clip.xyz / clip.w;
        rectMin = min(rectMin, ndc.xy * 0.5 + 0.5);
        rectMax = max(rectMax, ndc.xy * 0.5 + 0.5);
        nearestZ = min(nearestZ, ndc.z * 0.5 + 0.5);
    }

    // Only reject when the whole rectangle was on-screen; a partially off-screen
    // box has no reliable HZB coverage, so keep it.
    if (rectMin.x < 0.0 || rectMin.y < 0.0 || rectMax.x > 1.0 || rectMax.y > 1.0)
        return false;
    if (rectMax.x <= rectMin.x || rectMax.y <= rectMin.y)
        return false;

    // Map the screen rect into the HZB's valid sub-rect, then to mip-0 texels.
    vec2 rectMinTexel = (rectMin * u_HZBUVFactor) * u_HZBSize;
    vec2 rectMaxTexel = (rectMax * u_HZBUVFactor) * u_HZBSize;

    // Smallest mip whose texels cover the footprint with at most a 2x2 fetch
    // (UE NaniteHZBCull MipLevelForRect).
    vec2 sizeTexels = rectMaxTexel - rectMinTexel;
    float maxSide = max(sizeTexels.x, sizeTexels.y);
    int mip = clamp(int(ceil(log2(max(maxSide, 1.0)))), 0, u_HZBMipCount - 1);

    int mipW = max(int(u_HZBSize.x) >> mip, 1);
    int mipH = max(int(u_HZBSize.y) >> mip, 1);
    ivec2 lo = ivec2(floor(rectMinTexel)) >> mip;
    ivec2 hi = ivec2(floor(rectMaxTexel)) >> mip;
    hi = min(hi, lo + ivec2(1));
    lo = clamp(lo, ivec2(0), ivec2(mipW - 1, mipH - 1));
    hi = clamp(hi, ivec2(0), ivec2(mipW - 1, mipH - 1));

    // Farthest occluder over the footprint = MAX of the covered texels. Point
    // sampling is required (bilinear would average a max-reduction pyramid and
    // under-estimate the occluder -> over-cull -> holes).
    float occluderZ = 0.0;
    for (int y = lo.y; y <= hi.y; ++y)
        for (int x = lo.x; x <= hi.x; ++x)
            occluderZ = max(occluderZ, texelFetch(u_HZB, ivec2(x, y), mip).r);

    // Occluded when the cluster's nearest point is still behind every occluder.
    return nearestZ > occluderZ + u_OcclusionDepthBias;
}

// ── Survivor emit, shared by both cull phases ──
// Routing: small-coverage clusters go to the compute software rasterizer;
// large or near-plane-crossing clusters take the hardware MDI path (the SW
// raster does no clipping).
//
// bit1 = alpha-masked/blended material. Those NEVER software-rasterize: the compute
// rasterizer resolves depth with an atomic min and has no texture access, so it cannot
// run the cutout test — a fully transparent texel would still win the depth race, and
// the resolve pass (which does run the cutout) would then discard it, leaving whatever
// was behind it unshaded. Sponza's potted plants rendered as white speckle exactly this
// way. The hardware path has a real fragment shader and discards before writing depth.
// Same restriction UE5's Nanite has: masked materials are excluded from the fast raster.
//
// bit2 (two-sided) does NOT exclude a cluster from the SW path: the rasterizer keeps
// negative-area triangles for those instances and the resolve flips the barycentric
// sign, so double-sided geometry keeps the fast path instead of being forced to HW.
//
// Phase 2 emits into a SEPARATE command/visible region and a separate args slot
// (u_CommandSlotBase / u_ArgsSlotBase), because the phase-1 MDI has already
// consumed its own segment by the time phase 2 runs — appending there would make
// the second replay re-issue every phase-1 draw.
void EmitSurvivor(uint instanceIndex, uint clusterIndex, VirtualInstance inst, VirtualCluster cluster,
                  vec3 worldCenter, float worldRadius, vec4 nearPlane)
{
    uint argsIndex = instanceIndex + u_ArgsSlotBase;

    // Survived every test — this is the cut the frame actually draws.
    DebugEmitCluster(clusterIndex, worldCenter, worldRadius, 1, vec3(0.2, 1.0, 0.3));

    bool alphaMasked = (inst.Flags & 2u) != 0u;
    if (u_SwRasterThresholdPixels > 0.0 && u_OrthoMode == 0 && !alphaMasked)
    {
        float dist = length(worldCenter - CullCameraPosition());
        float denom = max(dist - worldRadius, NearPlane());
        // abs(): see ProjectErrorPixels — [1][1] is negative on Vulkan.
        float swProj11 = (u_CullCameraPosition.w != 0.0) ? u_CullProjParams.x : abs(u_Projection[1][1]);
        float projRadiusPixels = worldRadius / denom * (swProj11 * 0.5) * u_ViewportHeight;
        // Sphere fully in front of the near plane <=> signed distance exceeds
        // the radius (with margin for w-precision).
        float nearDistance = dot(nearPlane.xyz, worldCenter) + nearPlane.w;
        bool nearSafe = nearDistance > worldRadius * 1.05;
        if (projRadiusPixels < u_SwRasterThresholdPixels && nearSafe)
        {
            // Bounds-checked exactly like the reject list below (u_RejectCapacity):
            // an unchecked atomicAdd here overruns swList.Records[] on GL only benignly
            // (driver-clamped/undefined, never fatal) but device-faults on Vulkan with a
            // READ of invalid address downstream in VirtualClusterRaster.comp, once the
            // corrupted InstanceIndex/ClusterIndex indexes far out of range (issue #862).
            uint swSlot = atomicAdd(swList.Count, 1);
            if (swSlot < u_SwCapacity)
            {
                VisibleCluster swRecord;
                swRecord.InstanceIndex = instanceIndex;
                swRecord.ClusterIndex = clusterIndex;
                swRecord._p0 = 0u;
                swRecord._p1 = 0u;
                swList.Records[swSlot] = swRecord;
                atomicAdd(args[argsIndex].SwCount, 1);
                return;
            }
            // Over capacity (should not happen — swListBytes is sized to
            // this frame's total cluster count): fall through to the
            // hardware compaction path below so the cluster still draws.
        }
    }

    // Compacted append into this instance's command segment
    uint localSlot = atomicAdd(args[argsIndex].DrawCount, 1);
    uint globalSlot = u_CommandSlotBase + inst.CommandBase + localSlot;

    DrawCommand command;
    command.Count = cluster.IndexCount;
    command.InstanceCount = 1u;
    command.FirstIndex = cluster.IndexBase;
    command.BaseVertex = cluster.VertexBase;
    command.BaseInstance = globalSlot; // gl_BaseInstance keys the VisibleCluster record
    command._p0 = 0u;
    command._p1 = 0u;
    command._p2 = 0u;
    commands[globalSlot] = command;

    VisibleCluster record;
    record.InstanceIndex = instanceIndex;
    record.ClusterIndex = clusterIndex;
    record._p0 = 0u;
    record._p1 = 0u;
    visible[globalSlot] = record;
}

// ── PHASE 2 (issue #682) ──
// One thread per phase-1 reject. The DAG cut, frustum and cone verdicts were
// already made in phase 1 and do not change within a frame — only the occlusion
// verdict is refreshed, against the pyramid rebuilt from this frame's depth
// (UE sets bSkipCullFrustum in CULLING_PASS_OCCLUSION_POST for the same reason).
// A reject that is still hidden stays culled; one that turned out visible is
// emitted here, which is what makes a phase-1 mis-reject impossible to see.
void Phase2()
{
    // 2D dispatch flattening keeps large reject lists under the 65535 per-axis
    // cap (same idiom as VirtualClusterRaster.comp's work list).
    uint groupIndex = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint idx = groupIndex * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    if (idx >= min(rejectList.Count, u_RejectCapacity))
        return; // dispatched at a conservative upper bound

    VisibleCluster rejected = rejectList.Records[idx];
    VirtualInstance inst = instances[rejected.InstanceIndex];
    VirtualCluster cluster = clusters[rejected.ClusterIndex];

    vec3 worldCenter = (inst.Transform * vec4(cluster.CullSphere.xyz, 1.0)).xyz;
    float worldRadius = cluster.CullSphere.w * inst.MaxScale;

    // u_OcclusionEnabled == 0 here means the current-frame pyramid could not be
    // built — then EVERY reject is emitted, because a phase-1 reject that is
    // never re-tested is exactly the hole this scheme must not have.
    if (u_OcclusionEnabled != 0 && u_HZBMipCount > 0 && IsOccluded(worldCenter, worldRadius))
        return; // still hidden by this frame's depth — correctly culled

    EmitSurvivor(rejected.InstanceIndex, rejected.ClusterIndex, inst, cluster,
                 worldCenter, worldRadius, extractPlane(2, 1.0)); // near plane, current VP
}

void main()
{
    if (u_Phase2 != 0)
    {
        Phase2();
        return;
    }

    uint localIndex = gl_GlobalInvocationID.x;
    VirtualInstance inst = instances[u_InstanceIndex];
    if (localIndex >= inst.ClusterCount)
        return;

    atomicAdd(args[u_InstanceIndex].TestedCount, 1);

    uint clusterIndex = inst.ClusterBase + localIndex;
    VirtualCluster cluster = clusters[clusterIndex];

    // ── Residency-clamped, view-dependent DAG cut ──
    // This cluster's own geometry lives in its member group's page; without it
    // the coarser ancestor draws instead (its refinement check below sees our
    // page missing), so request it and bail — never a hole, never a crack.
    if ((groupStates[cluster.GroupIndex] & 1u) == 0u)
    {
        atomicOr(groupStates[cluster.GroupIndex], 2u);
        return;
    }

    VirtualGroup memberGroup = groups[cluster.GroupIndex];
    if (!(ProjectGroupErrorPixels(memberGroup, inst) > inst.ErrorThresholdPixels))
        return; // the coarser replacement of this cluster is already accurate enough

    if (cluster.RefinedGroup != kNoRefinedGroup)
    {
        VirtualGroup refinedGroup = groups[cluster.RefinedGroup];
        if (!(ProjectGroupErrorPixels(refinedGroup, inst) <= inst.ErrorThresholdPixels))
        {
            // A finer level is wanted. Its clusters live in the refined
            // group's page: if that page is resident they draw instead of us;
            // if not, WE keep drawing (no hole) and request the finer page.
            // All members of that page share the same resident bit, so the
            // finer set appears atomically — the cut stays watertight.
            if ((groupStates[cluster.RefinedGroup] & 1u) != 0u)
                return;
            atomicOr(groupStates[cluster.RefinedGroup], 2u);
        }
    }

    // LRU touch: this page's geometry is in the drawn cut this frame
    atomicOr(groupStates[cluster.GroupIndex], 4u);

    atomicAdd(args[u_InstanceIndex].CutSelected, 1);

    // ── Frustum cull (world-space cull sphere vs. the 6 VP planes) ──
    vec3 worldCenter = (inst.Transform * vec4(cluster.CullSphere.xyz, 1.0)).xyz;
    float worldRadius = cluster.CullSphere.w * inst.MaxScale;

    vec4 planes[6];
    planes[0] = extractPlane(0,  1.0); // Left
    planes[1] = extractPlane(0, -1.0); // Right
    planes[2] = extractPlane(1,  1.0); // Bottom
    planes[3] = extractPlane(1, -1.0); // Top
    planes[4] = extractPlane(2,  1.0); // Near
    planes[5] = extractPlane(2, -1.0); // Far

    for (int i = 0; i < 6; ++i)
    {
        if (dot(planes[i].xyz, worldCenter) + planes[i].w < -worldRadius)
        {
            DebugEmitCluster(clusterIndex, worldCenter, worldRadius, 2, vec3(1.0, 0.15, 0.15));
            return; // outside this plane
        }
    }

    // ── Normal-cone backface rejection (uniform-scale instances only; never
    // in ortho/shadow mode — shadow maps rasterize back faces; never for a
    // TWO-SIDED material — bit2 — whose back faces are visible, so "every
    // triangle in this cluster faces away" is not a reason to drop it. The
    // classic path has no cone cull at all, so this test was the one place the
    // virtual path could lose whole clusters of a double-sided sheet seen from
    // behind) ──
    // meshoptimizer sphere-based form: reject when
    //   dot(center - camera, axis) >= cutoff * |center - camera| + radius.
    bool twoSided = (inst.Flags & 4u) != 0u;
    if (u_OrthoMode == 0 && (inst.Flags & 1u) != 0u && !twoSided && cluster.Cone.w < 1.0)
    {
        vec3 worldAxis = normalize(mat3(inst.Transform) * cluster.Cone.xyz);
        vec3 toCluster = worldCenter - CullCameraPosition();
        if (dot(toCluster, worldAxis) >= cluster.Cone.w * length(toCluster) + worldRadius)
        {
            DebugEmitCluster(clusterIndex, worldCenter, worldRadius, 4, vec3(0.2, 0.4, 1.0));
            return; // entire cluster faces away
        }
    }

    // ── Hi-Z occlusion cull, PHASE 1 (main/perspective view only — shadow
    // cascades must rasterize every caster). The bound pyramid is the PREVIOUS
    // frame's final depth, which already contains last frame's virtual geometry
    // — that is what lets a VG occluder cull the VG behind it (issue #682); a
    // same-frame pyramid can only ever hold the classic-path occluders drawn
    // before this pass. Because it is last frame's screen space, the bounds are
    // reprojected: where the cluster WAS (PrevTransform, identical to Transform
    // for a static instance) through the VP that matches the pyramid — the same
    // reprojection InstanceOcclusionCull.comp does.
    //
    // A hit is DEFERRED, not dropped: the cluster goes on the reject list and
    // phase 2 re-tests it against this frame's depth. So phase 1 is allowed to
    // be wrong in the reject direction (reprojection error, a camera cut, a
    // disocclusion) — phase 2 always recovers it, which is the property that
    // keeps the two-phase scheme hole-free. ──
    if (u_OcclusionEnabled != 0 && u_OrthoMode == 0 && u_HZBMipCount > 0)
    {
        mat4 prev = inst.PrevTransform;
        vec3 occCenter = (prev * vec4(cluster.CullSphere.xyz, 1.0)).xyz;
        float occScale = max(max(length(prev[0].xyz), length(prev[1].xyz)), length(prev[2].xyz));
        float occRadius = cluster.CullSphere.w * occScale;
        if (IsOccluded(occCenter, occRadius))
        {
            DebugEmitCluster(clusterIndex, worldCenter, worldRadius, 8, vec3(1.0, 0.9, 0.15));
            if (u_WriteRejected == 0)
                return; // single-phase caller: simply cull

            uint slot = atomicAdd(rejectList.Count, 1u);
            if (slot < u_RejectCapacity)
            {
                VisibleCluster rejected;
                rejected.InstanceIndex = u_InstanceIndex;
                rejected.ClusterIndex = clusterIndex;
                rejected._p0 = 0u;
                rejected._p1 = 0u;
                rejectList.Records[slot] = rejected;
                return; // handed to phase 2
            }
            // List full. Unreachable while the capacity is this frame's cluster
            // count (each cluster gets exactly one phase-1 thread), but a silent
            // overrun would corrupt memory and a silent drop would punch a hole,
            // so fall through and draw the cluster now instead.
        }
    }

    EmitSurvivor(u_InstanceIndex, clusterIndex, inst, cluster, worldCenter, worldRadius, planes[4]);
}
