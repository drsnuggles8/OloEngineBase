#version 460 core

// =============================================================================
// CloudNoise_Generate.comp — Bakes the tiling 3D cloud-noise volumes.
//
// One invocation per texel of an RGBA8 3D texture. Two modes (u_Mode):
//   0 = base shape (128³):  R = Perlin-Worley at freq 4 (billowy base),
//                           G/B/A = Worley FBM at freq 8/16/32 — the
//                           erosion-remap octaves (Nubis-style).
//   1 = detail     (32³):   R/G/B = Worley FBM at freq 8/16/32 for
//                           cloud-edge erosion, A = 1.
//
// Every channel tiles with period 1 (see NoiseCommon.glsl), so the cloud
// raymarch can repeat-sample the volumes at any world scale without seams.
// Dispatched once by CloudNoise::EnsureGenerated() — not per frame.
// =============================================================================

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

#include "../include/NoiseCommon.glsl"

#include "../include/BindlessHeap.glsl"

// Heap-bindless conversion (issue #691 Phase 3). Under OLO_BINDLESS the
// declaration moves into main() as a local built from the heap descriptor at
// this image unit; the body below is unchanged either way.
#ifndef OLO_BINDLESS
layout(rgba8, binding = 0) uniform writeonly image3D u_Output;
#endif

// ---- Parameters set by CloudNoise::EnsureGenerated() ----
// Former bare uniforms, migrated to a std140 block (issue #691 Phase 8):
// GLSL-for-Vulkan forbids a non-opaque uniform outside a block, and
// VulkanComputeShader::Set* is a deliberate no-op there — so these were both a
// hard SPIR-V compile error and a guaranteed zero-read on the Vulkan route.
// Refilled per dispatch (base then detail bake). C++ twin:
// UBOStructures::CloudNoiseGenUBO (ShaderBindingLayout::UBO_CLOUD_NOISE_GEN).
layout(std140, binding = 74) uniform CloudNoiseGenParams
{
    int   u_Mode;             // 0  — 0 = base, 1 = detail
    int   u_Size;             // 4  — texels per axis (128 base, 32 detail)
    float u_InvSize;          // 8  — 1.0 / u_Size (computed on the CPU)
    float _cloudNoiseGenPad0; // 12
};

void main()
{
#ifdef OLO_BINDLESS
    OLO_HEAP_IMAGE(rgba8, writeonly, image3D, u_Output, 0);
#endif
    ivec3 gid = ivec3(gl_GlobalInvocationID);

    // Early-out for invocations beyond the volume
    if (any(greaterThanEqual(gid, ivec3(u_Size))))
        return;

    // Texel centre in [0, 1)³ — the tiling domain of NoiseCommon.glsl
    vec3 p = (vec3(gid) + 0.5) * u_InvSize;

    vec4 result;
    if (u_Mode == 0)
    {
        result = vec4(perlinWorley(p, 4.0),
                      worleyFbm3(p, 8.0),
                      worleyFbm3(p, 16.0),
                      worleyFbm3(p, 32.0));
    }
    else
    {
        result = vec4(worleyFbm3(p, 8.0),
                      worleyFbm3(p, 16.0),
                      worleyFbm3(p, 32.0),
                      1.0);
    }

    imageStore(u_Output, gid, result);
}
