<Project Sdk="Microsoft.NET.Sdk">
  <!-- The engine's C# API, loaded by ScriptEngine from Resources/Scripts/. Every .cs under
       src/ is compiled, including the two OloHeaderTool writes (Components.Generated.cs,
       InternalCalls.Generated.cs). Built by the OloEngine-ScriptCore CMake target, whose
       SOURCES glob is the same src/ tree. -->
  <Import Project="OloEngine.CSharp.props" />

  <PropertyGroup>
    <AssemblyName>OloEngine-ScriptCore</AssemblyName>
    <RootNamespace>OloEngine</RootNamespace>
    <OutDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'OloEditor', 'Resources', 'Scripts'))</OutDir>
    <!-- Not the SDK's whole-directory default: the CMake build moves obj/ into the build tree,
         so an obj/ an IDE build left here would be globbed in (duplicate assembly attributes). -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>
</Project>
