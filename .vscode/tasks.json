{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-oloeditor-debug",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/scripts/BuildCleanEnv.ps1",
				"-BuildDir",
				"${workspaceFolder}/build",
				"-Target",
				"OloEditor",
				"-Config",
				"Debug"
			],
			// NOT the default build task any more — build-cached-oloeditor-debug is. This
			// tree cannot use the compiler cache (the VS generator ignores the launcher) and
			// can never build concurrently. Both trees emit to the same source-relative
			// bin/Debug/OloEditor, so run-oloeditor-debug works either way.
			"group": "build",
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"label": "build-oloeditor-release",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/scripts/BuildCleanEnv.ps1",
				"-BuildDir",
				"${workspaceFolder}/build",
				"-Target",
				"OloEditor",
				"-Config",
				"Release"
			],
			"group": "build",
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"label": "build-oloeditor-dist",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/scripts/BuildCleanEnv.ps1",
				"-BuildDir",
				"${workspaceFolder}/build",
				"-Target",
				"OloEditor",
				"-Config",
				"Dist"
			],
			"group": "build",
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"label": "run-oloeditor-debug",
			"type": "shell",
			"command": "${workspaceFolder}/bin/Debug/OloEditor/OloEditor.exe",
			"options": {
				"cwd": "${workspaceFolder}/OloEditor"
			},
			"group": "test",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "run-oloeditor-release",
			"type": "shell",
			"command": "${workspaceFolder}/bin/Release/OloEditor/OloEditor.exe",
			"options": {
				"cwd": "${workspaceFolder}/OloEditor"
			},
			"group": "test",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "run-oloeditor-dist",
			"type": "shell",
			"command": "${workspaceFolder}/bin/Dist/OloEditor/OloEditor.exe",
			"options": {
				"cwd": "${workspaceFolder}/OloEditor"
			},
			"group": "test",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "build-tests-debug",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/scripts/BuildCleanEnv.ps1",
				"-BuildDir",
				"${workspaceFolder}/build",
				"-Target",
				"OloEngine-Tests",
				"-Config",
				"Debug"
			],
			"group": "build",
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"label": "run-tests-debug",
			"type": "shell",
			"command": "${workspaceFolder}/build/OloEngine/tests/Debug/OloEngine-Tests.exe",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "test",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": [],
			"dependsOn": [
				"build-tests-debug"
			]
		},
		{
			"label": "run-fast-tests-debug",
			"detail": "Build + run the suite MINUS perf/golden/visual (L6/L7/L8) for a fast inner loop. The exclude filter is derived from the test catalogue, so it stays in sync as tests are added.",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-Command",
				"$f = (python OloEngine/tests/scripts/generate_test_catalogue.py --gtest-filter --exclude L6,L7,L8); & build/OloEngine/tests/Debug/OloEngine-Tests.exe \"--gtest_filter=$f\""
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "test",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": [],
			"dependsOn": [
				"build-tests-debug"
			]
		},
		{
			"label": "build-oloruntime-debug",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/scripts/BuildCleanEnv.ps1",
				"-BuildDir",
				"${workspaceFolder}/build",
				"-Target",
				"OloRuntime",
				"-Config",
				"Debug"
			],
			"group": "build",
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"label": "build-oloruntime-release",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/scripts/BuildCleanEnv.ps1",
				"-BuildDir",
				"${workspaceFolder}/build",
				"-Target",
				"OloRuntime",
				"-Config",
				"Release"
			],
			"group": "build",
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"label": "build-oloruntime-dist",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/scripts/BuildCleanEnv.ps1",
				"-BuildDir",
				"${workspaceFolder}/build",
				"-Target",
				"OloRuntime",
				"-Config",
				"Dist"
			],
			"group": "build",
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			// The FAST path, and the only kind of tree eligible for a concurrent build slot.
			// Configure once; `build-cached/` is separate from `build/` because enabling the
			// compiler cache force-disables PCH and unity builds.
			"label": "configure-dev-cached",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--preset",
				"dev-cached"
			],
			"problemMatcher": []
		},
		{
			// Goes through the cross-worktree mutex, unlike the `build/` tasks above: the lock
			// sizes parallelism from measured free memory and may admit this alongside another
			// cached build. Measured 12m04s cold vs 3m23s warm in a second worktree.
			"label": "build-cached-tests-debug",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/.claude/skills/run-oloengine/build-lock.ps1",
				"-Command",
				"cmake --build build-cached --target OloEngine-Tests --config Debug --parallel 6"
			],
			"group": "build",
			// Same contract as the clangcl tasks: configure first, so a fresh worktree does
			// not fail with "no build-cached tree" the first time someone runs this.
			"dependsOn": [
				"configure-dev-cached"
			],
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"label": "build-cached-oloeditor-debug",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/.claude/skills/run-oloengine/build-lock.ps1",
				"-Command",
				"cmake --build build-cached --target OloEditor --config Debug --parallel 6"
			],
			// THE default build task (Ctrl+Shift+B). The cached tree is ~3.5x faster warm and
			// is the only kind eligible for a concurrent slot; it writes OloEditor.exe to the
			// same source-relative bin/Debug/OloEditor as the msvc tree, so the existing
			// run-oloeditor-debug task picks it up unchanged.
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"dependsOn": [
				"configure-dev-cached"
			],
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"label": "run-cached-tests-debug",
			"type": "shell",
			"command": "${workspaceFolder}/build-cached/OloEngine/tests/Debug/OloEngine-Tests.exe",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "test",
			// Mirrors run-tests-debug -> build-tests-debug: running a stale binary because the
			// build step was forgotten is the failure this prevents.
			"dependsOn": [
				"build-cached-tests-debug"
			],
			"problemMatcher": []
		},
		{
			"label": "configure-clangcl",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--preset",
				"clangcl"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "build-clangcl-tests-debug",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"${workspaceFolder}/build-clang",
				"--target",
				"OloEngine-Tests",
				"--config",
				"Debug",
				"--parallel"
			],
			"group": "build",
			"dependsOn": [
				"configure-clangcl"
			],
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"label": "run-clangcl-tests-debug",
			"type": "shell",
			"command": "${workspaceFolder}/build-clang/OloEngine/tests/Debug/OloEngine-Tests.exe",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "test",
			"dependsOn": [
				"build-clangcl-tests-debug"
			],
			"problemMatcher": []
		},
		{
			"label": "build-clangcl-oloeditor-debug",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"${workspaceFolder}/build-clang",
				"--target",
				"OloEditor",
				"--config",
				"Debug",
				"--parallel"
			],
			"group": "build",
			"dependsOn": [
				"configure-clangcl"
			],
			"problemMatcher": [
				"$msCompile"
			]
		}
	]
}